<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Contraseña del administrador | <%= company %></title>
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    body{background:radial-gradient(circle at top right,#1e1b4b,#0d1117);display:flex;align-items:center;justify-content:center;min-height:100vh;padding:20px}
    .box{width:100%;max-width:440px}
    .card{padding:22px}
  </style>
</head>
<body>
<div class="box">
  <div class="card">
    <h5 style="margin:0 0 6px"><i class="bi bi-shield-lock"></i> Usuario y contraseña del administrador</h5>
    <% if (forced) { %>
      <div class="alert alert-d" style="margin:10px 0">Estás usando la contraseña de fábrica. Creá una contraseña propia para continuar.</div>
    <% } %>
    <% if (error) { %><div class="alert alert-d" style="margin:10px 0"><%= error %></div><% } %>
    <% if (ok) { %><div class="alert alert-s" style="margin:10px 0"><%= ok %> <a href="/admin">Ir al panel</a></div><% } %>
    <form method="POST" action="/admin/account/password" autocomplete="off">
      <div class="fg"><label class="fl">Usuario</label><input class="fc" name="username" value="<%= username %>" required pattern="[A-Za-z0-9._-]{3,32}"></div>
      <% if (needCurrent) { %>
        <div class="fg"><label class="fl">Contraseña actual</label><input class="fc" type="password" name="current" required autocomplete="current-password"></div>
      <% } %>
      <div class="fg"><label class="fl">Nueva contraseña (mínimo <%= minLength %> caracteres)</label><input class="fc" type="password" name="next" required minlength="<%= minLength %>" autocomplete="new-password"></div>
      <div class="fg"><label class="fl">Repetir nueva contraseña</label><input class="fc" type="password" name="confirm" required minlength="<%= minLength %>" autocomplete="new-password"></div>
      <div class="hint" style="margin:6px 0 12px">Se guarda cifrada. Si la olvidás, solo se puede restablecer con acceso al servidor.</div>
      <div style="display:flex;gap:8px;justify-content:flex-end">
        <% if (!forced) { %><a class="btn btn-g" href="/admin">Volver</a><% } else { %><a class="btn btn-g" href="/admin/logout">Salir</a><% } %>
        <button class="btn btn-p" type="submit"><i class="bi bi-check2"></i> Guardar</button>
      </div>
    </form>
  </div>
</div>
</body>
</html>
