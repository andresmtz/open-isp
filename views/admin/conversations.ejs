<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' && lang ? lang : 'es' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Conversaciones | <%= company %></title>
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .cv-wrap{display:grid;grid-template-columns:340px 1fr 300px;gap:12px;height:calc(100vh - 150px);min-height:480px}
    .cv-pane{display:flex;flex-direction:column;min-height:0;margin:0;padding:0;overflow:hidden}
    .cv-tools{padding:10px;border-bottom:1px solid var(--border);display:flex;flex-direction:column;gap:8px}
    .cv-tabs{display:flex;gap:5px;flex-wrap:wrap}
    .cv-tab{font-size:12px;padding:4px 9px;border-radius:999px;border:1px solid var(--border);background:transparent;color:var(--muted);cursor:pointer}
    .cv-tab.on{background:var(--primary);color:#0b0f14;border-color:var(--primary);font-weight:700}
    .cv-tab .n{font-weight:800;margin-left:3px}
    .cv-tab.hot .n{color:#f59e0b}
    .cv-tab.on.hot .n{color:#0b0f14}
    .cv-list{overflow-y:auto;flex:1}
    .cv-item{padding:10px 12px;border-bottom:1px solid var(--border);cursor:pointer;display:flex;flex-direction:column;gap:3px}
    .cv-item:hover{background:rgba(255,255,255,.03)}
    .cv-item.on{background:rgba(173,255,47,.08);border-left:3px solid var(--primary)}
    .cv-item .t{display:flex;justify-content:space-between;gap:6px;font-weight:700;font-size:13.5px}
    .cv-item .t span:last-child{font-weight:400;font-size:11px;color:var(--muted);white-space:nowrap}
    .cv-item .p{font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .cv-item .b{display:flex;gap:4px;flex-wrap:wrap}
    .cv-chip{font-size:10.5px;padding:1px 7px;border-radius:999px;border:1px solid var(--border);color:var(--muted);white-space:nowrap}
    .cv-chip.wait{border-color:#f59e0b;color:#f59e0b;font-weight:700}
    .cv-chip.cust{border-color:#22c55e;color:#22c55e}
    .cv-chip.lead{border-color:#38bdf8;color:#38bdf8}
    .cv-chip.hot{border-color:#f59e0b;background:rgba(245,158,11,.14);color:#fbbf24;font-weight:800}
    .cv-chip.unread{background:#22c55e;color:#04110a;border-color:#22c55e;font-weight:800}
    .cv-chip.mot{border-color:rgba(167,139,250,.6);color:#c4b5fd}
    .cv-chk{font-size:11px;color:var(--muted)}
    .cv-chk .ok{color:#4ade80}.cv-chk .no{color:#f87171}.cv-chk .pr{color:#fbbf24}
    .cv-head{padding:10px 14px;border-bottom:1px solid var(--border);display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .cv-head .who{flex:1;min-width:160px}
    .cv-head .who b{font-size:15px}
    .cv-head .who div{font-size:12px;color:var(--muted)}
    .cv-acts{display:flex;gap:6px;flex-wrap:wrap}
    .cv-msgs{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:8px;background:rgba(0,0,0,.12)}
    .cv-day{align-self:center;font-size:11px;color:var(--muted);padding:2px 10px;border:1px solid var(--border);border-radius:999px;margin:6px 0}
    .cv-m{max-width:78%;padding:7px 10px 5px;border-radius:10px;font-size:13.5px;line-height:1.4;white-space:pre-wrap;word-wrap:break-word;border:1px solid transparent}
    .cv-m .who{font-size:10.5px;font-weight:800;margin-bottom:2px;letter-spacing:.2px}
    .cv-m .tm{font-size:10px;color:var(--muted);text-align:right;margin-top:3px}
    .cv-m.cliente{align-self:flex-start;background:var(--bg2,#1b2230);border-color:var(--border)}
    .cv-m.meta_ai{align-self:flex-end;background:rgba(124,58,237,.16);border-color:rgba(124,58,237,.45)}
    .cv-m.meta_ai .who{color:#a78bfa}
    .cv-m.persona{align-self:flex-end;background:rgba(34,197,94,.14);border-color:rgba(34,197,94,.45)}
    .cv-m.persona .who{color:#4ade80}
    .cv-m.sistema,.cv-m.auto{align-self:flex-end;background:rgba(56,189,248,.10);border-color:rgba(56,189,248,.35)}
    .cv-m.sistema .who,.cv-m.auto .who{color:#38bdf8}
    .cv-m.handoff{border-color:#f59e0b;box-shadow:0 0 0 1px rgba(245,158,11,.4)}
    .cv-m img.media{max-width:260px;max-height:260px;border-radius:8px;display:block;margin:4px 0;cursor:zoom-in}
    .cv-m img.sticker{max-width:110px}
    .cv-m audio,.cv-m video{max-width:260px;display:block;margin:4px 0}
    .cv-mark{display:flex;gap:5px;margin-top:4px;white-space:normal}
    .cv-mark button{font-size:11px;padding:2px 8px;border-radius:6px;border:1px solid var(--border);background:transparent;color:var(--muted);cursor:pointer}
    .cv-mark button.on{border-color:#4ade80;color:#4ade80;font-weight:700}
    .cv-box{border-top:1px solid var(--border);padding:10px;display:flex;gap:8px;align-items:flex-end;position:relative}
    .cv-box textarea{flex:1;resize:none;min-height:42px;max-height:160px}
    .cv-qr{position:absolute;bottom:58px;left:10px;width:300px;max-height:320px;overflow:auto;background:var(--bg2,#151b26);border:1px solid var(--border);border-radius:10px;box-shadow:0 10px 30px rgba(0,0,0,.4);display:none;z-index:20}
    .cv-qr.open{display:block}
    .cv-qr div{padding:9px 12px;border-bottom:1px solid var(--border);cursor:pointer;font-size:13px}
    .cv-qr div:hover{background:rgba(255,255,255,.05)}
    .cv-qr div small{display:block;color:var(--muted);font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .cv-empty{flex:1;display:flex;align-items:center;justify-content:center;color:var(--muted);text-align:center;padding:30px;font-size:14px}
    .cv-info{overflow-y:auto;padding:12px 14px;display:flex;flex-direction:column;gap:12px;font-size:13px}
    .cv-info h6{margin:0 0 6px;font-size:11px;text-transform:uppercase;letter-spacing:.8px;color:var(--muted)}
    .cv-info .row1{display:flex;justify-content:space-between;gap:8px;padding:3px 0}
    .cv-info .row1 span:first-child{color:var(--muted)}
    .cv-info .fg{margin:0 0 6px}
    .cv-info .btn{width:100%;justify-content:center;margin-top:4px}
    .cv-steps{display:flex;flex-direction:column;gap:4px}
    .cv-steps div{display:flex;gap:6px;align-items:center}
    .cv-legend{display:flex;gap:10px;flex-wrap:wrap;font-size:11.5px;color:var(--muted)}
    .cv-legend i.sq{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:4px;vertical-align:-1px}
    .cv-back,.cv-infobtn{display:none}
    .cv-res{max-height:220px;overflow:auto;border:1px solid var(--border);border-radius:8px;margin-top:6px}
    .cv-res div{padding:7px 10px;border-bottom:1px solid var(--border);cursor:pointer;font-size:13px}
    .cv-res div:hover{background:rgba(255,255,255,.05)}
    .cv-res div.on{background:rgba(173,255,47,.12)}
    .cv-qe{border:1px solid var(--border);border-radius:8px;padding:8px;margin-bottom:8px}
    @media (max-width: 1300px){
      .cv-wrap{grid-template-columns:320px 1fr}
      .cv-info-pane{display:none}
      .cv-wrap.info .cv-info-pane{display:flex;position:fixed;right:12px;top:70px;bottom:12px;width:min(340px,92vw);z-index:50;box-shadow:0 10px 40px rgba(0,0,0,.5)}
      .cv-infobtn{display:inline-flex}
    }
    @media (max-width: 900px){
      .cv-wrap{grid-template-columns:1fr;height:calc(100vh - 130px)}
      .cv-wrap.chat .cv-left{display:none}
      .cv-wrap:not(.chat) .cv-right{display:none}
      .cv-back{display:inline-flex}
      .cv-m{max-width:90%}
    }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'conversations', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-chat-dots"></i><span>Conversaciones</span>
    </div>
  </div>
  <div class="page">
    <% if (msg) { %><div class="alert alert-<%= msg.type==='error'?'d':'s' %>" data-flash="1"><%= msg.text %></div><% } %>
    <div class="cv-legend" style="margin-bottom:8px">
      <span><i class="sq" style="background:#334155"></i>Cliente</span>
      <span><i class="sq" style="background:#7c3aed"></i>Meta AI</span>
      <span><i class="sq" style="background:#22c55e"></i>Persona (oficina)</span>
      <span><i class="sq" style="background:#38bdf8"></i>Sistema / automático</span>
      <span style="margin-left:auto"><i class="bi bi-clock"></i> Atención humana: <b><%= hours %></b> · aviso a la oficina a los <b><%= alertMinutes %> min</b> de una derivación<%= inHours ? '' : ' · ahora fuera de horario' %></span>
    </div>
    <div class="cv-wrap" id="cvWrap">
      <div class="card cv-pane cv-left">
        <div class="cv-tools">
          <input class="fc" id="cvQ" placeholder="Buscar nombre, teléfono, etiqueta o texto…" autocomplete="off">
          <div class="cv-tabs" id="cvTabs">
            <% Object.keys(inboxes).forEach(function(k, i){ %>
              <button class="cv-tab<%= i === 0 ? ' on' : '' %>" data-f="<%= k %>"><%= inboxes[k] %> <span class="n" data-n="<%= k %>"></span></button>
            <% }) %>
          </div>
          <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
            <select class="fs" id="cvMot" style="max-width:190px;padding:4px 8px;font-size:12px">
              <option value="">Todos los motivos</option>
              <% Object.keys(motives).forEach(function(k){ %><option value="<%= k %>"><%= motives[k] %></option><% }) %>
            </select>
            <button class="btn btn-g btn-sm" onclick="cvSync(false, this)" title="Buscar mensajes nuevos en GoWA"><i class="bi bi-arrow-repeat"></i></button>
            <% if (isAdmin) { %>
              <button class="btn btn-g btn-sm" onclick="cvSync(true, this)" title="Traer todo el historial guardado en GoWA (no duplica)"><i class="bi bi-cloud-download"></i></button>
              <button class="btn btn-g btn-sm" onclick="qeOpen()" title="Editar respuestas rápidas"><i class="bi bi-lightning-charge"></i></button>
            <% } %>
          </div>
        </div>
        <div class="cv-list" id="cvList"><div class="cv-empty">Cargando…</div></div>
      </div>

      <div class="card cv-pane cv-right" id="cvRight">
        <div class="cv-empty" id="cvNone">Elegí una conversación de la lista.</div>
        <div id="cvChat" style="display:none;flex-direction:column;flex:1;min-height:0">
          <div class="cv-head">
            <button class="btn btn-g btn-sm cv-back" onclick="cvBack()"><i class="bi bi-arrow-left"></i></button>
            <div class="who"><b id="cvName"></b><div id="cvSub"></div></div>
            <div class="cv-acts" id="cvActs"></div>
          </div>
          <div class="cv-msgs" id="cvMsgs"></div>
          <div class="cv-box">
            <div class="cv-qr" id="cvQr"></div>
            <button class="btn btn-g" onclick="qrToggle()" title="Respuestas rápidas"><i class="bi bi-lightning-charge"></i></button>
            <textarea class="fc" id="cvText" rows="1" placeholder="Escribí una respuesta… (Ctrl+Enter para enviar)"></textarea>
            <button class="btn btn-p" id="cvSend" onclick="cvSend()"><i class="bi bi-send"></i></button>
          </div>
        </div>
      </div>

      <div class="card cv-pane cv-info-pane">
        <div class="cv-info" id="cvInfo"><div class="text-muted">Elegí una conversación para ver sus datos.</div></div>
      </div>
    </div>
  </div>
</div>

<!-- Crear solicitud de instalación -->
<div class="mo" id="reqModal">
  <div class="mb" style="max-width:520px">
    <div class="mh"><span class="mt"><i class="bi bi-house-add"></i> Crear solicitud de instalación</span><button class="mc" onclick="closeMo('reqModal')">×</button></div>
    <div class="mbody">
      <div class="pp-sub" style="font-size:12.5px;margin-bottom:8px">Se carga como <b>Inscripto</b> con el WhatsApp de este chat. Si la persona ya está registrada, el sistema avisa. Las fotos marcadas como cédula y fachada se adjuntan a su ficha.</div>
      <div class="fg"><label class="fl">Nombre y apellido *</label><input class="fc" id="rqName" maxlength="120"></div>
      <div class="fg"><label class="fl">Cédula</label><input class="fc" id="rqNik" maxlength="30"></div>
      <div class="fg"><label class="fl">Dirección / referencia *</label><input class="fc" id="rqAddr" maxlength="250"></div>
      <div class="fg"><label class="fl">Plan *</label><select class="fs" id="rqPkg"><% packages.forEach(function(p){ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></div>
      <div class="fg"><label class="fl">Ubicación</label><div id="rqLoc" class="text-muted" style="font-size:12.5px"></div></div>
      <div class="fg"><label class="fl">Notas</label><textarea class="fc" id="rqNotes" rows="2" maxlength="500"></textarea></div>
    </div>
    <div class="mf"><button class="btn btn-g" onclick="closeMo('reqModal')">Cancelar</button><button class="btn btn-p" id="rqBtn" onclick="rqSave()"><i class="bi bi-check2"></i> Crear solicitud</button></div>
  </div>
</div>

<!-- Vincular a cliente -->
<div class="mo" id="linkModal">
  <div class="mb" style="max-width:480px">
    <div class="mh"><span class="mt"><i class="bi bi-link-45deg"></i> Es cliente: vincular</span><button class="mc" onclick="closeMo('linkModal')">×</button></div>
    <div class="mbody">
      <div class="pp-sub" style="font-size:12.5px;margin-bottom:8px">Para cuando un cliente escribe desde otro número (por ejemplo, de un familiar). Este número queda como <b>teléfono adicional</b> del cliente elegido.</div>
      <input class="fc" id="lkQ" placeholder="Buscar por nombre, código o teléfono…" autocomplete="off">
      <div class="cv-res" id="lkRes"></div>
    </div>
    <div class="mf"><button class="btn btn-g" onclick="closeMo('linkModal')">Cancelar</button><button class="btn btn-p" id="lkBtn" onclick="lkSave()" disabled><i class="bi bi-link"></i> Vincular</button></div>
  </div>
</div>

<% if (isAdmin) { %>
<!-- Editor de respuestas rápidas -->
<div class="mo" id="qeModal">
  <div class="mb" style="max-width:640px">
    <div class="mh"><span class="mt"><i class="bi bi-lightning-charge"></i> Respuestas rápidas</span><button class="mc" onclick="closeMo('qeModal')">×</button></div>
    <div class="mbody">
      <div class="pp-sub" style="font-size:12.5px;margin-bottom:8px">Textos listos para insertar en el chat (se revisan antes de enviar). Variables: <code>{{planes}}</code> lista de planes con precio · <code>{{formas_pago}}</code> formas de pago de Configuración.</div>
      <div id="qeList"></div>
      <button class="btn btn-g btn-sm" onclick="qeAdd()"><i class="bi bi-plus"></i> Agregar</button>
    </div>
    <div class="mf"><button class="btn btn-g" onclick="closeMo('qeModal')">Cancelar</button><button class="btn btn-p" onclick="qeSave(this)"><i class="bi bi-check2"></i> Guardar</button></div>
  </div>
</div>
<% } %>

<script>
(function(){
  var SENDERS = <%- JSON.stringify(senders) %>;
  var STATES = <%- JSON.stringify(states) %>;
  var MOTIVES = <%- JSON.stringify(motives) %>;
  var STAGES = <%- JSON.stringify(stages) %>;
  var LOST = <%- JSON.stringify(lost) %>;
  var CAN_CREATE = <%- JSON.stringify(!!canCreate) %>;
  var CUST_ST = { active: 'Activo', suspended: 'Suspendido', inactive: 'Inscripto', cancelled: 'Cancelado', ditangguhkan: 'Con promesa' };
  var CHK = { nombre: 'Nombre', cedula: 'Cédula', fachada: 'Fachada', ubicacion: 'Ubicación' };
  var filter = 'por_atender', motive = '', q = '', sel = <%= Number(selected) || 0 %>, lastId = 0, conv = null, info = null, qr = [];
  var esc = function(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); };
  var fmtT = function(iso){ var d = new Date(iso); return isNaN(d) ? '' : d.toLocaleTimeString('es-PY', { hour: '2-digit', minute: '2-digit' }); };
  var fmtD = function(iso){ var d = new Date(iso); return isNaN(d) ? '' : d.toLocaleDateString('es-PY', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' }); };
  var ago = function(iso){
    var d = new Date(iso); if (isNaN(d)) return '';
    var m = Math.round((Date.now() - d) / 60000);
    if (m < 1) return 'ahora'; if (m < 60) return m + ' min';
    var h = Math.round(m / 60); if (h < 24) return h + ' h';
    var dd = Math.round(h / 24); if (dd < 30) return dd + ' d';
    return d.toLocaleDateString('es-PY', { day: '2-digit', month: '2-digit', year: '2-digit' });
  };
  var api = function(url, body){
    return fetch(url, body === undefined ? {} : { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) })
      .then(function(r){ return r.json(); });
  };
  var toast = function(t, err){ if (window.notify) window.notify(err ? 'error' : 'success', err ? 'Error' : 'Listo', t); else if (err) alert(t); };
  window.closeMo = function(id){ document.getElementById(id).classList.remove('show'); };
  var openMo = function(id){ document.getElementById(id).classList.add('show'); };

  function title(c){ return c.customer_name || c.lead_name || c.name || ('+' + (c.phone || '?')); }
  function checkLine(o){
    return Object.keys(CHK).map(function(k){
      var c = o.check[k];
      return '<span class="' + (c.ok ? 'ok' : (c.probable ? 'pr' : 'no')) + '">' + (c.ok ? '✓' : (c.probable ? '≈' : '✗')) + ' ' + CHK[k] + '</span>';
    }).join(' · ');
  }
  function chips(c){
    var o = c.org || {}, h = '';
    if (c.state === 'waiting_human') h += '<span class="cv-chip wait"><i class="bi bi-person-raised-hand"></i> Meta AI derivó · ' + esc(ago(c.handoff_at)) + '</span>';
    else if (o.inbox === 'por_atender' && o.waitingSince) h += '<span class="cv-chip wait"><i class="bi bi-hourglass-split"></i> Sin respuesta · ' + esc(ago(o.waitingSince)) + '</span>';
    if (o.nearClose) h += '<span class="cv-chip hot">🔥 A punto de cerrar</span>';
    if (o.lead && o.stage) h += '<span class="cv-chip lead">' + esc(STAGES[o.stage] || o.stage) + '</span>';
    else if (c.customer_id) h += '<span class="cv-chip cust">Cliente' + (c.customer_status && c.customer_status !== 'active' ? ' · ' + esc(CUST_ST[c.customer_status] || c.customer_status) : '') + '</span>';
    if (o.suggest && o.suggest.length) h += '<span class="cv-chip cust" title="El nombre coincide con un cliente registrado">¿Cliente? ' + esc(o.suggest[0].name) + '</span>';
    if (o.motive && o.motive !== 'otro') h += '<span class="cv-chip mot">' + esc(MOTIVES[o.motive] || o.motive) + '</span>';
    if (c.unread > 0) h += '<span class="cv-chip unread">' + c.unread + '</span>';
    String(c.labels || '').split(',').map(function(s){ return s.trim(); }).filter(Boolean).slice(0, 2).forEach(function(l){ h += '<span class="cv-chip">' + esc(l) + '</span>'; });
    if (c.assigned_to) h += '<span class="cv-chip"><i class="bi bi-person"></i> ' + esc(c.assigned_to) + '</span>';
    return h;
  }

  function loadList(){
    return api('/admin/conversations/list?f=' + encodeURIComponent(filter) + '&m=' + encodeURIComponent(motive) + '&q=' + encodeURIComponent(q)).then(function(d){
      if (!d.ok) return;
      var n = d.counts || {};
      document.querySelectorAll('[data-n]').forEach(function(x){
        var k = x.dataset.n;
        x.textContent = k === 'ventas' ? ((n.ventas || 0) + (n.cerca ? ' · 🔥' + n.cerca : '')) : (n[k] || '');
      });
      var items = d.items || [];
      var el = document.getElementById('cvList');
      if (!items.length) { el.innerHTML = '<div class="cv-empty">No hay conversaciones en esta bandeja.</div>'; return; }
      el.innerHTML = items.map(function(c){
        var pre = (c.last_sender && c.last_sender !== 'cliente' ? (SENDERS[c.last_sender] || '') + ': ' : '') + (c.last_preview || '');
        return '<div class="cv-item' + (c.id === sel ? ' on' : '') + '" data-id="' + c.id + '">' +
          '<div class="t"><span>' + esc(title(c)) + '</span><span>' + esc(ago(c.last_message_at)) + '</span></div>' +
          '<div class="p">' + esc(pre) + '</div><div class="b">' + chips(c) + '</div>' +
          (filter === 'ventas' && c.org && ['parciales', 'listo', 'requisitos'].indexOf(c.org.stage) !== -1 ? '<div class="cv-chk">' + checkLine(c.org) + '</div>' : '') + '</div>';
      }).join('');
    });
  }

  function bubble(m){
    var cls = m.sender || 'cliente';
    var who = cls === 'cliente' ? '' : (SENDERS[cls] || cls) + (m.by_name ? ' · ' + m.by_name : '');
    var body = '';
    var src = '/admin/conversations/media/' + m.id;
    if (m.media_type === 'image') body += '<a href="' + src + '" target="_blank"><img class="media" loading="lazy" src="' + src + '" alt="Imagen"></a>';
    else if (m.media_type === 'sticker') body += '<img class="media sticker" loading="lazy" src="' + src + '" alt="Sticker">';
    else if (m.media_type === 'audio' || m.media_type === 'ptt') body += '<audio controls preload="metadata" src="' + src + '"></audio>';
    else if (m.media_type === 'video') body += '<video controls preload="none" src="' + src + '"></video>';
    else if (m.media_type === 'document') body += '<a href="' + src + '" target="_blank"><i class="bi bi-file-earmark"></i> ' + esc(m.filename || 'Documento') + '</a>';
    else if (m.media_type === 'call') body += '<i class="bi bi-telephone"></i> Llamada';
    if (m.lat != null && m.lng != null) body += '<a href="https://maps.google.com/?q=' + m.lat + ',' + m.lng + '" target="_blank"><i class="bi bi-geo-alt-fill"></i> Ubicación (' + Number(m.lat).toFixed(5) + ', ' + Number(m.lng).toFixed(5) + ')</a>';
    if (m.body) body += (body ? '\n' : '') + esc(m.body);
    if (!body) body = '<span class="text-muted">(sin texto)</span>';
    if (cls === 'cliente' && m.media_type === 'image') body += '<div class="cv-mark" data-mid="' + m.id + '"><button data-k="cedula_msg">Es la cédula</button><button data-k="fachada_msg">Es la fachada</button></div>';
    var handoff = cls === 'meta_ai' && /pasado la conversaci[oó]n a un miembro del equipo/i.test(m.body || '');
    return '<div class="cv-m ' + cls + (handoff ? ' handoff' : '') + '" data-id="' + m.id + '">' +
      (who ? '<div class="who">' + esc(who) + (handoff ? ' · <i class="bi bi-person-raised-hand"></i> derivó a una persona' : '') + '</div>' : '') +
      body + '<div class="tm">' + esc(fmtT(m.ts)) + '</div></div>';
  }
  var lastDay = '';
  function appendMsgs(list, reset){
    var box = document.getElementById('cvMsgs');
    var atBottom = reset || box.scrollHeight - box.scrollTop - box.clientHeight < 80;
    if (reset) { box.innerHTML = ''; lastDay = ''; }
    var h = '';
    list.forEach(function(m){
      var day = fmtD(m.ts);
      if (day !== lastDay) { h += '<div class="cv-day">' + esc(day) + '</div>'; lastDay = day; }
      h += bubble(m);
      if (m.id > lastId) lastId = m.id;
    });
    box.insertAdjacentHTML('beforeend', h);
    paintMarks();
    if (atBottom) box.scrollTop = box.scrollHeight;
  }
  function paintMarks(){
    if (!conv) return;
    var lead = info && info.org && info.org.lead;
    document.querySelectorAll('.cv-mark').forEach(function(x){
      x.style.display = lead ? '' : 'none';
      var mid = Number(x.dataset.mid);
      x.querySelectorAll('button').forEach(function(b){ b.classList.toggle('on', Number(conv[b.dataset.k]) === mid); });
    });
  }

  function renderHead(c){
    conv = c;
    document.getElementById('cvName').textContent = title(c);
    var sub = (c.phone ? '+' + c.phone : 'Chat ' + c.jid) + (c.name && c.name !== title(c) ? ' · WhatsApp: ' + c.name : '');
    var st = STATES[c.state] || c.state;
    document.getElementById('cvSub').innerHTML = esc(sub) + ' · <b>' + esc(st) + '</b>' + (c.state === 'human' && c.attended_by ? ' (' + esc(c.attended_by) + ')' : '') +
      (c.customer_status === 'cancelled' ? ' · <span style="color:#f59e0b">Servicio cancelado</span>' : '');
    var a = '';
    if (info && info.org && info.org.inbox === 'por_atender' && c.state !== 'waiting_human') a += '<button class="btn btn-g btn-sm" onclick="orgSet({dismiss:1})" title="Sale de Por atender hasta que el contacto vuelva a escribir"><i class="bi bi-check2-circle"></i> No requiere respuesta</button>';
    if (c.state !== 'human') a += '<button class="btn btn-g btn-sm" onclick="cvState(\'human\')" title="Marca que una persona está atendiendo"><i class="bi bi-person-check"></i> La atiendo yo</button>';
    if (c.state === 'human' || c.state === 'waiting_human') a += '<button class="btn btn-g btn-sm" onclick="cvState(\'open\')" title="Deja de figurar como atendida por una persona. Meta AI responde según su propia configuración en WhatsApp Business."><i class="bi bi-robot"></i> Devolver a Meta AI</button>';
    a += c.state === 'closed' ? '<button class="btn btn-g btn-sm" onclick="cvState(\'open\')"><i class="bi bi-arrow-counterclockwise"></i> Reabrir</button>'
                              : '<button class="btn btn-g btn-sm" onclick="cvState(\'closed\')" title="Pasa al Archivo; vuelve sola si el contacto escribe"><i class="bi bi-archive"></i> Archivar</button>';
    a += '<button class="btn btn-g btn-sm cv-infobtn" onclick="document.getElementById(\'cvWrap\').classList.toggle(\'info\')"><i class="bi bi-layout-sidebar-reverse"></i> Datos</button>';
    document.getElementById('cvActs').innerHTML = a;
  }

  function sel_(name, opts, val, extra){
    return '<select class="fs" id="' + name + '" style="padding:5px 8px;font-size:12.5px" ' + (extra || '') + '>' + opts + '</select>';
  }
  function renderInfo(c, inf){
    info = inf;
    var el = document.getElementById('cvInfo');
    if (!inf) { el.innerHTML = ''; return; }
    var o = inf.org, h = '';
    // Motivo
    var mo = '<option value="">Automático: ' + esc(MOTIVES[o.motiveAuto] || o.motiveAuto) + '</option>' + Object.keys(MOTIVES).map(function(k){ return '<option value="' + k + '"' + (c.motive === k ? ' selected' : '') + '>' + esc(MOTIVES[k]) + '</option>'; }).join('');
    h += '<div><h6>Motivo</h6>' + sel_('inMot', mo, '', 'onchange="orgSet({motive:this.value})"') + '</div>';
    if (inf.customer) {
      var cu = inf.customer;
      h += '<div><h6>Cliente</h6>' +
        '<div class="row1"><span>Nombre</span><b>' + esc(cu.name) + '</b></div>' +
        '<div class="row1"><span>Código</span><span>' + esc(cu.customer_code || '#' + cu.id) + '</span></div>' +
        '<div class="row1"><span>Estado</span><span>' + esc(CUST_ST[cu.status] || cu.status) + (cu.withdraw_status === 'pendiente' ? ' · retiro pendiente' : '') + '</span></div>' +
        (cu.plan ? '<div class="row1"><span>Plan</span><span>' + esc(cu.plan) + '</span></div>' : '') +
        (cu.onu ? '<div class="row1"><span>ONU</span><span>' + esc(cu.onu.onu_ref || '') + ' · ' + esc(cu.onu.status || '-') + '</span></div>' : '') +
        '<div class="row1"><span>Tickets abiertos</span><span>' + (cu.tickets || 0) + '</span></div>' +
        (cu.debt ? '<div class="row1"><span>Facturas pendientes</span><span>' + cu.debt.n + (cu.debt.n ? ' · Gs. ' + Number(cu.debt.t).toLocaleString('es-PY') : '') + '</span></div>' : '') +
        (o.notice ? '<div class="row1"><span>Último aviso</span><span>' + esc(o.notice.type) + ' · ' + esc(new Date(o.notice.ts).toLocaleDateString('es-PY')) + '</span></div>' : '') +
        (cu.status === 'inactive' ? '<div class="row1"><span>Solicitud</span><span>' + esc(cu.reg_status === 'approved' ? 'Instalación asignada' : 'Pendiente de aprobar') + '</span></div>' : '') +
        '<a class="btn btn-g btn-sm" target="_blank" href="/admin/customers?search=' + encodeURIComponent(cu.customer_code || cu.name) + '"><i class="bi bi-person-vcard"></i> Abrir ficha</a>' +
        ((cu.others || []).length ? '<div style="margin-top:8px"><h6>Otras conversaciones de este cliente</h6>' + cu.others.map(function(x){
          return '<a href="?c=' + x.id + '" onclick="event.preventDefault();openConvExt(' + x.id + ')" style="display:block;font-size:12.5px;padding:3px 0"><i class="bi bi-chat-dots"></i> +' + esc(x.phone || '?') + ' · ' + esc(ago(x.last_message_at)) + (o.newerConv === x.id ? ' · <b>más reciente</b>' : '') + '</a>';
        }).join('') + '</div>' : '') + '</div>';
    }
    if (o.lead) {
      var so = '<option value="">Automática: ' + esc(STAGES[o.stageAuto] || o.stageAuto) + '</option>' + Object.keys(STAGES).filter(function(k){ return k !== 'perdido'; }).map(function(k){ return '<option value="' + k + '"' + (c.lead_stage === k ? ' selected' : '') + '>' + esc(STAGES[k]) + '</option>'; }).join('');
      h += '<div><h6>Venta</h6>' + (o.nearClose ? '<div style="margin-bottom:6px"><span class="cv-chip hot">🔥 A punto de cerrar</span></div>' : '') +
        '<label class="fl">Etapa</label>' + sel_('inStage', so, '', 'onchange="orgSet({lead_stage:this.value})"') +
        '<div class="cv-steps" style="margin-top:8px">' + Object.keys(CHK).map(function(k){
          var x = o.check[k];
          var t = x.ok ? '<span class="ok" style="color:#4ade80">✓</span>' : (x.probable ? '<span style="color:#fbbf24">≈</span>' : '<span style="color:#f87171">✗</span>');
          var extra = '';
          if (k === 'nombre') extra = ' <input class="fc" id="inName" style="padding:3px 7px;font-size:12px" value="' + esc(c.lead_name || (o.check.nombre.value || '')) + '" placeholder="Nombre y apellido" onchange="orgSet({lead_name:this.value})">';
          if (k === 'ubicacion' && x.ok) extra = ' <a target="_blank" href="https://maps.google.com/?q=' + x.lat + ',' + x.lng + '">ver mapa</a>';
          if ((k === 'cedula' || k === 'fachada') && !x.ok) extra = ' <span class="text-muted" style="font-size:11px">' + (x.confirmed ? 'Meta AI confirmó que llegó · marcá la foto para adjuntarla' : (x.probable ? 'hay fotos: marcá cuál es' : 'falta')) + '</span>';
          if (k === 'nombre' && !x.ok && x.probable) extra += ' <span class="text-muted" style="font-size:11px">detectado del chat, confirmalo</span>';
          if (k === 'ubicacion' && !x.ok) extra = ' <button class="btn btn-g btn-sm" style="padding:1px 8px;width:auto;margin:0" onclick="qrInsert(\'Pedir ubicación\')">Pedir</button>';
          return '<div>' + t + ' <b style="min-width:70px">' + CHK[k] + '</b>' + extra + '</div>';
        }).join('') + '</div>' +
        (CAN_CREATE && !c.customer_id ? '<button class="btn btn-p btn-sm" onclick="rqOpen()"><i class="bi bi-house-add"></i> Crear solicitud de instalación</button>' : '') +
        '<div style="margin-top:8px"><label class="fl">Venta perdida</label>' +
        sel_('inLost', '<option value="">— No —</option>' + Object.keys(LOST).map(function(k){ return '<option value="' + k + '"' + (c.lost_reason === k ? ' selected' : '') + '>' + esc(LOST[k]) + '</option>'; }).join(''), '', 'onchange="orgSet({lost_reason:this.value})"') + '</div>' +
        '</div>';
      if (o.suggest && o.suggest.length) h += '<div style="border:1px solid rgba(34,197,94,.45);border-radius:8px;padding:8px"><h6 style="color:#4ade80">¿Es cliente?</h6><div style="font-size:12.5px;margin-bottom:6px">El nombre de WhatsApp coincide con:</div>' +
        o.suggest.map(function(x){ return '<div style="display:flex;justify-content:space-between;gap:6px;align-items:center;padding:3px 0"><span><b>' + esc(x.name) + '</b> <span class="text-muted">' + esc(x.customer_code || '') + ' · ' + esc(CUST_ST[x.status] || x.status) + '</span></span><button class="btn btn-p btn-sm" style="width:auto;margin:0" onclick="lkQuick(' + x.id + ',\'' + esc(x.name).replace(/'/g, '') + '\')">Vincular</button></div>'; }).join('') + '</div>';
      h += '<div><button class="btn btn-g btn-sm" onclick="lkOpen()"><i class="bi bi-link-45deg"></i> Es cliente: vincular</button></div>';
    }
    h += '<div><h6>Organización</h6>' +
      '<div class="fg"><label class="fl">Asignada a</label><input class="fc" id="cvAssigned" maxlength="80" value="' + esc(c.assigned_to || '') + '"></div>' +
      '<div class="fg"><label class="fl">Etiquetas</label><input class="fc" id="cvLabels" maxlength="300" placeholder="separadas por coma" value="' + esc(c.labels || '') + '"></div>' +
      '<div class="fg"><label class="fl">Nota interna</label><textarea class="fc" id="cvNote" rows="2" maxlength="2000">' + esc(c.note || '') + '</textarea></div>' +
      '<button class="btn btn-g btn-sm" onclick="cvSaveSide(this)"><i class="bi bi-check2"></i> Guardar</button>' +
      '<label style="display:flex;gap:6px;align-items:center;margin-top:10px;font-size:12px;color:var(--muted)"><input type="checkbox" ' + (o.internal ? 'checked' : '') + ' onchange="orgSet({internal:this.checked?1:0})"> Conversación interna (personal / propia)</label>' +
      '</div>';
    el.innerHTML = h;
    paintMarks();
  }

  function openConv(id){
    sel = id; lastId = 0;
    document.getElementById('cvWrap').classList.add('chat');
    document.getElementById('cvNone').style.display = 'none';
    document.getElementById('cvChat').style.display = 'flex';
    try { history.replaceState(null, '', '?c=' + id); } catch (_) {}
    document.querySelectorAll('.cv-item').forEach(function(x){ x.classList.toggle('on', Number(x.dataset.id) === id); });
    return api('/admin/conversations/' + id + '/messages').then(function(d){
      if (!d.ok) { toast(d.message || 'No se pudo abrir', true); return; }
      info = d.info; renderHead(d.conv); renderInfo(d.conv, d.info); appendMsgs(d.messages || [], true);
      if (d.conv.unread > 0) api('/admin/conversations/' + id + '/read', {}).then(loadList);
    });
  }
  var infoKey = '';
  function poll(force){
    if (!sel || (document.hidden && !force)) return;
    return api('/admin/conversations/' + sel + '/messages?after=' + lastId).then(function(d){
      if (!d.ok) return;
      info = d.info; renderHead(d.conv);
      var k = JSON.stringify([d.info, d.conv.motive, d.conv.lead_stage, d.conv.lost_reason, d.conv.cedula_msg, d.conv.fachada_msg, d.conv.lead_name, d.conv.customer_id]);
      var editing = document.activeElement && document.getElementById('cvInfo').contains(document.activeElement);
      if (force || (k !== infoKey && !editing)) { infoKey = k; renderInfo(d.conv, d.info); }
      if (d.messages && d.messages.length) { appendMsgs(d.messages, false); if (d.conv.unread > 0) api('/admin/conversations/' + sel + '/read', {}); }
      else paintMarks();
    });
  }

  window.orgSet = function(f){
    if (!conv) return;
    api('/admin/conversations/' + conv.id + '/org', f).then(function(d){
      if (!d.ok) return toast(d.message, true);
      poll(true); loadList();
    });
  };
  window.cvBack = function(){ document.getElementById('cvWrap').classList.remove('chat'); };
  window.cvState = function(st){
    if (!conv) return;
    api('/admin/conversations/' + conv.id + '/state', { state: st }).then(function(d){
      if (!d.ok) return toast(d.message, true);
      poll(true); loadList();
    });
  };
  window.cvSaveSide = function(btn){
    if (!conv) return;
    btn.disabled = true;
    api('/admin/conversations/' + conv.id + '/update', { assigned_to: document.getElementById('cvAssigned').value, labels: document.getElementById('cvLabels').value, note: document.getElementById('cvNote').value })
      .then(function(d){ btn.disabled = false; if (!d.ok) return toast(d.message, true); toast('Guardado'); loadList(); });
  };
  window.cvSend = function(){
    var ta = document.getElementById('cvText'), t = ta.value.trim();
    if (!conv || !t) return;
    if (conv.customer_status === 'cancelled' && !confirm('Este cliente tiene el servicio cancelado. ¿Enviar igual la respuesta?')) return;
    var b = document.getElementById('cvSend'); b.disabled = true;
    api('/admin/conversations/' + conv.id + '/reply', { text: t }).then(function(d){
      b.disabled = false;
      if (!d.ok) return toast(d.message, true);
      ta.value = ''; ta.style.height = ''; poll(true); loadList();
    }).catch(function(){ b.disabled = false; toast('No se pudo enviar', true); });
  };
  window.cvSync = function(full, btn){
    if (full && !confirm('Traer todo el historial guardado en GoWA. Puede tardar un par de minutos. ¿Continuar?')) return;
    btn.disabled = true; var old = btn.innerHTML; btn.innerHTML = '<i class="bi bi-hourglass-split"></i>';
    fetch('/admin/conversations/sync' + (full ? '?full=1' : ''), { method: 'POST' }).then(function(r){ return r.json(); }).then(function(d){
      btn.disabled = false; btn.innerHTML = old;
      if (!d.ok) return toast(d.message || 'No se pudo', true);
      toast(full ? ('Historial: ' + (d.convs || 0) + ' conversaciones, ' + (d.msgs || 0) + ' mensajes nuevos') : ((d.nuevos || 0) + ' mensajes nuevos'));
      loadList(); if (sel) poll(true);
    }).catch(function(){ btn.disabled = false; btn.innerHTML = old; toast('No se pudo', true); });
  };

  // ── respuestas rápidas ──
  function loadQr(){ return api('/admin/conversations/quick-replies').then(function(d){ if (d.ok) { qr = d.items || []; window._qrRaw = d.raw; } }); }
  window.qrToggle = function(){
    var el = document.getElementById('cvQr');
    if (el.classList.contains('open')) { el.classList.remove('open'); return; }
    el.innerHTML = qr.length ? qr.map(function(r, i){ return '<div data-i="' + i + '"><b>' + esc(r.title) + '</b><small>' + esc(r.text.replace(/\s+/g, ' ').slice(0, 80)) + '</small></div>'; }).join('') : '<div>No hay respuestas rápidas.</div>';
    el.classList.add('open');
  };
  window.qrInsert = function(t){
    var r = qr.filter(function(x){ return x.title === t; })[0];
    if (!r) return toast('No existe la respuesta rápida "' + t + '"', true);
    var ta = document.getElementById('cvText'); ta.value = r.text; ta.dispatchEvent(new Event('input')); ta.focus();
  };
  document.getElementById('cvQr').addEventListener('click', function(e){
    var it = e.target.closest('[data-i]'); if (!it) return;
    var r = qr[Number(it.dataset.i)], ta = document.getElementById('cvText');
    ta.value = ta.value ? ta.value + '\n\n' + r.text : r.text;
    ta.dispatchEvent(new Event('input')); ta.focus();
    document.getElementById('cvQr').classList.remove('open');
  });

  // ── marcar fotos de cédula / fachada ──
  document.getElementById('cvMsgs').addEventListener('click', function(e){
    var b = e.target.closest('.cv-mark button'); if (!b || !conv) return;
    var mid = Number(b.closest('.cv-mark').dataset.mid), k = b.dataset.k, f = {};
    f[k] = Number(conv[k]) === mid ? '' : mid;
    orgSet(f);
  });

  // ── crear solicitud ──
  window.rqOpen = function(){
    if (!conv || !info) return;
    var o = info.org;
    document.getElementById('rqName').value = conv.lead_name || o.check.nombre.value || '';
    document.getElementById('rqNik').value = '';
    document.getElementById('rqAddr').value = '';
    document.getElementById('rqNotes').value = '';
    document.getElementById('rqLoc').innerHTML = o.check.ubicacion.ok ? '<i class="bi bi-geo-alt-fill" style="color:#4ade80"></i> Se usa la ubicación que mandó por WhatsApp (' + Number(o.check.ubicacion.lat).toFixed(5) + ', ' + Number(o.check.ubicacion.lng).toFixed(5) + ')' : '<span style="color:#f87171">Todavía no mandó la ubicación.</span> Se puede crear igual y completarla después.';
    openMo('reqModal');
  };
  window.rqSave = function(){
    var b = document.getElementById('rqBtn'); b.disabled = true;
    api('/admin/conversations/' + conv.id + '/create-request', {
      name: document.getElementById('rqName').value, nik: document.getElementById('rqNik').value,
      address: document.getElementById('rqAddr').value, package_id: document.getElementById('rqPkg').value, notes: document.getElementById('rqNotes').value,
    }).then(function(d){
      b.disabled = false;
      if (!d.ok) return toast(d.message, true);
      closeMo('reqModal'); toast(d.message); poll(true); loadList();
    }).catch(function(){ b.disabled = false; toast('No se pudo crear', true); });
  };

  // ── vincular a cliente ──
  var lkSel = 0, lkT;
  window.lkOpen = function(){ lkSel = 0; document.getElementById('lkQ').value = ''; document.getElementById('lkRes').innerHTML = ''; document.getElementById('lkBtn').disabled = true; openMo('linkModal'); setTimeout(function(){ document.getElementById('lkQ').focus(); }, 50); };
  document.getElementById('lkQ').addEventListener('input', function(e){
    clearTimeout(lkT); var v = e.target.value;
    lkT = setTimeout(function(){
      api('/admin/conversations/customer-search?q=' + encodeURIComponent(v)).then(function(d){
        var el = document.getElementById('lkRes');
        el.innerHTML = (d.items || []).map(function(c){ return '<div data-id="' + c.id + '"><b>' + esc(c.name) + '</b> <span class="text-muted">' + esc(c.customer_code || '') + ' · ' + esc(c.phone || '') + ' · ' + esc(CUST_ST[c.status] || c.status) + '</span></div>'; }).join('') || '<div class="text-muted">Sin resultados</div>';
      });
    }, 250);
  });
  document.getElementById('lkRes').addEventListener('click', function(e){
    var it = e.target.closest('[data-id]'); if (!it) return;
    lkSel = Number(it.dataset.id);
    document.querySelectorAll('#lkRes [data-id]').forEach(function(x){ x.classList.toggle('on', x === it); });
    document.getElementById('lkBtn').disabled = false;
  });
  window.openConvExt = function(id){ openConv(id); loadList(); };
  window.lkQuick = function(id, name){
    if (!conv || !confirm('¿Este chat es de ' + name + '? El número +' + (conv.phone || '') + ' queda como teléfono adicional del cliente.')) return;
    api('/admin/conversations/' + conv.id + '/link', { customer_id: id }).then(function(d){
      if (!d.ok) return toast(d.message, true);
      toast(d.message); poll(true); loadList();
    });
  };
  window.lkSave = function(){
    if (!lkSel || !conv) return;
    var b = document.getElementById('lkBtn'); b.disabled = true;
    api('/admin/conversations/' + conv.id + '/link', { customer_id: lkSel }).then(function(d){
      b.disabled = false;
      if (!d.ok) return toast(d.message, true);
      closeMo('linkModal'); toast(d.message); poll(true); loadList();
    });
  };

  // ── editor de respuestas rápidas (administrador) ──
  window.qeOpen = function(){
    loadQr().then(function(){
      var list = window._qrRaw || [];
      document.getElementById('qeList').innerHTML = '';
      list.forEach(function(r){ qeAdd(r); });
      openMo('qeModal');
    });
  };
  window.qeAdd = function(r){
    r = r || { title: '', text: '' };
    var d = document.createElement('div'); d.className = 'cv-qe';
    d.innerHTML = '<div style="display:flex;gap:6px"><input class="fc qe-t" maxlength="60" placeholder="Título" value="' + esc(r.title) + '"><button class="btn btn-g btn-sm" type="button" onclick="this.closest(\'.cv-qe\').remove()"><i class="bi bi-trash"></i></button></div>' +
      '<textarea class="fc qe-x" rows="4" maxlength="3000" style="margin-top:6px" placeholder="Texto">' + esc(r.text) + '</textarea>';
    document.getElementById('qeList').appendChild(d);
  };
  window.qeSave = function(btn){
    var items = Array.prototype.map.call(document.querySelectorAll('#qeList .cv-qe'), function(x){ return { title: x.querySelector('.qe-t').value, text: x.querySelector('.qe-x').value }; });
    btn.disabled = true;
    api('/admin/conversations/quick-replies', { items: items }).then(function(d){
      btn.disabled = false;
      if (!d.ok) return toast(d.message, true);
      closeMo('qeModal'); toast(d.message); loadQr();
    });
  };

  // Archivos viejos que WhatsApp ya no guarda: aviso en lugar de imagen o audio roto
  document.getElementById('cvMsgs').addEventListener('error', function(e){
    var el = e.target;
    if (!el || !/^(IMG|AUDIO|VIDEO)$/.test(el.tagName)) return;
    var n = document.createElement('div'); n.className = 'text-muted'; n.style.fontSize = '12px';
    n.innerHTML = '<i class="bi bi-file-earmark-x"></i> Archivo no disponible (ya no está en WhatsApp)';
    var host = el.parentNode && el.parentNode.tagName === 'A' ? el.parentNode : el;
    var mark = host.parentNode && host.parentNode.querySelector('.cv-mark');
    host.replaceWith(n);
    if (mark) mark.remove();
  }, true);
  document.getElementById('cvList').addEventListener('click', function(e){
    var it = e.target.closest('.cv-item'); if (it) openConv(Number(it.dataset.id));
  });
  document.getElementById('cvTabs').addEventListener('click', function(e){
    var b = e.target.closest('.cv-tab'); if (!b) return;
    filter = b.dataset.f;
    document.querySelectorAll('.cv-tab').forEach(function(x){ x.classList.toggle('on', x === b); });
    loadList();
  });
  document.getElementById('cvMot').addEventListener('change', function(e){ motive = e.target.value; loadList(); });
  var qt; document.getElementById('cvQ').addEventListener('input', function(e){ clearTimeout(qt); qt = setTimeout(function(){ q = e.target.value; loadList(); }, 300); });
  var ta = document.getElementById('cvText');
  ta.addEventListener('keydown', function(e){ if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); cvSend(); } });
  ta.addEventListener('input', function(){ ta.style.height = 'auto'; ta.style.height = Math.min(ta.scrollHeight, 160) + 'px'; });
  document.addEventListener('click', function(e){ var p = document.getElementById('cvQr'); if (p.classList.contains('open') && !e.target.closest('.cv-qr') && !e.target.closest('[onclick="qrToggle()"]')) p.classList.remove('open'); });

  loadQr();
  loadList().then(function(){ if (sel) openConv(sel); });
  setInterval(function(){ if (!document.hidden) loadList(); }, 10000);
  setInterval(function(){ poll(false); }, 5000);
})();
</script>
</body>
</html>
