  // Archivos viejos que WhatsApp ya no guarda: aviso en lugar de imagen o audio roto
  document.getElementById('cvMsgs').addEventListener('error', function(e){
    var el = e.target;
    if (!el || !/^(IMG|AUDIO|VIDEO)$/.test(el.tagName)) return;
    var n = document.createElement('div'); n.className = 'text-muted'; n.style.fontSize = '12px';
    n.innerHTML = '<i class="bi bi-file-earmark-x"></i> Archivo no disponible (ya no está en WhatsApp)';
    var host = el.parentNode && el.parentNode.tagName === 'A' ? el.parentNode : el;
    var mark = host.parentNode && host.parentNode.querySelector('.cv-mark');
    host.replaceWith(n);
    if (mark) mark.remove();
  }, true);
  document.getElementById('cvList').addEventListener('click', function(e){
    var cb = e.target.closest('input.sel');
    if (cb) { e.stopPropagation(); var id = Number(cb.dataset.id); if (cb.checked) picked[id] = 1; else delete picked[id]; bulkCount(); return; }
    var it = e.target.closest('.cv-item'); if (!it) return;
    if (selecting) { var x = it.querySelector('input.sel'); x.checked = !x.checked; var i2 = Number(x.dataset.id); if (x.checked) picked[i2] = 1; else delete picked[i2]; bulkCount(); return; }
    openConv(Number(it.dataset.id));
  });
  document.addEventListener('click', function(e){ var dd = document.getElementById('hideDd'); if (dd && !e.target.closest('#hideDd')) dd.classList.remove('open'); });
  document.getElementById('cvTabs').addEventListener('click', function(e){
    var b = e.target.closest('.cv-tab'); if (!b) return;
    filter = b.dataset.f;
    document.querySelectorAll('.cv-tab').forEach(function(x){ x.classList.toggle('on', x === b); });
    var mo = document.getElementById('cvMore'); mo.value = ''; mo.classList.remove('on');
    loadList();
  });
  document.getElementById('cvMore').addEventListener('change', function(e){
    if (!e.target.value) return;
    filter = e.target.value; e.target.classList.add('on');
    document.querySelectorAll('.cv-tab').forEach(function(x){ x.classList.remove('on'); });
    loadList();
  });
  document.getElementById('cvMot').addEventListener('change', function(e){ motive = e.target.value; loadList(); });
  var qt; document.getElementById('cvQ').addEventListener('input', function(e){ clearTimeout(qt); qt = setTimeout(function(){ q = e.target.value; loadList(); }, 300); });
  var ta = document.getElementById('cvText');
  ta.addEventListener('keydown', function(e){ if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); cvSend(); } });
  ta.addEventListener('input', function(){ ta.style.height = 'auto'; ta.style.height = Math.min(ta.scrollHeight, 160) + 'px'; });
  document.addEventListener('click', function(e){ var p = document.getElementById('cvQr'); if (p.classList.contains('open') && !e.target.closest('.cv-qr') && !e.target.closest('[onclick="qrToggle()"]')) p.classList.remove('open'); });


  // ════════ Vistas: Resumen (gráficos) · Tablero (columnas por bandeja) · Bandeja (chat) ════════
  var view = '', range = 30, bq = '', bm = '', boardData = null, statsData = null;
  var COLS = [
    { k: 'por_atender', t: 'Por atender', c: 't-tomato', d: 'var(--tomato)' },
    { k: 'ventas', t: 'Ventas', c: 't-butter', d: 'var(--butter)' },
    { k: 'soporte', t: 'Soporte técnico', c: 't-pine', d: 'var(--pine)' },
    { k: 'pagos', t: 'Pagos y cobranza', c: 't-ink', d: 'var(--ink)' },
    { k: 'clientes', t: 'Clientes', c: 't-glass', d: 'var(--faint)' }
  ];
  var fmtN = function(n){ return Number(n || 0).toLocaleString('es-PY'); };
  var fmtMin = function(m){ if (m == null) return '–'; if (m < 1) return Math.max(1, Math.round(m * 60)) + ' s'; if (m < 60) return Math.round(m) + ' min'; var h = m / 60; return (h < 10 ? h.toFixed(1).replace('.', ',') : Math.round(h)) + ' h'; };
  var css = function(n, d){ var v = getComputedStyle(document.body).getPropertyValue(n).trim() || getComputedStyle(document.documentElement).getPropertyValue(n).trim(); return v || d; };

  window.setView = function(v){
    view = v;
    try { localStorage.setItem('cv-view', v); } catch (_) {}
    document.querySelectorAll('#viewSeg button').forEach(function(b){ b.classList.toggle('on', b.dataset.v === v); });
    ['resumen', 'tablero', 'bandeja'].forEach(function(k){ document.getElementById('v' + k.charAt(0).toUpperCase() + k.slice(1)).classList.toggle('on', k === v); });
    if (v !== 'bandeja' && /[?&]c=/.test(location.search)) { try { history.replaceState(null, '', location.pathname); } catch (_) {} }
    if (v === 'resumen') { loadStats(); loadBoard(); }
    else if (v === 'tablero') loadBoard();
    else loadList();
  };
  document.getElementById('viewSeg').addEventListener('click', function(e){ var b = e.target.closest('button'); if (b) setView(b.dataset.v); });
  // Abrir una bandeja concreta en la vista de chat
  window.openInbox = function(k){
    filter = k;
    var tab = document.querySelector('.cv-tab[data-f="' + k + '"]'), mo = document.getElementById('cvMore');
    document.querySelectorAll('.cv-tab').forEach(function(x){ x.classList.toggle('on', x === tab); });
    if (tab) { mo.value = ''; mo.classList.remove('on'); } else { mo.value = k; mo.classList.add('on'); }
    setView('bandeja');
  };
  window.goConv = function(id, inbox){
    if (inbox) { filter = inbox; document.querySelectorAll('.cv-tab').forEach(function(x){ x.classList.toggle('on', x.dataset.f === inbox); }); var mo = document.getElementById('cvMore'); if (!document.querySelector('.cv-tab[data-f="' + inbox + '"]')) { mo.value = inbox; mo.classList.add('on'); } else { mo.value = ''; mo.classList.remove('on'); } }
    setView('bandeja'); openConv(id);
  };
  function setHeadCounts(n){
    var b = document.getElementById('stPaB'), u = n.unreadTotal || 0;
    if (b) { b.style.display = u ? '' : 'none'; b.innerHTML = '<i class="bi bi-envelope-fill"></i> ' + u + ' sin leer'; }
    document.title = (u ? '(' + u + ') ' : '') + 'Conversaciones | ' + <%- JSON.stringify(company).replace(/</g, '\\u003c') %>;
    var setTxt = function(id, v){ var e = document.getElementById(id); if (e) e.textContent = v; };
    setTxt('stPa', n.por_atender || 0); setTxt('stVe', n.ventas || 0); setTxt('stSo', n.soporte || 0);
    var hot = document.getElementById('stHot'); if (hot) { hot.style.display = n.cerca ? '' : 'none'; hot.textContent = '🔥 ' + (n.cerca || 0) + ' a punto de cerrar'; }
  }

  // Fecha y hora corta: "hoy 15:32", "ayer 09:10", "17/10 15:32" (con año si no es este año)
  function when(iso){
    var d = new Date(iso); if (isNaN(d)) return '';
    var hm = d.toLocaleTimeString('es-PY', { hour: '2-digit', minute: '2-digit', hour12: false });
    var t0 = new Date(); t0.setHours(0, 0, 0, 0);
    var diff = Math.floor((t0 - new Date(d.getFullYear(), d.getMonth(), d.getDate())) / 86400000);
    if (diff <= 0) return 'hoy ' + hm;
    if (diff === 1) return 'ayer ' + hm;
    return d.toLocaleDateString('es-PY', d.getFullYear() === t0.getFullYear() ? { day: '2-digit', month: '2-digit' } : { day: '2-digit', month: '2-digit', year: '2-digit' }) + ' ' + hm;
  }
  var REPLY_BY = { persona: 'Oficina', meta_ai: 'Meta AI' };
  // Línea con el último mensaje del contacto y la última respuesta (quién y cuándo)
  function timesLine(c){
    var o = c.org || {}, h = '';
    if (o.lastIn) h += '<span title="Último mensaje del contacto"><i class="bi bi-chat-left-text"></i> ' + esc(when(o.lastIn)) + '</span>';
    h += o.lastReply ? '<span title="Última respuesta"><i class="bi bi-reply-fill"></i> ' + esc(REPLY_BY[o.lastReply.sender] || 'Respuesta') + ' · ' + esc(when(o.lastReply.ts)) + '</span>'
                     : '<span title="Todavía nadie respondió"><i class="bi bi-reply"></i> Sin respuesta</span>';
    return '<div class="lt">' + h + '</div>';
  }
  var CAT = { internas: 'Interna', ventas: 'Ventas', soporte: 'Soporte', pagos: 'Pagos', clientes: 'Cliente', avisos: 'Avisos' };
  // Sobre con la cantidad de chats sin leer (para encabezados y pestañas)
  function unreadBadge(n, k){ var u = (n.unread || {})[k] || 0; return u ? '<span class="unb" title="' + u + ' chat' + (u > 1 ? 's' : '') + ' con mensajes sin leer"><i class="bi bi-envelope-fill"></i> ' + u + '</span>' : ''; }

  // ── Tarjeta de conversación (tablero y "esperan respuesta") ──
  function tile(c, cls, inbox){
    var o = c.org || {};
    var isInt = o.category === 'internas' || o.internal;
    var sub = isInt ? 'Chat interno' : (c.customer_id ? ('Cliente' + (c.customer_status && c.customer_status !== 'active' ? ' · ' + (CUST_ST[c.customer_status] || c.customer_status) : '') + (c.customer_code ? ' · ' + c.customer_code : ''))
                            : (o.lead ? (STAGES[o.stage] || 'Interesado') : 'Contacto'));
    var top = c.state === 'waiting_human' ? '<span><i class="bi bi-person-raised-hand"></i> Meta AI derivó · ' + esc(ago(c.handoff_at)) + '</span>'
            : (o.inbox === 'por_atender' && (o.waitingSince || o.lastIn) ? '<span><i class="bi bi-hourglass-split"></i> Espera hace ' + esc(ago(o.waitingSince || o.lastIn)) + '</span>'
            : '<span>' + esc(ago(c.last_message_at)) + (!isInt && o.motive && o.motive !== 'otro' ? ' · ' + esc(MOTIVES[o.motive] || o.motive) : '') + '</span>');
    var pre = (c.last_sender && c.last_sender !== 'cliente' ? (SENDERS[c.last_sender] || '') + ': ' : '') + (c.last_preview || '');
    var ch = '';
    if (c.unread > 0) ch += '<span class="u">' + c.unread + ' sin leer</span>';
    if (o.inbox === 'por_atender' && o.category && CAT[o.category]) ch += '<span title="Su clasificación: pasa a esa columna al responderlo">' + CAT[o.category] + '</span>';
    if (o.pinned) ch += '<span title="Columna elegida a mano' + (o.pinBy ? ' por ' + esc(o.pinBy) : '') + '">📌 A mano</span>';
    if (o.unlinked) ch += '<span title="Escribe por un pago o una falla pero no está vinculado a un cliente: abrí el chat y vinculalo">¿Cliente sin vincular?</span>';
    if (o.reconnect) ch += '<span>Reconexión</span>';
    if (o.nearClose && !isInt) ch += '<span>🔥 A punto de cerrar</span>';
    if (o.lead && !isInt && ['parciales', 'listo', 'requisitos'].indexOf(o.stage) !== -1) ch += '<span>' + Object.keys(CHK).filter(function(k){ return o.check[k] && o.check[k].ok; }).length + '/4 requisitos</span>';
    if (o.suggest && o.suggest.length && !isInt) ch += '<span>¿Cliente? ' + esc(o.suggest[0].name) + '</span>';
    if (c.assigned_to) ch += '<span><i class="bi bi-person"></i> ' + esc(c.assigned_to) + '</span>';
    String(c.labels || '').split(',').map(function(x){ return x.trim(); }).filter(Boolean).slice(0, 2).forEach(function(l){ ch += '<span>' + esc(l) + '</span>'; });
    return '<button class="tile ' + cls + (c.unread > 0 ? ' unr' : '') + '" draggable="true" data-id="' + c.id + '" data-inbox="' + esc(inbox || o.inbox || '') + '" data-pinned="' + (o.pinned ? 1 : 0) + '" title="Abrir el chat · arrastrala para cambiarla de columna">' +
      '<div class="tt">' + top + '<span class="dots" data-move="1" title="Mover a…"><i class="bi bi-three-dots"></i></span></div>' +
      '<div class="nm">' + esc(title(c)) + '</div><div class="sb">' + esc(sub) + '</div>' +
      '<div class="pv">' + esc(pre) + '</div>' + timesLine(c) +
      '<div class="ft"><div class="tchips">' + ch + '</div>' + avHtml(c) + '</div></button>';
  }

  // ── Tablero ──
  function loadBoard(){
    return api('/admin/conversations/board?q=' + encodeURIComponent(bq) + '&m=' + encodeURIComponent(bm)).then(function(d){
      if (!d.ok) return;
      boardData = d; setHeadCounts(d.counts || {});
      if (view === 'resumen') renderHot();
      if (view !== 'tablero') return;
      var n = d.counts || {}, el = document.getElementById('board');
      var keep = {}; el.querySelectorAll('.bcards').forEach(function(x){ keep[x.dataset.k] = x.scrollTop; });
      el.innerHTML = COLS.map(function(col){
        var items = d.cols[col.k] || [];
        var x = col.k === 'ventas' && n.cerca ? '🔥 ' + n.cerca : '';
        return '<div class="card bcol" data-drop="' + col.k + '"><div class="bh"><i class="d" style="background:' + col.d + '"></i>' + col.t + ' <span class="n">' + (n[col.k] || 0) + '</span>' + unreadBadge(n, col.k) + '<span class="x">' + x + '</span>' +
          '<button class="cbtn" style="width:30px;height:30px;font-size:12px" title="Abrir en la bandeja" onclick="openInbox(\'' + col.k + '\')"><i class="bi bi-arrow-up-right"></i></button></div>' +
          '<div class="bcards" data-k="' + col.k + '">' + (items.length ? items.map(function(c){ return tile(c, col.c, col.k); }).join('') + ((n[col.k] || 0) > items.length ? '<button class="pchip" onclick="openInbox(\'' + col.k + '\')">Ver las ' + n[col.k] + ' en la bandeja</button>' : '') : '<div class="empty2">' + (bq || bm ? 'Sin resultados' : 'Nada pendiente 🎉') + '</div>') + '</div></div>';
      }).join('') +
      '<div class="bside">' +
        '<div class="card" data-drop="archivo" onclick="openInbox(\'archivo\')"><span class="bi2" style="background:var(--well)"><i class="bi bi-archive"></i></span><b>Archivo</b><small>' + fmtN(n.archivo) + ' chats</small>' + unreadBadge(n, 'archivo') + '</div>' +
        '<div class="card" onclick="openInbox(\'avisos\')"><span class="bi2" style="background:var(--well)"><i class="bi bi-megaphone"></i></span><b>Avisos</b><small>' + fmtN(n.avisos) + ' enviados</small>' + unreadBadge(n, 'avisos') + '</div>' +
        '<div class="card" data-drop="internas" onclick="openInbox(\'internas\')"><span class="bi2" style="background:var(--well)"><i class="bi bi-people"></i></span><b>Internas</b><small>' + fmtN(n.internas) + ' chats</small>' + unreadBadge(n, 'internas') + '</div>' +
        (IS_ADMIN ? '<div class="card" data-drop="ocultas" onclick="openInbox(\'ocultas\')"><span class="bi2" style="background:var(--well)"><i class="bi bi-eye-slash"></i></span><b>Ocultas</b><small>' + fmtN(n.ocultas) + ' chats</small>' + unreadBadge(n, 'ocultas') + '</div>' : '') +
      '</div>';
      el.querySelectorAll('.bcards').forEach(function(x){ if (keep[x.dataset.k]) x.scrollTop = keep[x.dataset.k]; });
    });
