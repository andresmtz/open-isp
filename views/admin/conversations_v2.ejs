  // ── crear solicitud ──
  window.rqOpen = function(){
    if (!conv || !info) return;
    var o = info.org;
    document.getElementById('rqName').value = conv.lead_name || o.check.nombre.value || '';
    document.getElementById('rqNik').value = '';
    var hint = document.getElementById('rqNikHint'); hint.textContent = '';
    if (o.check.cedula && o.check.cedula.ok) {
      hint.textContent = 'Leyendo la foto de la cédula…';
      var cid = conv.id;
      fetch('/admin/conversations/' + cid + '/cedula').then(function(r){ return r.json(); }).then(function(d){
        if (!conv || conv.id !== cid) return;
        if (!d.ok) { hint.textContent = d.reason || ''; return; }
        var nik = document.getElementById('rqNik'), nm = document.getElementById('rqName');
        if (d.number && !nik.value) nik.value = d.number;
        // nombre: se compara lo leído de la cédula con lo que se habló en el chat
        var title = function(s){ return String(s || '').toLowerCase().split(/\s+/).filter(Boolean).map(function(w){ return w.charAt(0).toUpperCase() + w.slice(1); }).join(' '); };
        var toks = function(s){ return String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().split(/[^a-zñ]+/).filter(function(w){ return w.length > 1; }); };
        var cedName = title(d.name), chatName = nm.value.trim();
        var ct = toks(chatName), dt = toks(cedName);
        var common = ct.filter(function(w){ return dt.indexOf(w) >= 0; }).length;
        var nameMsg = '';
        if (cedName && !chatName) { nm.value = cedName; nameMsg = ' El nombre se completó con el de la cédula.'; }
        else if (cedName && ct.length && common === ct.length) {
          nameMsg = ' <span style="color:#4ade80">El nombre del chat coincide con la cédula.</span>';
          if (dt.length > ct.length) nameMsg += ' <a href="#" id="rqUseCed">Usar el completo: ' + esc(cedName) + '</a>';
        } else if (cedName) {
          nameMsg = ' <span style="color:#f87171">El nombre del chat (' + esc(chatName) + ') ' + (common ? 'coincide solo en parte' : 'no coincide') + ' con la cédula.</span> <a href="#" id="rqUseCed">Usar el de la cédula: ' + esc(cedName) + '</a>';
        }
        hint.innerHTML = '<i class="bi bi-check2-circle" style="color:#4ade80"></i> Leído de la foto: ' + esc(d.number || '?') + (cedName ? ' · ' + esc(cedName) : '') + '. Revisalo antes de crear.' + nameMsg;
        var use = document.getElementById('rqUseCed');
        if (use) use.onclick = function(e){ e.preventDefault(); nm.value = cedName; use.parentNode.removeChild(use); };
      }).catch(function(){ hint.textContent = ''; });
    }
    document.getElementById('rqAddr').value = '';
    document.getElementById('rqNotes').value = '';
    document.getElementById('rqLoc').innerHTML = o.check.ubicacion.ok ? '<i class="bi bi-geo-alt-fill" style="color:#4ade80"></i> Se usa la ubicación que mandó por WhatsApp (' + Number(o.check.ubicacion.lat).toFixed(5) + ', ' + Number(o.check.ubicacion.lng).toFixed(5) + ')' : '<span style="color:#f87171">Todavía no mandó la ubicación.</span> Se puede crear igual y completarla después.';
    openMo('reqModal');
  };
  window.rqSave = function(){
    var b = document.getElementById('rqBtn'); b.disabled = true;
    api('/admin/conversations/' + conv.id + '/create-request', {
      name: document.getElementById('rqName').value, nik: document.getElementById('rqNik').value,
      address: document.getElementById('rqAddr').value, package_id: document.getElementById('rqPkg').value, notes: document.getElementById('rqNotes').value,
    }).then(function(d){
      b.disabled = false;
      if (!d.ok) return toast(d.message, true);
      closeMo('reqModal'); toast(d.message); poll(true); loadList();
    }).catch(function(){ b.disabled = false; toast('No se pudo crear', true); });
  };

  // ── vincular a cliente ──
  var lkSel = 0, lkT;
  window.lkOpen = function(){ lkSel = 0; document.getElementById('lkQ').value = ''; document.getElementById('lkRes').innerHTML = ''; document.getElementById('lkBtn').disabled = true; openMo('linkModal'); setTimeout(function(){ document.getElementById('lkQ').focus(); }, 50); };
  document.getElementById('lkQ').addEventListener('input', function(e){
    clearTimeout(lkT); var v = e.target.value;
    lkT = setTimeout(function(){
      api('/admin/conversations/customer-search?q=' + encodeURIComponent(v)).then(function(d){
        var el = document.getElementById('lkRes');
        el.innerHTML = (d.items || []).map(function(c){ return '<div data-id="' + c.id + '"><b>' + esc(c.name) + '</b> <span class="text-muted">' + esc(c.customer_code || '') + ' · ' + esc(c.phone || '') + ' · ' + esc(CUST_ST[c.status] || c.status) + '</span></div>'; }).join('') || '<div class="text-muted">Sin resultados</div>';
      });
