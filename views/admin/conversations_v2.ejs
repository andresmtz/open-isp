<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' && lang ? lang : 'es' %>" data-ui="v2">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>Conversaciones | <%= company %></title>
  <!-- Diseño nuevo: página con estilos propios. (Marca para que no se inyecte el aviso de estado anterior: /js/service-notice-badge.js) -->
  <script>
    // Tema antes de pintar (misma preferencia que el resto del panel: localStorage "app-theme")
    (function(){ try { var t = localStorage.getItem('app-theme'); if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; document.documentElement.setAttribute('data-theme', t); } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); } })();
  </script>
  <link rel="stylesheet" href="/css/v2/shell.css?v=3">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <style>
    /* ── Tokens ─────────────────────────────────────────────────────────────── */
    :root{
      --font:"Urbanist",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
      --bg:#ebe8e1;--text:#17191a;--muted:#676a66;--faint:#8e918c;
      --glass:rgba(255,255,255,.46);--glass-2:rgba(255,255,255,.64);--glass-3:rgba(255,255,255,.84);
      --rim:rgba(255,255,255,.78);--line:rgba(23,25,26,.09);--line-2:rgba(23,25,26,.16);--well:rgba(23,25,26,.055);
      --solid:#f6f4ef;--float:#fdfcf9;--ink:#17191a;--on-ink:#fbf8f2;
      --pine:#2f5c50;--on-pine:#fbf8f2;--tomato:#c8431f;--on-tomato:#fbf8f2;--butter:#f2c94c;--on-butter:#17191a;
      --good:#2f7a52;--bad:#c8431f;--dock:#17191a;--on-dock:#fbf8f2;
      --mesh-a:#f2d3bd;--mesh-b:#cfdfcd;--mesh-c:#f1e4bf;
      --shadow:0 1px 0 rgba(255,255,255,.7) inset,0 24px 48px -30px rgba(70,50,30,.28);
      --shadow-pop:0 24px 60px -18px rgba(40,30,20,.32),0 2px 6px rgba(40,30,20,.08);
      --r-card:26px;--r-tile:20px;--ease:cubic-bezier(.2,.8,.2,1);
      color-scheme:light;
    }
    [data-theme="dark"]{
      --bg:#111412;--text:#f1eee8;--muted:#a3a6a0;--faint:#7d807b;
      --glass:rgba(255,255,255,.05);--glass-2:rgba(255,255,255,.085);--glass-3:#222624;
      --rim:rgba(255,255,255,.07);--line:rgba(255,255,255,.08);--line-2:rgba(255,255,255,.16);--well:rgba(255,255,255,.06);
      --solid:#1c201e;--float:#242927;--ink:#f1eee8;--on-ink:#17191a;
      --tomato:#d8532d;--good:#6cc59a;--bad:#f08a68;--dock:rgba(255,255,255,.08);--on-dock:#f1eee8;
      --mesh-a:rgba(200,67,31,.28);--mesh-b:rgba(47,92,80,.5);--mesh-c:rgba(242,201,76,.10);
      --shadow:0 1px 0 rgba(255,255,255,.05) inset,0 24px 48px -30px rgba(0,0,0,.7);
      --shadow-pop:0 24px 60px -18px rgba(0,0,0,.7),0 0 0 1px rgba(255,255,255,.08);
      color-scheme:dark;
    }
    *{box-sizing:border-box}
    html,body{margin:0;height:100%}
    body{font-family:var(--font);font-size:14px;font-weight:500;color:var(--text);background:var(--bg);-webkit-font-smoothing:antialiased;overflow:hidden;display:flex;flex-direction:column}
    a{color:inherit}
    button,input,select,textarea{font:inherit;color:inherit}
    /* Fondo con manchas de color suaves */
    .mesh{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
    .mesh i{position:absolute;border-radius:50%;filter:blur(10px)}
    .mesh .a{width:62vw;height:62vw;left:-18vw;top:-28vw;background:radial-gradient(closest-side,var(--mesh-a),transparent)}
    .mesh .b{width:58vw;height:58vw;right:-16vw;bottom:-30vw;background:radial-gradient(closest-side,var(--mesh-b),transparent)}
    .mesh .c{width:40vw;height:40vw;left:38vw;top:-14vw;background:radial-gradient(closest-side,var(--mesh-c),transparent)}
    .app{position:relative;z-index:1;flex:1;min-height:0;display:flex;flex-direction:column;padding:4px clamp(16px,1.6vw,28px) 16px calc(clamp(16px,1.6vw,28px) + 78px)}

    /* ── Barra superior ─────────────────────────────────────────────────────── */
    .top{display:flex;align-items:center;gap:16px;margin-bottom:14px}
    .brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:17px;text-decoration:none;margin-left:-76px;min-width:150px}
    .brand .lg{width:38px;height:38px;border-radius:12px;background:var(--ink);color:var(--on-ink);display:grid;place-items:center;font-weight:800;font-size:18px}
    .nav{flex:1;display:flex;justify-content:center;gap:2px;overflow-x:auto;scrollbar-width:none}
    .nav a{padding:10px 17px;border-radius:999px;font-weight:600;font-size:13.5px;text-decoration:none;white-space:nowrap;transition:background .2s var(--ease),color .2s}
    .nav a:hover{background:var(--well)}
    .nav a.on{background:var(--ink);color:var(--on-ink)}
    .tright{display:flex;gap:8px;align-items:center}
    .ibtn{width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:var(--glass-2);display:grid;place-items:center;cursor:pointer;font-size:16px;transition:transform .15s,background .2s;text-decoration:none}
    .ibtn:hover{background:var(--glass-3);transform:translateY(-1px)}
    .me{width:40px;height:40px;border-radius:50%;background:var(--pine);color:var(--on-pine);display:grid;place-items:center;font-weight:700}

    /* ── Barra flotante de accesos ──────────────────────────────────────────── */
    .dock{position:fixed;left:clamp(16px,1.6vw,28px);top:50%;transform:translateY(-50%);z-index:40;background:var(--dock);color:var(--on-dock);border-radius:999px;padding:8px;display:flex;flex-direction:column;gap:4px;box-shadow:var(--shadow-pop);backdrop-filter:blur(14px)}
    .dock button,.dock a{width:44px;height:44px;border-radius:50%;border:0;background:transparent;color:inherit;display:grid;place-items:center;font-size:17px;cursor:pointer;position:relative;text-decoration:none;transition:background .2s}
    .dock button:hover,.dock a:hover{background:rgba(255,255,255,.12)}
    .dock .sep{height:1px;background:rgba(255,255,255,.14);margin:4px 8px}
    .dock [data-tip]:hover::after{content:attr(data-tip);position:absolute;left:54px;top:50%;transform:translateY(-50%);background:var(--float);color:var(--text);padding:6px 10px;border-radius:10px;font-size:12px;font-weight:600;white-space:nowrap;box-shadow:var(--shadow-pop);pointer-events:none}

    /* ── Encabezado ─────────────────────────────────────────────────────────── */
    .head{display:flex;align-items:center;gap:28px;margin-bottom:16px;flex-wrap:wrap}
    .head h1{margin:0;font-size:clamp(28px,2.6vw,38px);line-height:1.02;font-weight:600;letter-spacing:-.025em}
    .stats{display:flex;gap:26px;flex-wrap:wrap}
    .st{display:flex;gap:10px;align-items:center}
    .st .ic{width:40px;height:40px;border-radius:50%;background:var(--glass-2);border:1px solid var(--line);display:grid;place-items:center;font-size:16px}
    .st b{font-size:21px;font-weight:700;letter-spacing:-.02em;display:flex;align-items:center;gap:8px}
    .st small{display:block;color:var(--muted);font-size:12px}
    .badge{font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;letter-spacing:.01em}
    .badge.pine{background:var(--pine);color:var(--on-pine)}.badge.butter{background:var(--butter);color:var(--on-butter)}.badge.tomato{background:var(--tomato);color:var(--on-tomato)}
    .hours{margin-left:auto;font-size:12.5px;color:var(--muted);display:flex;gap:8px;align-items:center;background:var(--glass);border:1px solid var(--rim);padding:8px 14px;border-radius:999px}

    /* ── Tarjetas y columnas ────────────────────────────────────────────────── */
    .card{background:var(--glass);border:1px solid var(--rim);border-radius:var(--r-card);box-shadow:var(--shadow);backdrop-filter:blur(18px) saturate(1.1);-webkit-backdrop-filter:blur(18px) saturate(1.1)}
    .cv-wrap{flex:1;min-height:0;display:grid;grid-template-columns:minmax(300px,360px) 1fr minmax(280px,330px);gap:16px}
    .cv-pane{display:flex;flex-direction:column;min-height:0;overflow:hidden}
    .cv-tools{padding:16px 16px 10px;display:flex;flex-direction:column;gap:10px}
    .search{display:flex;align-items:center;gap:8px;background:var(--glass-2);border:1px solid var(--line);border-radius:999px;padding:0 14px;height:42px}
    .search input{flex:1;border:0;background:transparent;outline:0;font-size:13.5px}
    .cv-tabs{display:flex;gap:2px;background:var(--well);padding:4px;border-radius:999px;overflow-x:auto;scrollbar-width:none}.cv-tabs::-webkit-scrollbar{display:none}
    .cv-tab{flex:none;font-size:12px;font-weight:600;padding:7px 9px;border-radius:999px;border:0;background:transparent;color:var(--muted);cursor:pointer;transition:background .2s,color .2s}
    .cv-tab:hover{color:var(--text)}
    .cv-tab.on{background:var(--float);color:var(--text);box-shadow:0 1px 3px rgba(0,0,0,.08)}
    .cv-tab .n{font-weight:800;margin-left:3px;font-size:11px;color:var(--faint)}
    .cv-tab.on .n{color:var(--tomato)}
    .row-tools{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
    .row-tools select{flex:1 1 130px;min-width:0;height:36px;border-radius:999px;border:1px solid var(--line);background:var(--glass-2);padding:0 12px;font-size:12.5px;font-weight:600;outline:0}.row-tools select.on{background:var(--ink);color:var(--on-ink);border-color:transparent}
    .tbtn{width:36px;height:36px;border-radius:50%;border:1px solid var(--line);background:var(--glass-2);display:grid;place-items:center;cursor:pointer;font-size:14px}
    .tbtn:hover{background:var(--glass-3)}.tbtn.on{background:var(--ink);color:var(--on-ink)}
    .cv-list{overflow-y:auto;flex:1;padding:4px 10px 12px}
    .cv-item{display:flex;gap:11px;padding:11px 10px;border-radius:18px;cursor:pointer;transition:background .2s var(--ease);margin-bottom:2px}
    .cv-item:hover{background:var(--well)}
    .cv-item.on{background:var(--float);box-shadow:0 10px 24px -16px rgba(40,30,20,.35)}
    .av{flex:none;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;font-weight:700;font-size:14px;letter-spacing:.02em;position:relative;overflow:hidden}.av img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .av.cust{background:#d8e6dc;color:#2f5c50}.av.lead{background:#f6e7b4;color:#7a5d0a}.av.int{background:var(--well);color:var(--muted)}.av.hot{background:#f4cdbd;color:#a3361a}
    [data-theme="dark"] .av.cust{background:rgba(108,197,154,.18);color:#9fdcbd}[data-theme="dark"] .av.lead{background:rgba(242,201,76,.18);color:#f2d47a}[data-theme="dark"] .av.hot{background:rgba(216,83,45,.22);color:#f3a588}
    .cvb{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
    .cv-item .t{display:flex;justify-content:space-between;gap:6px;font-weight:700;font-size:14px}
    .cv-item .t span:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .cv-item .t span:last-child{font-weight:600;font-size:11.5px;color:var(--faint);white-space:nowrap}
    .cv-item .p{font-size:12.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .cv-item .b{display:flex;gap:4px;flex-wrap:wrap;margin-top:2px}
    .cv-chip{font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:999px;background:var(--well);color:var(--muted);white-space:nowrap}
    .cv-chip.wait{background:var(--butter);color:var(--on-butter)}
    .cv-chip.hot{background:var(--tomato);color:var(--on-tomato)}
    .cv-chip.cust{background:rgba(47,92,80,.14);color:var(--pine)}[data-theme="dark"] .cv-chip.cust{background:rgba(108,197,154,.16);color:#9fdcbd}
    .cv-chip.lead{background:rgba(242,201,76,.28);color:#7a5d0a}[data-theme="dark"] .cv-chip.lead{color:#f2d47a;background:rgba(242,201,76,.16)}
    .cv-chip.unread{background:var(--tomato);color:var(--on-tomato);min-width:20px;text-align:center}
    .cv-chip.mot{background:var(--well);color:var(--text)}
    .cv-chk{font-size:11.5px;color:var(--muted);margin-top:2px}
    .cv-chk .ok{color:var(--good)}.cv-chk .no{color:var(--bad)}.cv-chk .pr{color:#b8860b}
    .cv-item .sel{display:none;margin-right:6px;accent-color:var(--pine)}
    .cv-list.selecting .cv-item .sel{display:inline-block}
    .cv-bulk{display:none;margin:0 16px 8px;padding:8px 10px;border-radius:16px;gap:6px;flex-wrap:wrap;align-items:center;font-size:12.5px;background:rgba(242,201,76,.22)}
    .cv-bulk.open{display:flex}
    .cv-empty{flex:1;display:flex;align-items:center;justify-content:center;color:var(--muted);text-align:center;padding:30px;font-size:14px}

    /* Chat */
    .cv-head{padding:14px 16px;display:flex;gap:12px;align-items:center;flex-wrap:wrap;border-bottom:1px solid var(--line)}
    .cv-head .who{flex:1;min-width:160px}
    .cv-head .who b{font-size:17px;font-weight:700;letter-spacing:-.01em}
    .cv-head .who div{font-size:12.5px;color:var(--muted);margin-top:1px}
    .cv-acts{display:flex;gap:6px;flex-wrap:wrap}
    .cv-msgs{flex:1;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:8px}
    .cv-day{align-self:center;font-size:11.5px;font-weight:600;color:var(--muted);padding:4px 12px;background:var(--well);border-radius:999px;margin:8px 0}
    .cv-m{max-width:74%;padding:9px 13px 6px;border-radius:20px;font-size:14px;line-height:1.42;white-space:pre-wrap;word-wrap:break-word;box-shadow:0 8px 20px -16px rgba(40,30,20,.4)}
    .cv-m .who{font-size:11px;font-weight:700;margin-bottom:2px;opacity:.75}
    .cv-m .tm{font-size:10.5px;opacity:.6;text-align:right;margin-top:3px}
    .cv-m.cliente{align-self:flex-start;background:var(--float);border-bottom-left-radius:6px}
    .cv-m.persona{align-self:flex-end;background:var(--pine);color:var(--on-pine);border-bottom-right-radius:6px}
    .cv-m.meta_ai{align-self:flex-end;background:var(--ink);color:var(--on-ink);border-bottom-right-radius:6px}
    .cv-m.sistema,.cv-m.auto{align-self:flex-end;background:var(--butter);color:var(--on-butter);border-bottom-right-radius:6px}
    .cv-m.handoff{box-shadow:0 0 0 2px var(--tomato)}
    .cv-m a{text-decoration:underline;text-underline-offset:2px}
    .cv-m img.media{max-width:260px;max-height:260px;border-radius:14px;display:block;margin:4px 0;cursor:zoom-in}
    .cv-m img.sticker{max-width:110px}
    .cv-m audio,.cv-m video{max-width:260px;display:block;margin:4px 0}
    .cv-mark{display:flex;gap:5px;margin-top:6px;white-space:normal}
    .cv-mark button{font-size:11px;font-weight:700;padding:4px 10px;border-radius:999px;border:0;background:var(--well);cursor:pointer}
    .cv-mark button.on{background:var(--pine);color:var(--on-pine)}
    .cv-box{margin:10px 14px 14px;padding:6px;display:flex;gap:6px;align-items:flex-end;position:relative;background:var(--glass-2);border:1px solid var(--line);border-radius:26px}
    .cv-box textarea{flex:1;resize:none;min-height:40px;max-height:160px;border:0;background:transparent;outline:0;padding:10px 6px;font-size:14px}
    .cv-box .ibtn{flex:none}
    .send{width:42px;height:42px;border-radius:50%;border:0;background:var(--ink);color:var(--on-ink);display:grid;place-items:center;cursor:pointer;font-size:16px;flex:none}
    .cv-qr{position:absolute;bottom:60px;left:6px;width:320px;max-height:330px;overflow:auto;background:var(--float);border-radius:20px;box-shadow:var(--shadow-pop);display:none;z-index:20;padding:6px}
    .cv-qr.open{display:block}
    .cv-qr div{padding:10px 12px;border-radius:14px;cursor:pointer;font-size:13px;font-weight:600}
    .cv-qr div:hover{background:var(--well)}
    .cv-qr div small{display:block;color:var(--muted);font-size:11.5px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

    /* Panel de datos */
    .cv-info{overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;font-size:13px}
    .prof{text-align:center;padding:6px 0 4px}
    .prof .ring{width:96px;height:96px;margin:0 auto 10px;border-radius:50%;padding:5px;background:conic-gradient(var(--c,var(--pine)) calc(var(--p,100)*1%),var(--well) 0)}
    .prof .ring .av{width:100%;height:100%;font-size:28px}
    .prof b{display:block;font-size:18px;font-weight:700;letter-spacing:-.01em}
    .prof .sub{color:var(--muted);font-size:12.5px;margin-top:2px}
    .prof .chips{display:flex;gap:5px;justify-content:center;flex-wrap:wrap;margin-top:8px}
    .prof .acts{display:flex;gap:6px;justify-content:center;margin-top:12px}
    .well{background:var(--well);border-radius:20px;padding:12px 14px}
    .cv-info h6{margin:0 0 8px;font-size:11px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);font-weight:700}
    .cv-info .row1{display:flex;justify-content:space-between;gap:8px;padding:4px 0}
    .cv-info .row1 span:first-child{color:var(--muted)}
    .cv-steps{display:flex;flex-direction:column;gap:6px}
    .cv-steps div{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
    .cv-back,.cv-infobtn{display:none}

    /* Controles comunes (usados también por el código de la bandeja) */
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:36px;padding:0 14px;border-radius:999px;border:1px solid var(--line);background:var(--glass-2);font-weight:600;font-size:12.5px;cursor:pointer;text-decoration:none;transition:background .2s,transform .15s;white-space:nowrap}
    .btn:hover{background:var(--glass-3)}
    .btn:disabled{opacity:.55;cursor:default}
    .btn-sm{height:32px;padding:0 12px;font-size:12px}
    .btn-p{background:var(--ink);color:var(--on-ink);border-color:transparent}.btn-p:hover{background:var(--ink);transform:translateY(-1px)}
    .btn-g{background:var(--glass-2)}
    .cv-info .btn{width:100%;margin-top:6px}
    .fc,.fs{width:100%;border:1px solid var(--line);background:var(--glass-2);border-radius:14px;padding:9px 12px;font-size:13px;outline:0}
    .fc:focus,.fs:focus{border-color:var(--line-2);background:var(--glass-3)}
    textarea.fc{resize:vertical}
    .fg{margin-bottom:10px}.fl{display:block;font-size:12px;font-weight:600;color:var(--muted);margin-bottom:4px}
    .text-muted{color:var(--muted)}
    .cv-dd{position:relative;display:inline-block}
    .cv-dd .menu{display:none;position:absolute;right:0;top:115%;min-width:230px;background:var(--float);border-radius:18px;box-shadow:var(--shadow-pop);z-index:30;padding:6px}
    .cv-dd.open .menu{display:block}
    .cv-dd .menu button{display:block;width:100%;text-align:left;background:none;border:0;padding:9px 12px;border-radius:12px;font-size:13px;cursor:pointer}
    .cv-dd .menu button:hover{background:var(--well)}
    .cv-dd .menu .danger{color:var(--bad)}
    .cv-res{max-height:240px;overflow:auto;margin-top:8px;display:flex;flex-direction:column;gap:2px}
    .cv-res div{padding:9px 12px;border-radius:14px;cursor:pointer;font-size:13px}
    .cv-res div:hover{background:var(--well)}.cv-res div.on{background:rgba(47,92,80,.14)}
    .cv-qe{background:var(--well);border-radius:18px;padding:10px;margin-bottom:8px}
    /* Ventanas (modales) */
    .mo{position:fixed;inset:0;z-index:100;background:rgba(20,18,15,.35);backdrop-filter:blur(6px);display:none;align-items:center;justify-content:center;padding:16px}
    .mo.show{display:flex}
    .mb{width:100%;background:var(--solid);border-radius:28px;box-shadow:var(--shadow-pop);max-height:calc(100vh - 32px);display:flex;flex-direction:column;overflow:hidden}
    .mh{display:flex;justify-content:space-between;align-items:center;padding:18px 20px 6px}
    .mt{font-size:18px;font-weight:700;letter-spacing:-.01em;display:flex;gap:8px;align-items:center}
    .mc{width:36px;height:36px;border-radius:50%;border:1px solid var(--line);background:var(--glass-2);cursor:pointer;font-size:18px}
    .mbody{padding:10px 20px;overflow:auto}
    .mf{display:flex;justify-content:flex-end;gap:8px;padding:12px 20px 18px}
    .pp-sub{color:var(--muted)}
    ::-webkit-scrollbar{width:8px;height:8px}::-webkit-scrollbar-thumb{background:var(--line-2);border-radius:8px}::-webkit-scrollbar-track{background:transparent}

    /* Entrada suave */
    @media (prefers-reduced-motion: no-preference){
      .rise{animation:rise .6s var(--ease) both}
      .rise.d1{animation-delay:.06s}.rise.d2{animation-delay:.12s}.rise.d3{animation-delay:.18s}
      @keyframes rise{from{transform:translateY(12px)}to{transform:none}}
      .cv-m{animation:pop .35s var(--ease) both}
      @keyframes pop{from{transform:translateY(6px) scale(.98)}to{transform:none}}
    }


    /* ── Vistas: Resumen · Tablero · Bandeja ───────────────────────────────── */
    .seg{display:flex;gap:2px;background:var(--well);padding:4px;border-radius:999px}
    .seg button{border:0;background:transparent;padding:8px 16px;border-radius:999px;font-weight:600;font-size:13px;color:var(--muted);cursor:pointer;display:flex;gap:6px;align-items:center;transition:background .2s,color .2s}
    .seg button:hover{color:var(--text)}
    .seg button.on{background:var(--float);color:var(--text);box-shadow:0 1px 3px rgba(0,0,0,.08)}
    [data-theme="dark"] .seg button.on{background:rgba(255,255,255,.17)}
    .hright{margin-left:auto;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .view{flex:1;min-height:0;display:none}
    .view.on{display:flex;flex-direction:column}
    #vResumen,#vTablero{overflow:auto;margin:0 -8px;padding:0 8px 8px}

    /* Resumen */
    .ov{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:16px;align-content:start}
    .ov .card{padding:18px 20px;min-width:0}
    .ch{display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap}
    .seg button{white-space:nowrap}
    .ch h3{margin:0;font-size:15px;font-weight:600;flex:1}
    .ch .hint{font-size:12px;color:var(--muted)}
    .cbtn{width:36px;height:36px;border-radius:50%;border:1px solid var(--line);background:var(--glass-2);display:grid;place-items:center;cursor:pointer;font-size:14px;color:inherit;text-decoration:none;flex:none}
    .cbtn:hover{background:var(--glass-3)}
    .big{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
    .big b{font-size:clamp(30px,3vw,42px);font-weight:600;letter-spacing:-.03em;line-height:1}
    .big span{font-size:12.5px;color:var(--muted)}
    .big span b{font-size:inherit;letter-spacing:0;font-weight:700;color:var(--text);line-height:inherit}
    .legend{display:flex;gap:16px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin:10px 0 2px}
    .legend i{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px;vertical-align:0}
    .legend i.ln{width:16px;height:0;border-radius:0;border-top:2px dashed var(--text);vertical-align:3px}
    .chart{position:relative;width:100%}
    .chart svg{display:block;overflow:visible}
    .chart text{font-family:var(--font);font-size:11px;font-weight:600;fill:var(--faint)}
    .ctip{position:absolute;pointer-events:none;background:var(--float);color:var(--text);border-radius:14px;padding:8px 11px;font-size:12px;box-shadow:var(--shadow-pop);white-space:nowrap;transform:translate(-50%,-100%);display:none;z-index:5}
    .ctip b{display:block;margin-bottom:2px}
    .c-msgs{grid-column:span 7}
    .c-hot{grid-column:span 5;grid-row:span 2;display:flex;flex-direction:column}
    .c-reply{grid-column:span 3}
    .c-mix{grid-column:span 4}
    .c-who,.c-funnel,.c-act{grid-column:span 4}
    .c-hours{grid-column:span 7}.c-new{grid-column:span 5}
    .hotg{flex:1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:1fr;gap:12px}
    .tile{border-radius:var(--r-tile);padding:14px 16px;display:flex;flex-direction:column;cursor:pointer;min-height:150px;transition:transform .2s var(--ease),box-shadow .2s;position:relative;overflow:hidden;text-align:left;border:0;font:inherit}
    .tile:hover{transform:translateY(-2px);box-shadow:0 18px 30px -18px rgba(0,0,0,.45)}
    .tile .tt{font-size:11.5px;opacity:.75;display:flex;justify-content:space-between;gap:6px;align-items:center}
    .tile .nm{font-size:17px;font-weight:600;letter-spacing:-.01em;margin-top:8px;line-height:1.2;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
    .tile .sb{font-size:12px;opacity:.72;margin-top:3px}
    .tile .pv{font-size:12.5px;opacity:.85;margin-top:auto;padding-top:10px;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;line-height:1.35}
    .tile .ft{display:flex;justify-content:space-between;align-items:flex-end;gap:8px;margin-top:10px}
    .tile .ft b{font-size:20px;font-weight:600;letter-spacing:-.02em}
    .tile .ft small{display:block;font-size:11px;opacity:.75}
    .tile .av{width:34px;height:34px;font-size:12px;box-shadow:0 0 0 2px rgba(255,255,255,.25)}
    .t-ink{background:#17191a;color:#fbf8f2}.t-tomato{background:var(--tomato);color:var(--on-tomato)}.t-pine{background:var(--pine);color:var(--on-pine)}.t-butter{background:var(--butter);color:var(--on-butter)}
    .t-glass{background:var(--glass-2);color:var(--text);border:1px solid var(--line)}
    [data-theme="dark"] .t-ink{background:#2a2f2c}
    .dots{width:28px;height:28px;border-radius:50%;border:1px solid currentColor;opacity:.55;display:grid;place-items:center;font-size:12px;flex:none}
    .hot-empty{grid-column:1/-1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--muted);text-align:center;gap:6px;min-height:200px}
    .c-reply{background:var(--pine);color:var(--on-pine);border-color:transparent}
    .c-reply .cbtn{border-color:rgba(255,255,255,.3);background:rgba(255,255,255,.08)}
    .ring2{display:grid;place-items:center;margin:4px auto 10px;position:relative;width:150px;height:150px}
    .ring2 .rv{position:absolute;text-align:center}
    .ring2 .rv b{display:block;font-size:34px;font-weight:600;letter-spacing:-.03em;line-height:1}
    .ring2 .rv small{font-size:11.5px;opacity:.8}
    .trio{display:grid;grid-template-columns:repeat(3,1fr);text-align:center;gap:6px}
    .trio small{display:block;font-size:11px;opacity:.75}
    .trio b{font-size:16px;font-weight:700}
    .strip{margin-top:12px;background:rgba(255,255,255,.1);border-radius:14px;padding:9px 12px;font-size:12.5px;text-align:center}
    .mixbar{display:flex;gap:6px;height:42px;margin:12px 0 14px}
    .mixbar span{border-radius:12px;min-width:10px;transition:flex .5s var(--ease)}
    .mrow{display:flex;align-items:center;gap:10px;padding:9px 2px;border-top:1px solid var(--line);font-size:13px;cursor:pointer}
    .mrow:first-of-type{border-top:0}
    .mrow:hover{color:var(--text);background:var(--well);border-radius:12px}
    .mrow i.d{width:9px;height:9px;border-radius:50%;flex:none}
    .mrow .l{flex:1}.mrow .n{font-weight:700;width:40px;text-align:right}.mrow .p{color:var(--muted);width:44px;text-align:right}
    .lb{display:flex;flex-direction:column;gap:4px}
    .lb .it{display:grid;grid-template-columns:24px 1fr auto;gap:4px 10px;align-items:center;padding:9px 10px;border-radius:16px}
    .lb .it:first-child{background:var(--glass-3);box-shadow:0 8px 20px -16px rgba(40,30,20,.35)}
    .lb .rk{color:var(--muted);font-weight:700;text-align:center;grid-row:span 2}
    .lb .nm{font-weight:600;font-size:13.5px}
    .lb .vl{font-weight:700;font-size:13.5px;text-align:right}
    .lb .bar{grid-column:2/4;height:5px;border-radius:5px;background:var(--well);overflow:hidden}
    .lb .bar i{display:block;height:100%;border-radius:5px;background:var(--ink)}
    .lb .it:first-child .bar i{background:var(--tomato)}
    .lb .sub{grid-column:2/4;font-size:11.5px;color:var(--muted);margin-top:-2px}
    .act{display:flex;flex-direction:column}
    .act .it{display:flex;gap:10px;padding:9px 2px;border-top:1px solid var(--line);cursor:pointer;align-items:flex-start}
    .act .it:first-child{border-top:0}
    .act .it:hover .who2{text-decoration:underline}
    .act .av{width:32px;height:32px;font-size:11.5px}
    .act .tx{flex:1;min-width:0;font-size:12.5px;line-height:1.35}
    .act .tx .q{color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .act .tx small{color:var(--faint);font-size:11px}
    .act .ic2{color:var(--faint);font-size:13px}
    .lost{margin-top:10px;font-size:12px;color:var(--muted)}
    .empty2{color:var(--muted);font-size:13px;padding:18px 0;text-align:center}


    /* Tarjetas de "Esperan respuesta" */
    .tile .av{background:rgba(255,255,255,.2)!important;color:inherit!important}
    .t-butter .av,.t-glass .av{background:rgba(23,25,26,.12)!important}
    .hc{cursor:pointer;min-height:340px;gap:0}
    .hc .tt{gap:8px}
    .hc .why{font-weight:700;opacity:1;font-size:11.5px;background:rgba(255,255,255,.16);padding:3px 9px;border-radius:999px}
    .t-butter .hc .why,.hc.t-butter .why{background:rgba(23,25,26,.1)}
    .wp{font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;background:rgba(255,255,255,.14)}
    .hc.t-butter .wp{background:rgba(23,25,26,.1)}
    .wp.g{background:#2f7a52;color:#fff}.wp.y{background:#f2c94c;color:#17191a}.wp.r{background:#fbf8f2;color:#c8431f}
    .hc.t-tomato .wp.r{background:#fbf8f2;color:#c8431f}.hc.t-butter .wp.y{background:#17191a;color:#f2c94c}
    .hc .hh{display:flex;gap:10px;align-items:center;margin-top:10px}
    .hc .hh .nm{margin-top:0;-webkit-line-clamp:1}
    .hc .hh .av{width:38px;height:38px;font-size:13px;flex:none}
    .kds{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px}
    .kd{font-size:11px;font-weight:700;padding:3px 8px;border-radius:999px;background:rgba(255,255,255,.13);white-space:nowrap}
    .hc.t-butter .kd{background:rgba(23,25,26,.08)}
    .kd.ok{background:#2f7a52;color:#fff}.kd.warn{background:#f2c94c;color:#17191a}.kd.bad{background:#fbf8f2;color:#c8431f}
    .hc.t-butter .kd.warn{background:#17191a;color:#f2c94c}
    .mini{flex:1;min-height:120px;max-height:190px;overflow-y:auto;margin-top:10px;display:flex;flex-direction:column;gap:5px;padding:8px;border-radius:14px;background:rgba(0,0,0,.14);cursor:default;scrollbar-width:thin}
    .hc.t-butter .mini{background:rgba(23,25,26,.07)}
    .mm{max-width:88%;font-size:12px;line-height:1.35;padding:6px 9px 4px;border-radius:12px;white-space:pre-wrap;word-wrap:break-word;overflow-wrap:anywhere}
    .mm.in{align-self:flex-start;background:rgba(255,255,255,.16);border-bottom-left-radius:4px}
    .mm.out{align-self:flex-end;background:rgba(255,255,255,.3);border-bottom-right-radius:4px}
    .hc.t-butter .mm.in{background:rgba(255,255,255,.55)}.hc.t-butter .mm.out{background:rgba(23,25,26,.12)}
    .mm b{display:block;font-size:10px;opacity:.75;margin-bottom:1px}
    .mm small{display:block;text-align:right;font-size:9.5px;opacity:.6;margin-top:1px}
    .hacts{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px;align-items:center}
    .hacts button{border:1px solid rgba(255,255,255,.35);background:transparent;color:inherit;border-radius:999px;padding:6px 11px;font-size:11.5px;font-weight:700;cursor:pointer}
    .hacts button:hover{background:rgba(255,255,255,.14)}
    .hacts button.pri{margin-left:auto;background:#fbf8f2;color:#17191a;border-color:transparent}
    .hc.t-butter .hacts button{border-color:rgba(23,25,26,.3)}.hc.t-butter .hacts button.pri{background:#17191a;color:#fbf8f2}
    .hacts .by{font-size:11.5px;opacity:.8}


    /* Mensajes sin leer y horarios en las tarjetas */
    .unb{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:800;background:var(--tomato);color:var(--on-tomato);border-radius:999px;padding:2px 8px;margin-left:4px;animation:unbIn .35s var(--ease)}
    .cv-tab .unb{font-size:10px;padding:1px 6px;margin-left:5px}
    @keyframes unbIn{from{transform:scale(.6)}to{transform:none}}
    .bside .unb{margin:2px 0 0}
    .tile.unr{box-shadow:0 0 0 2px var(--tomato),0 14px 26px -16px rgba(0,0,0,.5)}
    .tile.unr::after{content:"";position:absolute;top:12px;right:46px;width:9px;height:9px;border-radius:50%;background:var(--tomato);box-shadow:0 0 0 2px rgba(255,255,255,.9)}
    .tile.t-tomato.unr{box-shadow:0 0 0 2px #fbf8f2,0 14px 26px -16px rgba(0,0,0,.5)}
    .tile.t-tomato.unr::after{background:#fbf8f2}
    .cv-item.unr .t span:first-child{font-weight:800}
    .cv-item.unr .t span:first-child::before{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--tomato);margin-right:6px;vertical-align:1px}
    .lt{display:flex;gap:10px;flex-wrap:wrap;font-size:11px;opacity:.78;margin-top:6px;font-weight:600}
    .lt i{font-size:10px;margin-right:2px}
    .cv-item .lt{color:var(--muted);opacity:1;margin-top:2px}


    /* Mover tarjetas */
    .tile[draggable="true"]{cursor:grab}
    .tile.dragging{opacity:.45;transform:scale(.97)}
    .board.is-dragging [data-drop]{transition:box-shadow .15s,background .15s}
    .board.is-dragging [data-drop].drop-on{box-shadow:0 0 0 3px var(--ink) inset;background:var(--glass-2)}
    .board.is-dragging .bcol:not(.drop-on) .bcards{opacity:.85}
    .tile .dots{cursor:pointer;opacity:.75}
    .tile .dots:hover{opacity:1;background:rgba(255,255,255,.15)}
    .mv-menu{position:fixed;z-index:200;width:220px;background:var(--float);color:var(--text);border-radius:18px;box-shadow:var(--shadow-pop);padding:6px;font-size:13px}
    .mv-menu .mv-h{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);padding:6px 10px 4px}
    .mv-menu button{display:flex;gap:8px;align-items:center;width:100%;text-align:left;border:0;background:none;padding:9px 10px;border-radius:12px;cursor:pointer;font:inherit;color:inherit}
    .mv-menu button:hover{background:var(--well)}
    .mv-menu .mv-sep{height:1px;background:var(--line);margin:4px 6px}

    /* Tablero */
    .bfil{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:14px}
    .bfil .search{width:min(300px,100%);height:40px}
    .pchip{border:1px solid var(--line);background:var(--glass-2);border-radius:999px;padding:7px 13px;font-size:12.5px;font-weight:600;cursor:pointer;color:inherit}
    .pchip:hover{background:var(--glass-3)}.pchip.on{background:var(--ink);color:var(--on-ink);border-color:transparent}
    .board{flex:1;min-height:0;display:grid;grid-template-columns:repeat(5,minmax(230px,1fr)) 112px;gap:14px;overflow-x:auto;padding-bottom:6px}
    .bcol{display:flex;flex-direction:column;min-height:0;padding:12px 10px 10px;max-height:100%}
    .bcol .bh{display:flex;align-items:center;gap:8px;padding:2px 6px 10px;font-weight:600;font-size:14px}
    .bcol .bh i.d{width:10px;height:10px;border-radius:50%}
    .bcol .bh .n{font-size:11px;font-weight:700;background:var(--well);border-radius:999px;padding:2px 8px;color:var(--muted)}
    .bcol .bh .x{margin-left:auto;font-size:12px;color:var(--muted);font-weight:600}
    .bcards{overflow-y:auto;display:flex;flex-direction:column;gap:10px;padding:2px 2px 4px;min-height:60px;-webkit-mask-image:linear-gradient(to bottom,#000 calc(100% - 26px),transparent);mask-image:linear-gradient(to bottom,#000 calc(100% - 26px),transparent)}
    .bcards .tile{min-height:0;flex:none}
    .bcards .tile .pv{margin-top:8px;padding-top:0}
    .tchips{display:flex;gap:4px;flex-wrap:wrap}
    .tchips span{font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:999px;background:rgba(255,255,255,.18)}
    .t-butter .tchips span,.t-glass .tchips span{background:rgba(23,25,26,.09)}
    .tchips span.u{background:#fbf8f2;color:#17191a}
    .t-glass .tchips span.u,.t-butter .tchips span.u{background:var(--ink);color:var(--on-ink)}
    .bside{display:flex;flex-direction:column;gap:14px}
    .bside .card{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:6px;padding:14px 8px;cursor:pointer;border-style:dashed}
    .bside .card:hover{background:var(--glass-2)}
    .bside .bi2{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;font-size:18px}
    .bside b{font-size:14px}.bside small{font-size:11.5px;color:var(--muted)}

    @media (max-width:1280px){
      .c-msgs{grid-column:span 12}.c-hot{grid-column:span 12;grid-row:auto}
      .c-reply{grid-column:span 5}.c-mix{grid-column:span 7}
      .c-who,.c-funnel{grid-column:span 6}.c-act{grid-column:span 12}
      .c-hours,.c-new{grid-column:span 12}
    }
    @media (max-width:860px){
      .ov{grid-template-columns:1fr}.ov .card{grid-column:1/-1!important}
      .hotg{grid-template-columns:1fr;grid-auto-rows:auto}
      .board{grid-template-columns:repeat(5,82vw) 110px;scroll-snap-type:x mandatory}.bcol{scroll-snap-align:start;max-height:72vh}
      .hright{margin-left:0;width:100%}.seg{flex:1}.seg button{flex:1;justify-content:center;padding:8px 6px}
      #vResumen,#vTablero{overflow:visible}
      .view.on{flex:none}
    }

    /* Pantallas medianas y celular */
    @media (max-width:1280px){
      .cv-wrap{grid-template-columns:minmax(290px,340px) 1fr}
      .cv-info-pane{display:none}
      .cv-wrap.info .cv-info-pane{display:flex;position:fixed;right:16px;top:86px;bottom:16px;width:min(360px,92vw);z-index:50;background:var(--solid);box-shadow:var(--shadow-pop)}
      .cv-infobtn{display:inline-flex}
      .hours{display:none}
    }
    @media (max-width:860px){
      body{overflow:auto}
      .app{padding:12px 12px 86px;height:auto;min-height:100%}
      .brand{margin-left:0;min-width:0}.brand span{display:none}
      .nav{justify-content:flex-start}
      .dock{top:auto;bottom:12px;left:50%;transform:translateX(-50%);flex-direction:row;padding:6px}
      .dock .sep{width:1px;height:auto;margin:8px 4px}
      .dock [data-tip]:hover::after{display:none}
      .head{gap:14px}.stats{gap:16px}.st .ic{display:none}
      .cv-wrap{grid-template-columns:1fr;height:calc(100vh - 210px)}
      .cv-wrap.chat .cv-left{display:none}
      .cv-wrap:not(.chat) .cv-right{display:none}
      .cv-back{display:inline-flex}
      .cv-m{max-width:88%}
    }
  </style>
</head>
<body>

<%- include('partials/v2shell') %>

<div class="app">

  <section class="head rise">
    <h1>Conversaciones</h1>
    <div class="stats">
      <div class="st"><span class="ic"><i class="bi bi-hourglass-split"></i></span><div><b><span id="stPa">–</span> <span class="badge tomato" id="stPaB" style="display:none"></span></b><small>Por atender</small></div></div>
      <div class="st"><span class="ic"><i class="bi bi-fire"></i></span><div><b><span id="stVe">–</span> <span class="badge tomato" id="stHot" style="display:none"></span></b><small>Interesados en ventas</small></div></div>
      <div class="st"><span class="ic"><i class="bi bi-tools"></i></span><div><b id="stSo">–</b><small>Soporte técnico</small></div></div>
    </div>
    <div class="hright">
      <div class="seg" id="viewSeg">
        <button data-v="resumen"><i class="bi bi-grid-1x2"></i> Resumen</button>
        <button data-v="tablero"><i class="bi bi-kanban"></i> Tablero</button>
        <button data-v="bandeja"><i class="bi bi-chat-left-text"></i> Bandeja</button>
      </div>
      <a class="cbtn" href="/admin/conversations/clasico<%= selected ? '?c=' + selected : '' %>" title="Abrir la bandeja con el diseño anterior"><i class="bi bi-layout-text-window-reverse"></i></a>
    </div>
  </section>

  <% if (msg) { %><div class="well" style="margin-bottom:12px" data-flash="1"><%= msg.text %></div><% } %>

  <div class="view" id="vResumen">
    <div class="ov">
      <div class="card c-msgs rise">
        <div class="ch"><h3>Mensajes de clientes</h3>
          <div class="seg" id="rngSeg" style="padding:3px"><button data-d="7" style="padding:6px 12px">7 días</button><button data-d="30" class="on" style="padding:6px 12px">30 días</button><button data-d="90" style="padding:6px 12px">90 días</button></div>
        </div>
        <div class="big"><b id="ovIn">–</b><span id="ovInSub"></span></div>
        <div class="legend"><span><i style="background:var(--tomato)"></i>Recibidos</span><span><i style="background:var(--ink)"></i>Respuestas de la oficina</span><span><i class="ln"></i>Respuestas de Meta AI</span></div>
        <div class="chart" id="chMsgs" style="height:230px"></div>
      </div>
      <div class="card c-hot rise d1">
        <div class="ch"><h3 id="hotTitle">Esperan respuesta</h3><span class="hint" id="hotHint"></span><button class="cbtn" title="Ver el tablero" onclick="setView('tablero')"><i class="bi bi-arrow-up-right"></i></button></div>
        <div class="hotg" id="ovHot"><div class="hot-empty">Cargando…</div></div>
      </div>
      <div class="card c-reply rise d1">
        <div class="ch"><h3>Tiempo de respuesta</h3><span class="cbtn" title="Desde que el contacto escribe hasta la primera respuesta (de una persona o de Meta AI)"><i class="bi bi-info-lg"></i></span></div>
        <div class="ring2" id="ovRing"></div>
        <div class="trio"><div><small>Meta AI</small><b id="ovMeta">–</b></div><div><small>Oficina</small><b id="ovPers">–</b></div><div><small>Consultas</small><b id="ovN">–</b></div></div>
        <div class="strip" id="ovStrip">–</div>
      </div>
      <div class="card c-mix rise d2">
        <div class="ch"><h3>Bandejas activas</h3><span class="hint">tocá una para abrirla</span></div>
        <div class="big"><b id="ovAct">–</b><span>conversaciones abiertas</span></div>
        <div class="mixbar" id="ovMixBar"></div>
        <div id="ovMix"></div>
      </div>
      <div class="card c-who rise d2">
        <div class="ch"><h3>Quién responde</h3><span class="hint" id="whoHint"></span></div>
        <div class="lb" id="ovWho"></div>
      </div>
      <div class="card c-funnel rise d2">
        <div class="ch"><h3>Embudo de ventas</h3><span class="hint" id="funHint"></span><button class="cbtn" title="Ver ventas" onclick="openInbox('ventas')"><i class="bi bi-arrow-up-right"></i></button></div>
        <div class="lb" id="ovFunnel"></div>
        <div class="lost" id="ovLost"></div>
      </div>
      <div class="card c-act rise d3">
        <div class="ch"><h3>Actividad reciente</h3><button class="cbtn" title="Ir a la bandeja" onclick="setView('bandeja')"><i class="bi bi-arrow-up-right"></i></button></div>
        <div class="act" id="ovAct2"></div>
      </div>
      <div class="card c-hours rise d3">
        <div class="ch"><h3>A qué hora escriben</h3><span class="hint" id="hrHint"></span></div>
        <div class="chart" id="chHours" style="height:170px"></div>
      </div>
      <div class="card c-new rise d3">
        <div class="ch"><h3>Contactos nuevos</h3><span class="hint" id="newHint"></span></div>
        <div class="chart" id="chNew" style="height:170px"></div>
      </div>
    </div>
  </div>

  <div class="view" id="vTablero">
    <div class="bfil">
      <label class="search"><i class="bi bi-search" style="color:var(--faint)"></i><input id="bdQ" placeholder="Buscar en el tablero…" autocomplete="off"></label>
      <button class="pchip on" data-m="">Todos los motivos</button>
      <% Object.keys(motives).filter(function(k){ return k !== 'otro'; }).forEach(function(k){ %><button class="pchip" data-m="<%= k %>"><%= motives[k] %></button><% }) %>
    </div>
    <div class="board" id="board"></div>
  </div>

  <div class="view" id="vBandeja">
  <div class="cv-wrap" id="cvWrap">
    <div class="card cv-pane cv-left rise d1">
      <div class="cv-tools">
        <label class="search"><i class="bi bi-search" style="color:var(--faint)"></i><input id="cvQ" placeholder="Buscar nombre, teléfono, etiqueta o texto…" autocomplete="off"></label>
        <% var PRIMARY = { por_atender: 'Por atender', ventas: 'Ventas', soporte: 'Soporte', pagos: 'Pagos', clientes: 'Clientes' }; %>
        <div class="cv-tabs" id="cvTabs">
          <% Object.keys(PRIMARY).filter(function(k){ return inboxes[k]; }).forEach(function(k, i){ %>
            <button class="cv-tab<%= i === 0 ? ' on' : '' %>" data-f="<%= k %>" title="<%= inboxes[k] %>"><%= PRIMARY[k] %><span class="n" data-n="<%= k %>"></span></button>
          <% }) %>
        </div>
        <div class="row-tools">
          <button class="tbtn" onclick="cvSync(false, this)" title="Buscar mensajes nuevos"><i class="bi bi-arrow-repeat"></i></button>
          <% if (isAdmin) { %><button class="tbtn" onclick="qeOpen()" title="Respuestas rápidas"><i class="bi bi-lightning-charge"></i></button><button class="tbtn" onclick="cvSync(true, this)" title="Traer todo el historial"><i class="bi bi-cloud-download"></i></button><% } %>
          <button class="tbtn" id="selBtn" onclick="selToggle()" title="Elegir varias"><i class="bi bi-check2-square"></i></button>
          <select id="cvMore" title="Otras bandejas">
            <option value="">Más bandejas…</option>
            <% Object.keys(inboxes).filter(function(k){ return !PRIMARY[k]; }).forEach(function(k){ %><option value="<%= k %>" data-label="<%= inboxes[k] %>"><%= inboxes[k] %></option><% }) %>
          </select>
          <select id="cvMot">
            <option value="">Todos los motivos</option>
            <% Object.keys(motives).forEach(function(k){ %><option value="<%= k %>"><%= motives[k] %></option><% }) %>
          </select>
        </div>
        <div class="text-muted" style="font-size:11.5px;padding:0 4px"><i class="bi bi-clock"></i> Atención humana <b><%= hours %></b> · aviso a los <b><%= alertMinutes %> min</b><%= inHours ? '' : ' · fuera de horario' %></div>
      </div>
      <div class="cv-bulk" id="cvBulk">
        <b id="selN">0</b> elegidas ·
        <select class="fs" id="selReason" style="width:auto;padding:5px 10px;font-size:12px"><% Object.keys(ignoreReasons).forEach(function(k){ %><option value="<%= k %>"><%= ignoreReasons[k] %></option><% }) %></select>
        <button class="btn btn-sm" data-bulk="ignore"><i class="bi bi-eye-slash"></i> Ocultar</button>
        <% if (isAdmin) { %><button class="btn btn-sm" data-bulk="unignore"><i class="bi bi-eye"></i> Restaurar</button>
        <button class="btn btn-sm" style="color:var(--bad)" data-bulk="clear" title="Borra los mensajes; el chat queda"><i class="bi bi-eraser"></i> Vaciar</button>
        <button class="btn btn-sm" style="color:var(--bad)" data-bulk="remove" title="Borra el chat entero del sistema"><i class="bi bi-trash"></i> Borrar</button><% } %>
      </div>
      <div class="cv-list" id="cvList"><div class="cv-empty">Cargando…</div></div>
    </div>

    <div class="card cv-pane cv-right rise d2" id="cvRight">
      <div class="cv-empty" id="cvNone"><div><i class="bi bi-chat-heart" style="font-size:34px;color:var(--faint)"></i><div style="margin-top:8px">Elegí una conversación de la lista.</div></div></div>
      <div id="cvChat" style="display:none;flex-direction:column;flex:1;min-height:0">
        <div class="cv-head">
          <button class="ibtn cv-back" onclick="cvBack()"><i class="bi bi-arrow-left"></i></button>
          <div class="av int" id="cvAv"></div>
          <div class="who"><b id="cvName"></b><div id="cvSub"></div></div>
          <div class="cv-acts" id="cvActs"></div>
        </div>
        <div class="cv-msgs" id="cvMsgs"></div>
        <div class="cv-box">
          <div class="cv-qr" id="cvQr"></div>
          <button class="ibtn" onclick="qrToggle()" title="Respuestas rápidas"><i class="bi bi-lightning-charge"></i></button>
          <textarea id="cvText" rows="1" placeholder="Escribí una respuesta… (Ctrl+Enter para enviar)"></textarea>
          <button class="send" id="cvSend" onclick="cvSend()" title="Enviar"><i class="bi bi-send-fill"></i></button>
        </div>
      </div>
    </div>

    <div class="card cv-pane cv-info-pane rise d3">
      <div class="cv-info" id="cvInfo"><div class="cv-empty" style="padding:40px 10px">Elegí una conversación para ver sus datos.</div></div>
    </div>
  </div>
  </div>
</div>

<!-- Crear solicitud de instalación -->
<div class="mo" id="reqModal">
  <div class="mb" style="max-width:520px">
    <div class="mh"><span class="mt"><i class="bi bi-house-add"></i> Crear solicitud de instalación</span><button class="mc" onclick="closeMo('reqModal')">×</button></div>
    <div class="mbody">
      <div class="pp-sub" style="font-size:12.5px;margin-bottom:10px">Se carga como <b>Inscripto</b> con el WhatsApp de este chat. Si la persona ya está registrada, el sistema avisa. Las fotos marcadas como cédula y fachada se adjuntan a su ficha.</div>
      <div class="fg"><label class="fl">Nombre y apellido *</label><input class="fc" id="rqName" maxlength="120"></div>
      <div class="fg"><label class="fl">Cédula</label><input class="fc" id="rqNik" maxlength="30"><div id="rqNikHint" class="text-muted" style="font-size:11.5px;margin-top:3px"></div></div>
      <div class="fg"><label class="fl">Dirección / referencia *</label><input class="fc" id="rqAddr" maxlength="250"></div>
      <div class="fg"><label class="fl">Plan *</label><select class="fs" id="rqPkg"><% packages.forEach(function(p){ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></div>
      <div class="fg"><label class="fl">Ubicación</label><div id="rqLoc" class="text-muted" style="font-size:12.5px"></div></div>
      <div class="fg"><label class="fl">Notas</label><textarea class="fc" id="rqNotes" rows="2" maxlength="500"></textarea></div>
    </div>
    <div class="mf"><button class="btn" onclick="closeMo('reqModal')">Cancelar</button><button class="btn btn-p" id="rqBtn" onclick="rqSave()"><i class="bi bi-check2"></i> Crear solicitud</button></div>
  </div>
</div>

<!-- Vincular a cliente -->
