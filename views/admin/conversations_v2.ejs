        (o.notice ? '<div class="row1"><span>Último aviso</span><span>' + esc(o.notice.type) + ' · ' + esc(new Date(o.notice.ts).toLocaleDateString('es-PY')) + '</span></div>' : '') +
        (cu.status === 'inactive' ? '<div class="row1"><span>Solicitud</span><span>' + esc(cu.reg_status === 'approved' ? 'Instalación asignada' : 'Pendiente de aprobar') + '</span></div>' : '') +
