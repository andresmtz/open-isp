  function openConv(id){
    sel = id; lastId = 0;
    document.getElementById('cvWrap').classList.add('chat');
    document.getElementById('cvNone').style.display = 'none';
    document.getElementById('cvChat').style.display = 'flex';
    try { history.replaceState(null, '', '?c=' + id); } catch (_) {}
    document.querySelectorAll('.cv-item').forEach(function(x){ x.classList.toggle('on', Number(x.dataset.id) === id); });
    return api('/admin/conversations/' + id + '/messages').then(function(d){
      if (!d.ok) { toast(d.message || 'No se pudo abrir', true); return; }
      savedDocs = {}; (d.saved || []).forEach(function(x){ savedDocs[x.msg_id] = x.kind; });
      info = d.info; renderHead(d.conv); renderInfo(d.conv, d.info); appendMsgs(d.messages || [], true);
      if (d.conv.unread > 0) api('/admin/conversations/' + id + '/read', {}).then(loadList);
    });
  }
  var infoKey = '';
  var savedDocs = {};
  function poll(force){
    if (!sel || (document.hidden && !force)) return;
    return api('/admin/conversations/' + sel + '/messages?after=' + lastId).then(function(d){
      if (!d.ok) return;
      (d.saved || []).forEach(function(x){ savedDocs[x.msg_id] = x.kind; });
      info = d.info; renderHead(d.conv);
      var k = JSON.stringify([d.info, d.conv.motive, d.conv.lead_stage, d.conv.lost_reason, d.conv.cedula_msg, d.conv.fachada_msg, d.conv.lead_name, d.conv.customer_id]);
      var editing = document.activeElement && document.getElementById('cvInfo').contains(document.activeElement);
      if (force || (k !== infoKey && !editing)) { infoKey = k; renderInfo(d.conv, d.info); }
      if (d.messages && d.messages.length) { appendMsgs(d.messages, false); if (d.conv.unread > 0) api('/admin/conversations/' + sel + '/read', {}); }
      else paintMarks();
    });
  }

  function bulkCount(){ var n = Object.keys(picked).length; document.getElementById('selN').textContent = n; }
  window.selToggle = function(){
    selecting = !selecting; picked = {};
    document.getElementById('cvList').classList.toggle('selecting', selecting);
    document.getElementById('cvBulk').classList.toggle('open', selecting);
    document.getElementById('selBtn').classList.toggle('on', selecting);
    bulkCount(); loadList();
  };
  window.bulkDo = function(action, ids, reason){
    ids = ids || Object.keys(picked).map(Number);
    if (!ids.length) return toast('Elegí al menos una conversación', true);
    reason = reason || document.getElementById('selReason').value;
    var CONF = {
      clear: 'Se borran del sistema TODOS los mensajes de ' + ids.length + ' conversación(es). El chat queda en su bandeja con sus etiquetas y notas. En el celular no se borra nada. No se puede deshacer. ¿Continuar?',
      purge: 'Se borran del sistema TODOS los mensajes de ' + ids.length + ' conversación(es) y quedan ocultas (lo nuevo de esos números tampoco se guarda). En el celular no se borra nada. No se puede deshacer. ¿Continuar?',
      remove: 'Se borra del sistema el chat entero de ' + ids.length + ' conversación(es): mensajes, etiquetas, notas y etapa. Si el contacto vuelve a escribir, aparece como chat nuevo. En el celular no se borra nada. No se puede deshacer. ¿Continuar?'
    };
    if (CONF[action] && !confirm(CONF[action])) return;
    if (action === 'ignore' && ids.length > 1 && !confirm('¿Ocultar ' + ids.length + ' conversaciones como "' + (IGN[reason] || reason) + '"? Lo que manden esos números ya no se va a guardar.')) return;
    api('/admin/conversations/bulk', { ids: ids, action: action, reason: reason }).then(function(d){
      if (!d.ok) return toast(d.message, true);
      toast(d.message); picked = {}; bulkCount();
      var dd = document.getElementById('hideDd'); if (dd) dd.classList.remove('open');
      if (conv && ids.indexOf(conv.id) !== -1 && (action === 'remove' || (action !== 'unignore' && !IS_ADMIN))) { sel = 0; conv = null; document.getElementById('cvChat').style.display = 'none'; document.getElementById('cvNone').style.display = ''; }
      else if (conv && ids.indexOf(conv.id) !== -1) { if (action === 'purge' || action === 'clear') openConv(conv.id); else poll(true); }
      loadList();
    });
  };
  document.getElementById('cvBulk').addEventListener('click', function(e){ var b = e.target.closest('[data-bulk]'); if (b) bulkDo(b.dataset.bulk); });

  window.orgSet = function(f){
    if (!conv) return;
    api('/admin/conversations/' + conv.id + '/org', f).then(function(d){
      if (!d.ok) return toast(d.message, true);
      poll(true); loadList();
    });
  };
  window.cvBack = function(){ document.getElementById('cvWrap').classList.remove('chat'); };
  window.cvState = function(st){
    if (!conv) return;
    api('/admin/conversations/' + conv.id + '/state', { state: st }).then(function(d){
      if (!d.ok) return toast(d.message, true);
      poll(true); loadList();
    });
  };
  window.cvSaveSide = function(btn){
    if (!conv) return;
    btn.disabled = true;
    api('/admin/conversations/' + conv.id + '/update', { assigned_to: document.getElementById('cvAssigned').value, labels: document.getElementById('cvLabels').value, note: document.getElementById('cvNote').value })
      .then(function(d){ btn.disabled = false; if (!d.ok) return toast(d.message, true); toast('Guardado'); loadList(); });
  };
  window.cvSend = function(){
    var ta = document.getElementById('cvText'), t = ta.value.trim();
    if (!conv || !t) return;
    if (conv.customer_status === 'cancelled' && !confirm('Este cliente tiene el servicio cancelado. ¿Enviar igual la respuesta?')) return;
    var b = document.getElementById('cvSend'); b.disabled = true;
    api('/admin/conversations/' + conv.id + '/reply', { text: t }).then(function(d){
      b.disabled = false;
      if (!d.ok) return toast(d.message, true);
      ta.value = ''; ta.style.height = ''; poll(true); loadList();
    }).catch(function(){ b.disabled = false; toast('No se pudo enviar', true); });
  };
  window.cvSync = function(full, btn){
    if (full && !confirm('Traer todo el historial guardado en GoWA. Puede tardar un par de minutos. ¿Continuar?')) return;
    btn.disabled = true; var old = btn.innerHTML; btn.innerHTML = '<i class="bi bi-hourglass-split"></i>';
    fetch('/admin/conversations/sync' + (full ? '?full=1' : ''), { method: 'POST' }).then(function(r){ return r.json(); }).then(function(d){
      btn.disabled = false; btn.innerHTML = old;
      if (!d.ok) return toast(d.message || 'No se pudo', true);
      toast(full ? ('Historial: ' + (d.convs || 0) + ' conversaciones, ' + (d.msgs || 0) + ' mensajes nuevos') : ((d.nuevos || 0) + ' mensajes nuevos'));
      loadList(); if (sel) poll(true);
    }).catch(function(){ btn.disabled = false; btn.innerHTML = old; toast('No se pudo', true); });
  };

  // ── respuestas rápidas ──
  function loadQr(){ return api('/admin/conversations/quick-replies').then(function(d){ if (d.ok) { qr = d.items || []; window._qrRaw = d.raw; } }); }
  window.qrToggle = function(){
    var el = document.getElementById('cvQr');
    if (el.classList.contains('open')) { el.classList.remove('open'); return; }
    el.innerHTML = qr.length ? qr.map(function(r, i){ return '<div data-i="' + i + '"><b>' + esc(r.title) + '</b><small>' + esc(r.text.replace(/\s+/g, ' ').slice(0, 80)) + '</small></div>'; }).join('') : '<div>No hay respuestas rápidas.</div>';
    el.classList.add('open');
  };
  window.qrInsert = function(t){
    var r = qr.filter(function(x){ return x.title === t; })[0];
    if (!r) return toast('No existe la respuesta rápida "' + t + '"', true);
    var ta = document.getElementById('cvText'); ta.value = r.text; ta.dispatchEvent(new Event('input')); ta.focus();
  };
  document.getElementById('cvQr').addEventListener('click', function(e){
    var it = e.target.closest('[data-i]'); if (!it) return;
    var r = qr[Number(it.dataset.i)], ta = document.getElementById('cvText');
    ta.value = ta.value ? ta.value + '\n\n' + r.text : r.text;
    ta.dispatchEvent(new Event('input')); ta.focus();
    document.getElementById('cvQr').classList.remove('open');
  });

  // ── marcar fotos de cédula / fachada ──
  document.getElementById('cvMsgs').addEventListener('click', function(e){
    var sb = e.target.closest('.cv-save button');
    if (sb && conv) {
      var smid = Number(sb.closest('.cv-save').dataset.mid), kind = sb.dataset.kind;
      var what = kind === 'geo' ? 'la ubicación de la casa' : (kind === 'cedula' ? 'la cédula' : 'la foto del frente de la casa');
      if (!confirm('¿Guardar esto como ' + what + ' en la ficha del cliente?')) return;
      sb.disabled = true;
      api('/admin/conversations/' + conv.id + '/save-' + (kind === 'geo' ? 'geo' : 'doc'), { mid: smid, kind: kind }).then(function(d){
        toast(d.message || (d.ok ? 'Guardado' : 'Error'), !d.ok);
        if (d.ok) { savedDocs[smid] = kind; paintMarks(); } else sb.disabled = false;
      });
      return;
    }
    var b = e.target.closest('.cv-mark button'); if (!b || !conv) return;
    var mid = Number(b.closest('.cv-mark').dataset.mid), k = b.dataset.k, f = {};
    f[k] = Number(conv[k]) === mid ? '' : mid;
