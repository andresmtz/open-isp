        '</div>';
      if (o.suggest && o.suggest.length) h += '<div class="well" style="box-shadow:inset 0 0 0 1.5px var(--pine)"><h6 style="color:var(--pine)">¿Es cliente?</h6><div style="font-size:12.5px;margin-bottom:6px">El nombre de WhatsApp coincide con:</div>' +
        o.suggest.map(function(x){ return '<div style="display:flex;justify-content:space-between;gap:6px;align-items:center;padding:3px 0"><span><b>' + esc(x.name) + '</b> <span class="text-muted">' + esc(x.customer_code || '') + ' · ' + esc(CUST_ST[x.status] || x.status) + '</span></span><button class="btn btn-p btn-sm" style="width:auto;margin:0" onclick="lkQuick(' + x.id + ',\'' + esc(x.name).replace(/'/g, '') + '\')">Vincular</button></div>'; }).join('') + '</div>';
