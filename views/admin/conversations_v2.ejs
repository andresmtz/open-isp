    document.getElementById('ovPers').textContent = fmtMin(r.medPerson);
    document.getElementById('ovN').textContent = fmtN(r.n);
    var trend = (r.medPrev != null && r.medNow != null) ? (r.medNow <= r.medPrev ? 'Mejorando: ' : 'Más lento: ') + fmtMin(r.medPrev) + ' → ' + fmtMin(r.medNow) : '';
    document.getElementById('ovStrip').innerHTML = r.n ? 'Meta AI contestó primero en <b>' + Math.round(100 * r.byMeta / r.n) + '%</b> de las consultas' + (trend ? '<br><small style="opacity:.8">Mitad del período: ' + esc(trend) + '</small>' : '') : 'Sin consultas en el período';

    // bandejas
    var MIX = [{ k: 'por_atender', t: 'Por atender', c: 'var(--tomato)' }, { k: 'ventas', t: 'Ventas', c: 'var(--butter)' }, { k: 'soporte', t: 'Soporte técnico', c: 'var(--pine)' }, { k: 'pagos', t: 'Pagos y cobranza', c: 'var(--ink)' }, { k: 'clientes', t: 'Clientes', c: 'var(--faint)' }];
    var tot = MIX.reduce(function(a, m){ return a + (d.inboxes[m.k] || 0); }, 0);
    document.getElementById('ovAct').textContent = fmtN(tot);
    document.getElementById('ovMixBar').innerHTML = MIX.filter(function(m){ return d.inboxes[m.k]; }).map(function(m){ return '<span title="' + m.t + ': ' + d.inboxes[m.k] + '" style="flex:' + d.inboxes[m.k] + ';background:' + m.c + '"></span>'; }).join('');
    document.getElementById('ovMix').innerHTML = MIX.map(function(m){ var v = d.inboxes[m.k] || 0; return '<div class="mrow" onclick="openInbox(\'' + m.k + '\')"><i class="d" style="background:' + m.c + '"></i><span class="l">' + m.t + '</span><span class="n">' + v + '</span><span class="p">' + (tot ? Math.round(100 * v / tot) : 0) + '%</span></div>'; }).join('') +
      '<div class="mrow" onclick="openInbox(\'archivo\')" style="color:var(--muted)"><i class="d" style="background:var(--well)"></i><span class="l">Archivo (sin novedad)</span><span class="n">' + (d.inboxes.archivo || 0) + '</span><span class="p"></span></div>';

    // quién responde
    var whoArr = Object.keys(d.who).map(function(k){ return [k, d.who[k]]; }).sort(function(a, b){ return b[1] - a[1]; });
    var wmax = whoArr.length ? whoArr[0][1] : 1, wtot = whoArr.reduce(function(a, x){ return a + x[1]; }, 0);
    document.getElementById('whoHint').textContent = 'mensajes en ' + d.days + ' días';
    document.getElementById('ovWho').innerHTML = whoArr.length ? whoArr.map(function(x, i){
      return '<div class="it"><span class="rk">' + (i + 1) + '</span><span class="nm">' + esc(x[0]) + '</span><span class="vl">' + fmtN(x[1]) + '</span><div class="bar"><i style="width:' + Math.round(100 * x[1] / wmax) + '%"></i></div><div class="sub">' + Math.round(100 * x[1] / wtot) + '% de lo enviado</div></div>';
    }).join('') : '<div class="empty2">Sin mensajes enviados en el período.</div>';

    // embudo
    var ORDER = ['nuevo', 'informado', 'requisitos', 'parciales', 'listo', 'solicitud', 'instalado'];
    var ftot = ORDER.concat(['perdido']).reduce(function(a, k){ return a + (d.funnel[k] || 0); }, 0);
    var fmax = Math.max.apply(null, ORDER.map(function(k){ return d.funnel[k] || 0; }).concat([1]));
    document.getElementById('funHint').textContent = ftot + ' interesados con actividad';
    document.getElementById('ovFunnel').innerHTML = ftot ? ORDER.filter(function(k){ return d.funnel[k]; }).map(function(k, i){
      return '<div class="it" onclick="openInbox(\'ventas\')" style="cursor:pointer;grid-template-columns:1fr auto' + (i ? '' : ';background:var(--glass-3)') + '"><span class="nm">' + esc(STAGES[k]) + '</span><span class="vl">' + d.funnel[k] + '</span><div class="bar" style="grid-column:1/3"><i style="width:' + Math.round(100 * d.funnel[k] / fmax) + '%;background:' + (['parciales', 'listo'].indexOf(k) !== -1 ? 'var(--tomato)' : (['solicitud', 'instalado'].indexOf(k) !== -1 ? 'var(--pine)' : 'var(--butter)')) + '"></i></div></div>';
    }).join('') : '<div class="empty2">Sin interesados en el período.</div>';
    var lostK = Object.keys(d.lost);
    document.getElementById('ovLost').innerHTML = d.funnel.perdido ? '<i class="bi bi-x-circle"></i> <b>' + d.funnel.perdido + '</b> venta(s) perdida(s)' + (lostK.length ? ': ' + lostK.map(function(k){ return esc(LOST[k] || k) + ' (' + d.lost[k] + ')'; }).join(', ') : '') : '';

    // actividad reciente
    var IC = { cliente: 'bi-chat-left-text', persona: 'bi-reply', meta_ai: 'bi-robot', sistema: 'bi-megaphone', auto: 'bi-lightning-charge' };
    document.getElementById('ovAct2').innerHTML = d.recent.length ? d.recent.map(function(m){
      var what = m.sender === 'cliente' ? 'escribió' : (m.sender === 'persona' ? 'recibió respuesta de la oficina' : (m.sender === 'meta_ai' ? 'recibió respuesta de Meta AI' : 'recibió un aviso'));
      var txt = m.body || ({ image: '📷 Foto', audio: '🎤 Audio', ptt: '🎤 Audio', video: '🎬 Video', document: '📄 Documento', sticker: 'Sticker', call: '📞 Llamada' }[m.media_type] || '');
      return '<div class="it" onclick="goConv(' + m.conv_id + ')">' + avHtml({ id: m.conv_id, name: m.name, avatar_file: m.avatar_file, avatar_checked_at: m.avatar_checked_at, customer_id: m.customer_id, org: m.org }) +
        '<div class="tx"><b class="who2">' + esc(m.name) + '</b> ' + what + '<div class="q">' + esc(txt) + '</div><small>' + esc(ago(m.ts)) + '</small></div><i class="bi ' + (IC[m.sender] || 'bi-chat') + ' ic2"></i></div>';
    }).join('') : '<div class="empty2">Sin actividad.</div>';

    // horarios (de 5 a 23 h)
    var hrs = d.hours.slice(5, 24), hl = hrs.map(function(_, i){ return (i + 5) + 'h'; });
    var peak = hrs.indexOf(Math.max.apply(null, hrs));
    document.getElementById('hrHint').textContent = hrs[peak] ? 'pico a las ' + (peak + 5) + ':00' : '';
    barChart(document.getElementById('chHours'), hl, hrs, function(i, v, mx){ return i === peak ? tm : (v >= mx * .6 ? but : pine); }, function(k){ return '<b>' + (k + 5) + ':00 a ' + (k + 6) + ':00</b>' + hrs[k] + ' mensajes'; }, (document.getElementById('chHours').clientWidth < 500 ? 3 : 2));
    // contactos nuevos por día
    var nv = d.dayKeys.map(function(k){ return d.per[k].newc; });
    document.getElementById('newHint').textContent = fmtN(t.newc) + ' en ' + d.days + ' días' + (t.todayNew ? ' · ' + t.todayNew + ' hoy' : '');
    barChart(document.getElementById('chNew'), labels, nv, function(i){ return i === nv.length - 1 ? tm : ink; }, function(k){ return '<b>' + esc(fmtD(d.dayKeys[k] + 'T12:00:00')) + '</b>' + nv[k] + ' contacto(s) nuevo(s)'; }, Math.ceil(nv.length / 8));
  }
  var rz; window.addEventListener('resize', function(){ clearTimeout(rz); rz = setTimeout(renderStats, 150); });
  // Los gráficos se redibujan al cambiar el tema (colores)
  new MutationObserver(function(){ setTimeout(renderStats, 30); }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  loadQr();
  var v0 = 'resumen'; try { v0 = localStorage.getItem('cv-view') || 'resumen'; } catch (_) {}
  if (sel) { setView('bandeja'); openConv(sel); } else setView(v0);
  setInterval(function(){ if (document.hidden) return; if (view === 'bandeja') loadList(); else loadBoard(); }, 10000);
  setInterval(function(){ if (!document.hidden && view === 'resumen') loadStats(); }, 60000);
  setInterval(function(){ poll(false); }, 5000);
})();
</script>
</body>
</html>
