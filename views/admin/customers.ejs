function loadOdpPorts(scope){
  var isEdit = scope === 'edit';
  var odpSel = document.getElementById(isEdit ? 'e_odp_id' : 'add_odp_id');
  var portSel = document.getElementById(isEdit ? 'e_pon_port' : 'add_pon_port');
  if(!odpSel || !portSel) return Promise.resolve();
  var current = portSel.value;
  var odpId = odpSel.value;
  portSel.innerHTML = '<option value=""><%= t('admin.cust.opt_no_port','-- Tanpa Port --') %></option>';
  if(!odpId) return Promise.resolve();
  return fetch('/admin/api/odps/' + encodeURIComponent(odpId) + '/ports', { cache: 'no-store' })
    .then(function(r){ return r.json(); })
    .then(function(u){
      var cap = Number(u.capacity || 0);
      var used = {};
      (u.usedPorts || []).forEach(function(p){ used[String(p)] = true; });
      for(var i=1;i<=cap;i++){
        var opt=document.createElement('option');
        opt.value=String(i);
        var isUsed = !!used[String(i)];
        opt.textContent = 'Port ' + i + (isUsed ? ' (en uso)' : '');
        if(isUsed && String(i)!==String(current)) opt.disabled = true;
        portSel.appendChild(opt);
      }
      if(current) portSel.value = current;
    })
    .catch(function(){});
}

