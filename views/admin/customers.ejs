                <% if (typeof odps !== 'undefined') { %>
                  <% odps.forEach(o => { %>
                    <option value="<%= o.id %>"><%= o.name %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="fg"><label class="fl"><%= t('admin.cust.odp_port','Port ODP') %></label>
              <select class="fs" name="pon_port" id="e_pon_port"><option value=""><%= t('admin.cust.opt_no_port','-- Tanpa Port --') %></option></select>
            </div>
            <div class="fg" id="e_mac_field" style="display:none">
              <label class="fl"><%= t('admin.cust.mac_opt','MAC Address (Opsional)') %></label>
              <input class="fc" name="mac_address" id="e_mac_address" placeholder="<%= t('admin.cust.ph_mac','Contoh: AA:BB:CC:DD:EE:FF') %>">
            </div>
          </div>
          <div class="form-row">
            <div class="fg"><label class="fl">Latitude</label><input class="fc" name="lat" id="e_lat" placeholder="-25.xxx"></div>
            <div class="fg">
              <label class="fl">Longitude</label>
              <div style="display:flex;gap:4px">
                <input class="fc" name="lng" id="e_lng" placeholder="-57.xxx">
                <button type="button" class="btn btn-g btn-sm" onclick="openPicker('edit')" title="<%= t('admin.cust.tt_pick_map','Pilih di Peta') %>"><i class="bi bi-geo-alt"></i></button>
              </div>
            </div>
          </div>
          <div class="fg" style="margin-top:10px;"><label class="fl"><%= t('tech.cc.note','Catatan') %></label><textarea class="fc" name="notes" id="e_notes" placeholder="<%= t('admin.cust.ph_note','Catatan internal opsional...') %>"></textarea></div>
        </div>

      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="syncCustFromModal()"><i class="bi bi-arrow-repeat"></i> <%= t('admin.cust.apply_network','Terapkan ke Jaringan') %></button>
        <button type="button" class="btn btn-g" onclick="closeModal('editModal')"><%= t('common.cancel','Batal') %></button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> <%= t('admin.cust.update_customer','Update Pelanggan') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Generate Tagihan (Per Pelanggan) -->
<div class="mo" id="genInvoiceModal">
  <div class="mb" style="max-width:520px">
