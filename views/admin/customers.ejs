<script>
function openModal(id){
  const el = document.getElementById(id);
  if (el) el.classList.add('show');
}
function closeModal(id){
  const el = document.getElementById(id);
  if (el) el.classList.remove('show');
}

function safeParseJSON(elementId, fallback = []) {
  try {
    const el = document.getElementById(elementId);
    if (!el || !el.textContent || !el.textContent.trim()) return fallback;
    return JSON.parse(el.textContent);
  } catch (e) {
    console.warn('Failed to parse JSON for ' + elementId, e);
    return fallback;
  }
}

const customersData = safeParseJSON('customers-data', []);
const activeSessionsArray = safeParseJSON('sessions-data', []);
const activeSessionsMapObj = new Map(Array.isArray(activeSessionsArray) ? activeSessionsArray : []);
const routersData = safeParseJSON('routers-data', []);
const appSettings = safeParseJSON('settings-data', {});
let pickerMap, pickerMarker, activePickerType;
let payCustomerId = null;
let payBillingMeta = null;

function formatBytesVal(b) {
  const num = Number(b) || 0;
  if (num <= 0) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
  const i = Math.floor(Math.log(num) / Math.log(k));
  return (num / Math.pow(k, i)).toFixed(2) + ' ' + sizes[i];
}

function copyToClipboard(elementId, label) {
  const el = document.getElementById(elementId);
  const text = el ? (el.innerText || el.textContent || '').trim() : '';
  if (!text || text === '-') {
    alert('No hay datos ' + label + ' para copiar.');
    return;
  }
  navigator.clipboard.writeText(text).then(() => {
    alert(' ' + label + ' copiado: ' + text);
  }).catch(() => {
    const input = document.createElement('textarea');
    input.value = text;
    document.body.appendChild(input);
    input.select();
    document.execCommand('copy');
    document.body.removeChild(input);
    alert(' ' + label + ' copiado: ' + text);
  });
}

function copyCustCode(){
  var el = document.getElementById('v_cust_id'); if(!el) return;
  var val = (el.textContent || '').trim();
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(val).then(function(){ alert('ID de cliente copiado: ' + val); }).catch(function(){ prompt('<%= t('admin.cust.copy_id','Salin ID Pelanggan') %>:', val); });
  } else { prompt('<%= t('admin.cust.copy_id','Salin ID Pelanggan') %>:', val); }
}

// ── Aksi cepat per-pelanggan (dropdown): salin ID, salin IP, masuk ke IP ──
function _custSessionIp(idx) {
  var c = (typeof customersData !== 'undefined' && customersData[idx]) ? customersData[idx] : {};
  var username = String(c.pppoe_username || c.hotspot_username || c.name || '').trim().toLowerCase();
  var s = (typeof activeSessionsMapObj !== 'undefined' && activeSessionsMapObj && activeSessionsMapObj.get) ? activeSessionsMapObj.get(username) : null;
  return (s && s.ip) ? String(s.ip) : String(c.static_ip || '');
}
function _custToast(ok, msg) { if (window.toast) { toast(ok ? 'success' : 'warning', null, msg); } else { alert(msg); } }
function copyCustId(idx) {
  var c = (typeof customersData !== 'undefined' && customersData[idx]) ? customersData[idx] : {};
  var code = c.customer_code || (c.id ? String(c.id) : '');
  if (!code) { _custToast(false, 'El ID de cliente no está disponible.'); return; }
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(code).then(function () { _custToast(true, 'ID de cliente copiado: ' + code); }).catch(function () { prompt('<%= t('admin.cust.copy_id','Salin ID Pelanggan') %>:', code); });
  } else { prompt('<%= t('admin.cust.copy_id','Salin ID Pelanggan') %>:', code); }
}
function copyCustIp(idx) {
  var ip = _custSessionIp(idx);
  if (!ip) { _custToast(false, 'La IP del cliente no está disponible (desconectado / sin IP).'); return; }
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(ip).then(function () { _custToast(true, 'IP del cliente copiada: ' + ip); }).catch(function () { prompt('<%= t('admin.cust.copy_ip','Salin IP Pelanggan') %>:', ip); });
  } else { prompt('<%= t('admin.cust.copy_ip','Salin IP Pelanggan') %>:', ip); }
}
function openCustIp(idx) {
  var ip = _custSessionIp(idx);
  if (!ip) { _custToast(false, 'La IP del cliente no está disponible (desconectado / sin IP).'); return; }
  window.open('http://' + ip, '_blank', 'noopener');
}

function viewCustDetail(idx) {
  try {
    const c = customersData[idx];
    if (!c) {
      alert('Cliente no encontrado.');
      return;
    }

    const username = String(c.pppoe_username || c.hotspot_username || c.name || '').trim().toLowerCase();
    const session = activeSessionsMapObj && activeSessionsMapObj.get ? activeSessionsMapObj.get(username) : null;
    const isOnline = !!session;

    if (document.getElementById('v_cust_name')) document.getElementById('v_cust_name').textContent = c.name || '-';
    window.__viewCustId = c.id;
    if (document.getElementById('v_cust_id')) document.getElementById('v_cust_id').textContent = c.customer_code || c.id || '-';

    if (document.getElementById('v_online_badge')) {
      if (isOnline) {
        document.getElementById('v_online_badge').innerHTML = `
          <span class="badge" style="background:rgba(16,185,129,0.18);color:#10b981;border:1px solid rgba(16,185,129,0.35);font-size:12px;padding:6px 12px;font-weight:800">
            <i class="bi bi-circle-fill" style="font-size:8px;margin-right:6px"></i>ONLINE
          </span>
        `;
      } else {
        document.getElementById('v_online_badge').innerHTML = `
          <span class="badge" style="background:rgba(148,163,184,0.12);color:#94a3b8;border:1px solid rgba(148,163,184,0.25);font-size:12px;padding:6px 12px">
            <i class="bi bi-circle-fill" style="font-size:8px;margin-right:6px"></i>OFFLINE
          </span>
        `;
      }
    }

    if (document.getElementById('v_username')) document.getElementById('v_username').textContent = c.pppoe_username || c.hotspot_username || '-';
    if (document.getElementById('v_password')) document.getElementById('v_password').textContent = c.pppoe_password || c.hotspot_password || '-';
    if (document.getElementById('v_ip')) document.getElementById('v_ip').textContent = (session && session.ip) ? session.ip : (c.static_ip || '-');
    if (document.getElementById('v_mac')) document.getElementById('v_mac').textContent = (session && session.callerId) ? session.callerId : (c.mac_address || '-');
    
    const routerObj = (routersData || []).find(r => Number(r.id) === Number(c.router_id));
    if (document.getElementById('v_router_name')) document.getElementById('v_router_name').textContent = routerObj ? routerObj.name : (c.router_id ? ('Router #' + c.router_id) : '-');
    if (document.getElementById('v_conn_type')) document.getElementById('v_conn_type').textContent = (c.connection_type || 'pppoe').toUpperCase();
    if (document.getElementById('v_uptime')) document.getElementById('v_uptime').textContent = session ? (session.uptime || 'Active') : 'Desconectado (offline)';

    const rxBytes = session && session.bytesOut ? session.bytesOut : (c.bytes_in || 0);  // bajada del cliente
    const txBytes = session && session.bytesIn ? session.bytesIn : (c.bytes_out || 0);  // subida del cliente
    const totalBytes = rxBytes + txBytes;

    if (document.getElementById('v_rx_fmt')) document.getElementById('v_rx_fmt').textContent = formatBytesVal(rxBytes);
    if (document.getElementById('v_rx_bytes')) document.getElementById('v_rx_bytes').textContent = Number(rxBytes).toLocaleString(APP_LOCALE) + ' Bytes';
    if (document.getElementById('v_tx_fmt')) document.getElementById('v_tx_fmt').textContent = formatBytesVal(txBytes);
    if (document.getElementById('v_tx_bytes')) document.getElementById('v_tx_bytes').textContent = Number(txBytes).toLocaleString(APP_LOCALE) + ' Bytes';
    
    const limitGB = c.fup_limit_gb || 0;
    const useFup = c.use_fup === 1;
    const fupText = formatBytesVal(totalBytes) + (useFup && limitGB > 0 ? ` (Limit FUP: ${limitGB} GB)` : ' (Unlimited)');
    if (document.getElementById('v_total_fup')) document.getElementById('v_total_fup').textContent = fupText;

    if (document.getElementById('v_nik')) document.getElementById('v_nik').textContent = c.nik || '-';
    if (document.getElementById('v_phone')) document.getElementById('v_phone').textContent = c.phone || '-';
    if (document.getElementById('v_address_area')) document.getElementById('v_address_area').textContent = (c.address || '-') + (c.area ? ` [Area: ${c.area}]` : '');
    if (document.getElementById('v_package')) document.getElementById('v_package').textContent = c.package_name ? (c.package_price !== undefined ? `${c.package_name} (${APP_CUR} ${Number(c.package_price||0).toLocaleString(APP_LOCALE)})` : c.package_name) : '-';
    if (document.getElementById('v_expired_at')) {
      if (c.package_billing_type === 'prepaid' || c.expired_at) {
        const expStr = c.expired_at ? String(c.expired_at).slice(0, 10) : '-';
        const isExp = c.expired_at ? (new Date(c.expired_at) < new Date()) : false;
        document.getElementById('v_expired_at').innerHTML = `
          <span class="badge ${isExp ? 'bd' : 'bs'}" style="font-weight:700;">
            <i class="bi bi-clock-history"></i> ${expStr} ${isExp ? '(Expired / Terisolir)' : '(Activo)'}
          </span>
        `;
      } else {
        document.getElementById('v_expired_at').textContent = 'Pascabayar (Bulanan Kalender)';
      }
    }
    if (document.getElementById('v_genieacs')) document.getElementById('v_genieacs').textContent = c.genieacs_tag || '-';
    if (document.getElementById('v_status_account')) document.getElementById('v_status_account').textContent = `Status: ${c.status || 'active'} | Auto Isolir: ${c.auto_isolate === 0 ? '<%= t('admin.cust.inactive','Nonaktif') %>' : 'Aktif (Tgl ' + (c.isolate_day || '-') + ')'}`;

    if (document.getElementById('v_disconnect_form')) {
      document.getElementById('v_disconnect_form').action = '/admin/customers/' + c.id + '/disconnect';
    }

    currentDetailIdx = idx;
    openModal('viewDetailModal');
    fetchLiveSessions();
  } catch (err) {
    console.error('Error in viewCustDetail:', err);
    alert('Ocurrió un error al cargar el detalle del cliente: ' + err.message);
  }
}

let currentDetailIdx = null;

async function fetchLiveSessions() {
  try {
    const res = await fetch('/admin/api/customers/live-sessions');
    if (!res.ok) return;
    const data = await res.json();
    if (!data.ok || !data.sessions) return;

    for (const [uname, session] of Object.entries(data.sessions)) {
      activeSessionsMapObj.set(uname.toLowerCase(), session);
    }

    document.querySelectorAll('.cust-conn-cell').forEach(cell => {
      const username = cell.dataset.username;
      if (!username) return;
      const s = data.sessions[username];
      const rxEl = cell.querySelector('.conn-rx');
      const txEl = cell.querySelector('.conn-tx');
      const uptimeEl = cell.querySelector('.conn-uptime');
      const ipEl = cell.querySelector('.conn-ip');

      if (s) {
        if (rxEl) rxEl.textContent = formatBytesVal(s.bytesOut); // bajada del cliente
        if (txEl) txEl.textContent = formatBytesVal(s.bytesIn);  // subida del cliente
        if (uptimeEl) uptimeEl.textContent = s.uptime || '-';
        if (ipEl) ipEl.textContent = s.ip || '-';
      }
    });

    if (currentDetailIdx !== null) {
      updateDetailModalLive(currentDetailIdx);
    }
  } catch (err) {
    console.warn('Live sessions fetch error:', err);
  }
}

function updateDetailModalLive(idx) {
  const c = customersData[idx];
  if (!c) return;
  const username = String(c.pppoe_username || c.hotspot_username || c.name || '').trim().toLowerCase();
  const session = activeSessionsMapObj.get(username);
  if (session) {
    const rxBytes = session.bytesOut || 0; // bajada del cliente
    const txBytes = session.bytesIn || 0;  // subida del cliente
    const totalBytes = rxBytes + txBytes;

    if (document.getElementById('v_rx_fmt')) document.getElementById('v_rx_fmt').textContent = formatBytesVal(rxBytes);
    if (document.getElementById('v_rx_bytes')) document.getElementById('v_rx_bytes').textContent = Number(rxBytes).toLocaleString(APP_LOCALE) + ' Bytes';
    if (document.getElementById('v_tx_fmt')) document.getElementById('v_tx_fmt').textContent = formatBytesVal(txBytes);
    if (document.getElementById('v_tx_bytes')) document.getElementById('v_tx_bytes').textContent = Number(txBytes).toLocaleString(APP_LOCALE) + ' Bytes';
    if (document.getElementById('v_uptime')) document.getElementById('v_uptime').textContent = session.uptime || 'Active';
    if (document.getElementById('v_ip')) document.getElementById('v_ip').textContent = session.ip || (c.static_ip || '-');
    if (document.getElementById('v_mac')) document.getElementById('v_mac').textContent = session.callerId || (c.mac_address || '-');

    const limitGB = c.fup_limit_gb || 0;
    const useFup = c.use_fup === 1;
    const fupText = formatBytesVal(totalBytes) + (useFup && limitGB > 0 ? ` (Limit FUP: ${limitGB} GB)` : ' (Unlimited)');
    if (document.getElementById('v_total_fup')) document.getElementById('v_total_fup').textContent = fupText;
  }
}

setInterval(fetchLiveSessions, 5000);

function filterByStatus(statusVal) {
  const url = new URL(window.location.href);
  if (statusVal) {
    url.searchParams.set('status', statusVal);
  } else {
    url.searchParams.delete('status');
  }
  window.location.href = url.toString();
}

window.filterByStatus = filterByStatus;
window.viewCustDetail = viewCustDetail;
window.copyToClipboard = copyToClipboard;

const PAY_MNS = JSON.parse(document.getElementById('pay-months-data').textContent);
const PAY_I18N = JSON.parse(document.getElementById('pay-i18n-data').textContent);

const officeCoords = {
  lat: parseFloat(appSettings.office_lat) || -6.200000,
  lng: parseFloat(appSettings.office_lng) || 106.816666
};

function openModal(id){document.getElementById(id).classList.add('show')}
function closeModal(id){document.getElementById(id).classList.remove('show')}

function openPicker(type) {
  activePickerType = type;
  openModal('mapPickerModal');
  
  let currentLat = document.getElementById(type === 'add' ? 'add_lat' : 'e_lat').value;
  let currentLng = document.getElementById(type === 'add' ? 'add_lng' : 'e_lng').value;
  
  let startLat = parseFloat(currentLat) || officeCoords.lat;
  let startLng = parseFloat(currentLng) || officeCoords.lng;

  setTimeout(() => {
    if (!pickerMap) {
      pickerMap = L.map('picker-map').setView([startLat, startLng], 16);
      L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
        maxZoom: 20,
        subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
      }).addTo(pickerMap);
      
      const customIcon = L.divIcon({
        html: '<i class="bi bi-geo-alt-fill picker-icon"></i>',
        className: 'custom-div-icon',
        iconSize: [32, 32],
        iconAnchor: [16, 32]
      });

      pickerMarker = L.marker([startLat, startLng], { 
        draggable: true,
        icon: customIcon
      }).addTo(pickerMap);
      
      pickerMarker.on('dragend', function() {
        const pos = pickerMarker.getLatLng();
        updateInputs(pos.lat, pos.lng);
      });

      pickerMap.on('click', function(e) {
        pickerMarker.setLatLng(e.latlng);
        updateInputs(e.latlng.lat, e.latlng.lng);
      });
    } else {
      pickerMap.setView([startLat, startLng], 16);
