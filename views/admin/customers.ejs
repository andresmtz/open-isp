<script>
// Cobro de monto libre: pagos parciales y saldo a favor
// Promesa de pago: habilita (si está cortado) hasta la fecha límite
async function promiseCust(id) {
  try {
    const pr = await (await fetch('/admin/customers/' + id + '/promise-preview', { headers: { Accept: 'application/json' } })).json();
    if (!pr.ok) { alert(pr.message || 'No se pudo preparar la promesa.'); return; }
    if (pr.blocked) { alert(pr.blocked); return; }
    const c = pr.customer;
    const msg = 'PROMESA DE PAGO — ' + c.name + '\n\n'
      + 'Deuda: ' + pr.debt.count + ' factura(s), ' + fmtMoney(pr.debt.total) + '\n'
      + (pr.active ? 'Promesa vigente hasta ' + pr.active.until + ' (se reemplaza)\n' : '')
      + (c.status === 'suspended' ? 'El servicio está CORTADO: se habilita ahora.\n' : '')
      + 'Si no paga todo antes del vencimiento, se corta automáticamente.\n\n'
      + 'Fecha y hora límite de pago (DD/MM/AAAA HH:MM, máximo ' + pr.maxDays + ' días):';
    const d = new Date(Date.now() + pr.defaultDays * 86400000);
    const p2 = n => String(n).padStart(2, '0');
    const until = prompt(msg, p2(d.getDate()) + '/' + p2(d.getMonth() + 1) + '/' + d.getFullYear() + ' ' + p2(d.getHours()) + ':' + p2(d.getMinutes()));
    if (until === null) return;
    const note = prompt('Nota (opcional): qué prometió el cliente', '') || '';
    const r = await fetch('/admin/customers/' + id + '/promise', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ until: until, note: note }) });
    const j = await r.json();
    alert(j.message || (j.ok ? 'Listo.' : 'Error'));
    if (j.ok) location.reload();
  } catch (e) { alert('Error: ' + e.message); }
}

// Cancelar servicio: muestra lo que va a pasar, pide el motivo y confirma
async function cancelCustService(id) {
  try {
    const pr = await (await fetch('/admin/customers/' + id + '/cancel-preview', { headers: { Accept: 'application/json' } })).json();
    if (!pr.ok) { alert(pr.message || 'No se pudo preparar la cancelación.'); return; }
    const c = pr.customer;
    const inv = pr.pendingInvoices.length
      ? pr.pendingInvoices.map(i => '   • ' + String(i.period_month).padStart(2, '0') + '/' + i.period_year + ': ' + fmtMoney(i.amount)).join('\n') + '\n   Total: ' + fmtMoney(pr.pendingTotal)
      : '   (no tiene facturas pendientes)';
    const msg = 'CANCELAR SERVICIO de ' + c.name + (c.code ? ' (' + c.code + ')' : '') + '\n\n'
      + 'En el MikroTik:\n   • Se borra el usuario PPPoE "' + (c.pppoe || '-') + '"\n   • Se libera la IP ' + (c.ip || '-') + ' (sale de la lista de corte)\n\n'
      + 'Facturas pendientes que se ANULAN (quedan en el historial, fuera de estadísticas):\n' + inv + '\n\n'
      + (pr.carryOver ? 'Saldo trasladado pendiente que se descarta: ' + fmtMoney(pr.carryOver) + '\n\n' : '')
      + 'El cliente y todo su historial se conservan.\n\nEscribí el motivo para confirmar:';
    const reason = prompt(msg, 'Equipo no recuperado / cliente no ubicable');
    if (reason === null) return;
    if (reason.trim().length < 3) { alert('El motivo es obligatorio.'); return; }
    const r = await fetch('/admin/customers/' + id + '/cancel', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ reason: reason.trim() }) });
    const j = await r.json();
    if (!j.ok) { alert('No se canceló: ' + (j.message || 'error')); return; }
    alert(j.message);
    location.reload();
  } catch (e) { alert('Error: ' + e.message); }
}
</script>
