<!DOCTYPE html>
<html lang="<%= lang || 'es' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Equipos caídos | <%= company %></title>
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .og-msg{width:100%;min-height:90px;font-family:inherit}
    .og-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px}
    .og-ans{font-size:12px;color:var(--muted,#888);max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'outages', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-wifi-off"></i> Equipos caídos</div>
    <div class="tb-right">
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">
    <% const fmt = (v) => { if (!v) return '-'; const d = new Date(v); return isNaN(d) ? v : d.toLocaleString('es-PY', { timeZone: 'America/Asuncion', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }); }; %>
    <% const badge = { consultado: 'bw', sin_energia: 'bw', asistencia: 'bd', ausente: 'bs', foto: 'bw', sin_respuesta: 'bd', restablecido: 'bs', cerrado: 'bs' }; %>
    <% if (msg) { %><div class="alert alert-<%= msg.type === 'success' ? 's' : 'd' %>" data-flash="1"><i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-circle' %>"></i> <%= msg.text %></div><% } %>

    <%# Caídas masivas: varias ONU del mismo puerto PON apagadas a la vez (services/massOutageService.js) %>
    <% const openMass = (mass || []).filter(e => e.state === 'abierta'), pastMass = (mass || []).filter(e => e.state !== 'abierta').slice(0, 5); %>
    <div class="card mb16">
      <div class="card-hd"><h6><i class="bi bi-broadcast"></i> Caídas masivas <% if (openMass.length) { %><span class="badge bd" style="margin-left:6px"><%= openMass.length %> abierta<%= openMass.length > 1 ? 's' : '' %></span><% } %></h6></div>
      <div class="card-bd">
        <% if (!openMass.length) { %>
          <div class="text-muted" style="font-size:13px"><i class="bi bi-check-circle" style="color:var(--success)"></i> No hay caídas masivas en este momento. Se detectan solas cuando varios equipos del mismo puerto de la OLT se apagan casi a la vez (por ejemplo, un corte de luz o de fibra en una zona), y se avisa por WhatsApp a la administración.</div>
        <% } %>
        <% openMass.forEach(ev => { %>
          <div style="border:1px solid var(--border);border-radius:16px;padding:14px 16px;margin-bottom:12px">
            <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;align-items:flex-start">
              <div>
                <div style="font-weight:800;font-size:15px"><i class="bi bi-exclamation-triangle-fill" style="color:var(--danger)"></i> Puerto <%= ev.port.replace('EPON', 'EPON ') %> · <%= ev.members.length %> de <%= ev.port_total %> equipos caídos</div>
                <div class="text-muted" style="font-size:12.5px;margin-top:3px">Desde <%= fmt(ev.started_at) %> · motivo probable: <b><%= ev.reasonText %></b> · volvieron <%= ev.restored_count || 0 %></div>
              </div>
              <div style="display:flex;gap:6px;flex-wrap:wrap">
                <% if (!ev.notice_published) { %><form method="POST" action="/admin/outages/mass/<%= ev.id %>/notice" onsubmit="return confirm('¿Publicar el aviso de CAÍDA GENERAL? Lo ven todos los clientes en el portal. Se quita solo cuando vuelve el servicio.')"><button class="btn btn-sm btn-p"><i class="bi bi-megaphone"></i> Publicar aviso de caída</button></form><% } else { %><span class="badge bs" style="align-self:center"><i class="bi bi-megaphone"></i> Aviso publicado</span><% } %>
                <% if (!ev.ticket_id) { %><form method="POST" action="/admin/outages/mass/<%= ev.id %>/ticket"><button class="btn btn-sm btn-g"><i class="bi bi-tools"></i> Crear reclamo para el técnico</button></form><% } else { %><a class="btn btn-sm btn-g" href="/admin/tickets"><i class="bi bi-ticket-perforated"></i> Reclamo #<%= ev.ticket_id %></a><% } %>
                <form method="POST" action="/admin/outages/mass/<%= ev.id %>/close" onsubmit="return confirm('¿Cerrar esta caída masiva? Sus clientes vuelven a recibir la consulta automática si siguen apagados.')"><button class="btn btn-sm btn-g"><i class="bi bi-check2"></i> Cerrar</button></form>
              </div>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:10px">
              <% ev.members.forEach(m => { %><span class="badge bm" title="<%= m.onu %> · <%= m.reason || '' %>"><% if (m.customer_id) { %><a href="/admin/customers/<%= m.customer_id %>/ficha" style="color:inherit;text-decoration:none"><%= m.name || m.onu %></a><% } else { %><%= m.name || m.onu %><% } %></span><% }) %>
            </div>
          </div>
        <% }) %>
        <% if (pastMass.length) { %>
          <div class="text-muted" style="font-size:12px;margin-top:6px"><b>Anteriores:</b> <%- pastMass.map(e => (e.port.replace('EPON', 'EPON ') + ' · ' + e.members.length + ' equipos · ' + fmt(e.started_at) + ' → ' + fmt(e.closed_at)).replace(/[<>&]/g, '')).join(' &nbsp;|&nbsp; ') %></div>
        <% } %>
      </div>
    </div>

    <%# Aviso preventivo de señal (services/signalWatchService.js) %>
    <div class="card mb16">
      <div class="card-hd"><h6><i class="bi bi-graph-down-arrow"></i> Aviso preventivo de señal</h6></div>
      <div class="card-bd" style="font-size:13px">
        <div class="text-muted" style="margin-bottom:8px">Una vez por día se revisa el historial de potencia de los clientes con servicio. Si la señal viene bajando, ya está en nivel malo o el equipo se cae y vuelve seguido, se abre un reclamo preventivo para el técnico (hasta 3 por día) y llega un resumen por WhatsApp. Al cliente no se le escribe.</div>
        <% const nextList = (signal.next || []); %>
        <% if (nextList.length) { %>
          <div style="margin-bottom:8px"><b>Para revisar:</b>
            <% nextList.forEach(x => { %><div style="padding:4px 0;border-top:1px solid var(--border)"><a href="/admin/customers/<%= x.customer.id %>/ficha"><%= x.customer.name %></a> — <%= x.analysis.text %> <% if (x.skip) { %><span class="text-muted">(no se avisa: <%= x.skip %>)</span><% } %></div><% }) %>
          </div>
        <% } else { %><div><i class="bi bi-check-circle" style="color:var(--success)"></i> Ningún cliente con servicio tiene la señal en problemas.</div><% } %>
        <% if ((signal.recent || []).length) { %>
          <div class="text-muted" style="font-size:12px;margin-top:6px"><b>Avisos recientes:</b> <%= signal.recent.map(r => (r.name || '#' + r.customer_id) + ' (#' + r.ticket_id + ', ' + String(r.created_at || '').slice(8, 10) + '/' + String(r.created_at || '').slice(5, 7) + ')').join(' · ') %></div>
        <% } %>
      </div>
    </div>

    <div class="alert alert-s" style="font-size:13px">
      <i class="bi bi-info-circle"></i>
      Cuando la ONU de un cliente <b>activo y al día</b> está apagada más de <b><%= cfg.outage_query_hours %> h</b> y no tiene asistencia abierta, se le pregunta por WhatsApp qué ve en el equipo.
      Luz roja o luces normales crean la asistencia automáticamente. <%= cfg.outage_query_enabled ? '' : '⚠️ La consulta automática está desactivada.' %>
    </div>

    <div class="card">
      <div class="card-hd" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px">
        <span class="fw6"><i class="bi bi-list-check"></i> <%= all ? 'Todos los casos' : 'Casos abiertos y de los últimos 7 días' %></span>
        <a class="btn btn-g btn-sm" href="/admin/outages<%= all ? '' : '?all=1' %>"><%= all ? 'Ver recientes' : 'Ver todos' %></a>
      </div>
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead><tr><th>Cliente</th><th>Apagado desde</th><th>Consultado</th><th>Estado</th><th>Respuesta</th><th>Asistencia</th><th></th></tr></thead>
          <tbody>
          <% if (!rows.length) { %><tr><td colspan="7" class="text-center text-muted">Sin equipos caídos.</td></tr><% } %>
          <% rows.forEach(r => { %>
            <tr>
              <td><a href="/admin/customers/<%= r.customer_id %>/ficha" style="font-weight:700;text-decoration:none"><%= r.name || ('#' + r.customer_id) %></a><div class="text-muted small"><%= r.customer_code || '' %> · <%= r.phone || '' %><%= r.onu_id ? ' · ' + r.onu_id : '' %></div></td>
              <td><%= fmt(r.down_since) %></td>
              <td><%= fmt(r.asked_at) %><%= r.asked_count > 1 ? ' (' + r.asked_count + '×)' : '' %><% if (r.meta_ai) { %><div class="text-muted small" title="Meta AI también contestó en el chat">🤖 Meta AI intervino</div><% } %></td>
              <td><span class="badge <%= badge[r.state] || 'bw' %>"><%= r.stateLabel %></span><% if (r.resolved_at) { %><div class="text-muted small"><%= fmt(r.resolved_at) %></div><% } %></td>
              <td><div class="og-ans" title="<%= r.answer %>"><%= r.answer || '-' %></div><% if (r.notes) { %><div class="text-muted small"><%= r.notes %></div><% } %><% if (r.diag) { %><div class="small" style="margin-top:3px;max-width:320px;white-space:normal">📉 <%= r.diag %></div><% } %></td>
              <td><%- r.ticket_id ? '<a href="/admin/tickets?search=' + encodeURIComponent(r.name || '') + '">#' + r.ticket_id + '</a>' : '-' %></td>
              <td style="white-space:nowrap">
                <% if (r.conv_id) { %><a class="btn btn-g btn-sm" href="/admin/conversations?c=<%= r.conv_id %>" title="Ver chat"><i class="bi bi-chat-dots"></i></a><% } %>
                <% if (r.open) { %><button class="btn btn-g btn-sm" onclick="ogClose(<%= r.id %>)" title="Cerrar caso"><i class="bi bi-check2"></i></button><% } %>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (isAdmin) { %>
    <div class="card" style="margin-top:16px">
      <div class="card-hd"><span class="fw6"><i class="bi bi-gear"></i> Configuración</span></div>
      <div class="card-bd">
        <div class="og-grid">
          <div class="fg"><label class="fl">Consulta automática</label><select class="fs" id="og_enabled"><option value="true" <%= cfg.outage_query_enabled ? 'selected' : '' %>>Activada</option><option value="false" <%= cfg.outage_query_enabled ? '' : 'selected' %>>Desactivada</option></select></div>
          <div class="fg"><label class="fl">Preguntar después de (horas apagado)</label><input class="fc" type="number" min="1" id="og_hours" value="<%= cfg.outage_query_hours %>"></div>
          <div class="fg"><label class="fl">Avisar a la oficina si no responde en (h)</label><input class="fc" type="number" min="1" id="og_noreply" value="<%= cfg.outage_noreply_hours %>"></div>
          <div class="fg"><label class="fl">"Sin energía": volver a preguntar a las (h)</label><input class="fc" type="number" min="1" id="og_reask" value="<%= cfg.outage_reask_hours %>"></div>
          <div class="fg"><label class="fl">Horario de envío</label><input class="fc" id="og_send" value="<%= cfg.outage_send_hours %>"><div class="text-muted small">Días 1=lun … 7=dom. Ej.: 1-6 08:00-19:00</div></div>
        </div>
        <div class="text-muted small" style="margin:6px 0 10px">Variables: {{nombre}} (primer nombre), {{empresa}}, {{fecha}} (solo en la consulta).</div>
        <% [['outage_msg_query', 'Mensaje de consulta'], ['outage_msg_1', 'Respuesta a 1 (sin energía)'], ['outage_msg_2', 'Respuesta a 2 (luz roja → asistencia)'], ['outage_msg_3', 'Respuesta a 3 (luces normales → asistencia)'], ['outage_msg_4', 'Respuesta a 4 (de viaje)'], ['outage_msg_back', 'Cuando el equipo vuelve (vacío = no enviar)']].forEach(([k, l]) => { %>
          <div class="fg"><label class="fl"><%= l %></label><textarea class="fc og-msg" data-k="<%= k %>"><%= cfg[k] %></textarea></div>
        <% }) %>
        <button class="btn btn-p" onclick="ogSave(this)"><i class="bi bi-save"></i> Guardar</button>
      </div>
    </div>
    <% } %>
  </div>
</div>
<script>
function ogToast(ok, t) { if (window.notify) window.notify(ok ? 'success' : 'error', ok ? 'Listo' : 'Error', t); else alert(t); }
function ogClose(id) {
  if (!confirm('¿Cerrar este caso? No se le vuelve a preguntar al cliente por esta caída.')) return;
  fetch('/admin/outages/' + id + '/close', { method: 'POST' }).then(r => r.json()).then(d => { if (d.ok) location.reload(); else ogToast(false, d.message); });
}
function ogSave(b) {
  const body = {
    outage_query_enabled: document.getElementById('og_enabled').value === 'true',
    outage_query_hours: document.getElementById('og_hours').value,
    outage_noreply_hours: document.getElementById('og_noreply').value,
    outage_reask_hours: document.getElementById('og_reask').value,
    outage_send_hours: document.getElementById('og_send').value,
  };
  document.querySelectorAll('.og-msg').forEach(t => { body[t.dataset.k] = t.value; });
  b.disabled = true;
  fetch('/admin/outages/settings', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
    .then(r => r.json()).then(d => { b.disabled = false; ogToast(d.ok, d.message); })
    .catch(() => { b.disabled = false; ogToast(false, 'No se pudo guardar'); });
}
</script>
</body>
</html>
