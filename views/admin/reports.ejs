<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.nav.finance_report', 'Laporan Keuangan') %> | <%= company %></title>
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    details.card > summary { cursor: pointer; list-style: none; }
    details.card > summary::-webkit-details-marker { display: none; }
    details.card > summary::after { content: '\F282'; font-family: 'bootstrap-icons'; color: var(--muted); }
    details.card[open] > summary::after { content: '\F286'; }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'reports', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-bar-chart-line"></i> <%= t('admin.nav.finance_report', 'Laporan Keuangan') %></div>
    <div class="tb-right" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
      <select class="fs" id="yearSelect" style="width:90px" onchange="window.location='/admin/reports?year='+this.value">
        <% for(let y=new Date().getFullYear(); y>=2023; y--){ %>
        <option value="<%= y %>" <%= filterYear==y?'selected':'' %>><%= y %></option>
        <% } %>
      </select>
      <a href="/admin/reports/export-csv?year=<%= filterYear %>" class="btn btn-g btn-sm" title="Export Excel (CSV)"><i class="bi bi-file-earmark-excel" style="color:#10b981"></i> Excel</a>
      <a href="/admin/reports/pdf?year=<%= filterYear %>&mode=before" target="_blank" class="btn btn-g btn-sm" title="PDF — ganancia antes de impuestos"><i class="bi bi-file-earmark-pdf" style="color:#ef4444"></i> PDF (antes de impuestos)</a>
      <a href="/admin/reports/pdf?year=<%= filterYear %>&mode=after" target="_blank" class="btn btn-g btn-sm" title="PDF — ganancia después de impuestos"><i class="bi bi-file-earmark-pdf" style="color:#ef4444"></i> PDF (después de impuestos)</a>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">

    <!-- ═══ A. RINGKASAN ═══ -->
    <div class="stat-grid" style="grid-template-columns:repeat(auto-fit,minmax(190px,1fr))">
      <div class="sc i"><i class="bi bi-cash-stack sc-icon"></i>
        <div class="sc-label"><%= t('admin.fin.gross','Pemasukan (Bruto)') %> <%= filterYear %></div>
        <div class="sc-val" style="font-size:20px"><%= APP_CUR %> <%= (cashInYear||0).toLocaleString(APP_LOCALE) %></div>
        <div class="sc-sub">Este mes: <%= APP_CUR %> <%= (cashInThisMonth||0).toLocaleString(APP_LOCALE) %></div>
      </div>
      <div class="sc d"><i class="bi bi-wallet2 sc-icon"></i>
        <div class="sc-label">Gastos <%= filterYear %></div>
        <div class="sc-val" style="font-size:20px">- <%= APP_CUR %> <%= (expensesYear||0).toLocaleString(APP_LOCALE) %></div>
        <div class="sc-sub">Este mes: <%= APP_CUR %> <%= (expensesMonth||0).toLocaleString(APP_LOCALE) %></div>
      </div>
      <div class="sc w"><i class="bi bi-receipt sc-icon"></i>
        <div class="sc-label">Impuesto a la renta (<%= finance.pph %>%)</div>
        <div class="sc-val" style="font-size:20px">- <%= APP_CUR %> <%= Math.round(ply.pph).toLocaleString(APP_LOCALE) %></div>
        <div class="sc-sub">Ganancia antes de impuestos: <%= APP_CUR %> <%= Math.round(ply.sebelumPph).toLocaleString(APP_LOCALE) %></div>
      </div>
      <div class="sc s" style="background:rgba(16,185,129,0.15);border-color:rgba(16,185,129,0.3)"><i class="bi bi-piggy-bank-fill sc-icon" style="color:#10b981"></i>
        <div class="sc-label" style="color:#10b981"><%= t('admin.fin.net','Laba Bersih') %> <%= filterYear %></div>
        <div style="font-size:11.5px;color:var(--muted);margin-bottom:2px">Antes de impuestos: <b style="color:var(--text)"><%= APP_CUR %> <%= Math.round(ply.sebelumPph).toLocaleString(APP_LOCALE) %></b></div>
        <div style="font-size:11.5px;color:var(--muted);margin-bottom:4px">Después de impuestos: <b style="color:#10b981"><%= APP_CUR %> <%= Math.round(ply.bersih).toLocaleString(APP_LOCALE) %></b></div>
        <div class="sc-sub" style="color:#10b981">Este mes (desp. imp.): <%= APP_CUR %> <%= Math.round(pm.bersih).toLocaleString(APP_LOCALE) %></div>
      </div>
      <div class="sc p"><i class="bi bi-hourglass sc-icon"></i>
        <div class="sc-label">Pendiente de cobro</div>
        <div class="sc-val" style="font-size:20px"><%= APP_CUR %> <%= (pendingAmount||0).toLocaleString(APP_LOCALE) %></div>
        <div class="sc-sub">Clientes activos: <%= activeCustomers %></div>
      </div>
    </div>

    <!-- ═══ B. LAPORAN LABA / RUGI ═══ -->
    <div class="card mb16">
      <div class="card-hd">
        <h6><i class="bi bi-receipt-cutoff"></i> Estado de resultados — impuestos <%= filterYear %></h6>
      </div>
      <div class="card-bd" style="padding:0">
        <table class="dtbl">
          <tbody>
            <tr><td><%= t('admin.fin.gross','Pemasukan (Bruto)') %></td><td class="num fw6"><%= APP_CUR %> <%= Math.round(ply.bruto).toLocaleString(APP_LOCALE) %></td></tr>
            <tr><td>Base imponible</td><td class="num"><%= APP_CUR %> <%= Math.round(ply.dpp).toLocaleString(APP_LOCALE) %></td></tr>
            <tr><td>IVA (<%= finance.ppn %>%) <span class="badge bm">se paga al fisco, no es ingreso</span></td><td class="num" style="color:var(--info)"><%= APP_CUR %> <%= Math.round(ply.ppn).toLocaleString(APP_LOCALE) %></td></tr>
            <tr><td>Gastos</td><td class="num" style="color:var(--danger)">- <%= APP_CUR %> <%= Math.round(ply.keluar).toLocaleString(APP_LOCALE) %></td></tr>
            <tr><td>USO (<%= finance.uso %>%)</td><td class="num" style="color:var(--warning)">- <%= APP_CUR %> <%= Math.round(ply.uso).toLocaleString(APP_LOCALE) %></td></tr>
            <tr><td>BHP (<%= finance.bhp %>%)</td><td class="num" style="color:var(--warning)">- <%= APP_CUR %> <%= Math.round(ply.bhp).toLocaleString(APP_LOCALE) %></td></tr>
            <tr><td class="fw6">Ganancia neta antes de impuestos</td><td class="num fw6"><%= APP_CUR %> <%= Math.round(ply.sebelumPph).toLocaleString(APP_LOCALE) %></td></tr>
            <tr><td>Impuesto a la renta (<%= finance.pph %>%)</td><td class="num" style="color:var(--danger)">- <%= APP_CUR %> <%= Math.round(ply.pph).toLocaleString(APP_LOCALE) %></td></tr>
            <tr style="background:rgba(16,185,129,.08)"><td class="fw6" style="color:#10b981">Ganancia neta después de impuestos</td><td class="num fw6" style="color:#10b981;font-size:16px"><%= APP_CUR %> <%= Math.round(ply.bersih).toLocaleString(APP_LOCALE) %></td></tr>
          </tbody>
        </table>
      </div>
      <div class="card-bd" style="padding-top:10px">
        <div class="hint">
          <i class="bi bi-info-circle"></i> Facturas anuladas este año: <b><%= voidedYearCount||0 %></b> facturas · <%= APP_CUR %> <%= (voidedYearAmount||0).toLocaleString(APP_LOCALE) %>
          — <span class="text-muted">excluidas de los ingresos (auditoría).</span>
        </div>
      </div>
    </div>

    <!-- ═══ C. REKAP PER BULAN (AUDIT) ═══ -->
    <div class="card mb16">
      <div class="card-hd"><h6><i class="bi bi-calendar3"></i> Resultado mensual <%= filterYear %> <span class="text-muted" style="font-weight:400;font-size:11.5px"><%- t('admin.rep.export_hint','— export &amp; cetak tiap bulan') %></span></h6></div>
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th>Mes</th>
              <th class="num">Ingresos</th>
              <th class="num">Gastos</th>
              <th class="num">PPN</th>
              <th class="num">USO</th>
              <th class="num">BHP</th>
              <th class="num">Ganancia antes de imp.</th>
              <th class="num">Impuesto a la renta</th>
              <th class="num">Ganancia después de imp.</th>
              <th><%= t('common.actions','Aksi') %></th>
            </tr>
          </thead>
          <tbody>
            <% const _mn = (lang === 'en') ? ['January','February','March','April','May','June','July','August','September','October','November','December'] : ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
               let _tBruto=0,_tKeluar=0,_tPpn=0,_tUso=0,_tBhp=0,_tSebelum=0,_tPph=0,_tBersih=0; %>
            <% monthlyFinance.forEach(r => { _tBruto+=r.bruto; _tKeluar+=r.keluar; _tPpn+=r.ppn; _tUso+=r.uso; _tBhp+=r.bhp; _tSebelum+=r.sebelumPph; _tPph+=r.pph; _tBersih+=r.bersih; %>
            <tr>
              <td class="fw6"><%= _mn[r.month-1] %></td>
              <td class="num"><%= APP_CUR %> <%= Math.round(r.bruto).toLocaleString(APP_LOCALE) %></td>
              <td class="num" style="color:var(--danger)"><%= APP_CUR %> <%= Math.round(r.keluar).toLocaleString(APP_LOCALE) %></td>
              <td class="num" style="color:var(--info)"><%= APP_CUR %> <%= Math.round(r.ppn).toLocaleString(APP_LOCALE) %></td>
              <td class="num" style="color:var(--warning)"><%= APP_CUR %> <%= Math.round(r.uso).toLocaleString(APP_LOCALE) %></td>
              <td class="num" style="color:var(--warning)"><%= APP_CUR %> <%= Math.round(r.bhp).toLocaleString(APP_LOCALE) %></td>
              <td class="num" style="color:var(--muted)"><%= APP_CUR %> <%= Math.round(r.sebelumPph).toLocaleString(APP_LOCALE) %></td>
              <td class="num" style="color:var(--danger)"><%= APP_CUR %> <%= Math.round(r.pph).toLocaleString(APP_LOCALE) %></td>
              <td class="num fw6" style="color:#10b981"><%= APP_CUR %> <%= Math.round(r.bersih).toLocaleString(APP_LOCALE) %></td>
              <td style="white-space:nowrap">
                <div class="act">
                  <button type="button" class="act-btn" title="Acciones" onclick="actToggle(event, this)"><i class="bi bi-three-dots-vertical"></i></button>
                  <div class="act-menu">
                    <a class="act-item" href="/admin/reports/export-csv?year=<%= filterYear %>&amp;month=<%= r.month %>"><i class="bi bi-file-earmark-excel"></i> Export Excel (CSV)</a>
                    <a class="act-item" target="_blank" href="/admin/reports/pdf?year=<%= filterYear %>&amp;month=<%= r.month %>&amp;mode=after"><i class="bi bi-file-earmark-pdf"></i> PDF de este mes</a>
                  </div>
                </div>
              </td>
            </tr>
            <% }) %>
            <tr style="background:var(--bg3)">
              <td class="fw6">TOTAL <%= filterYear %></td>
              <td class="num fw6"><%= APP_CUR %> <%= Math.round(_tBruto).toLocaleString(APP_LOCALE) %></td>
              <td class="num fw6" style="color:var(--danger)"><%= APP_CUR %> <%= Math.round(_tKeluar).toLocaleString(APP_LOCALE) %></td>
              <td class="num fw6" style="color:var(--info)"><%= APP_CUR %> <%= Math.round(_tPpn).toLocaleString(APP_LOCALE) %></td>
              <td class="num fw6" style="color:var(--warning)"><%= APP_CUR %> <%= Math.round(_tUso).toLocaleString(APP_LOCALE) %></td>
              <td class="num fw6" style="color:var(--warning)"><%= APP_CUR %> <%= Math.round(_tBhp).toLocaleString(APP_LOCALE) %></td>
              <td class="num fw6" style="color:var(--muted)"><%= APP_CUR %> <%= Math.round(_tSebelum).toLocaleString(APP_LOCALE) %></td>
              <td class="num fw6" style="color:var(--danger)"><%= APP_CUR %> <%= Math.round(_tPph).toLocaleString(APP_LOCALE) %></td>
              <td class="num fw6" style="color:#10b981"><%= APP_CUR %> <%= Math.round(_tBersih).toLocaleString(APP_LOCALE) %></td>
              <td></td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="card-bd" style="padding-top:0">
        <div class="hint"><i class="bi bi-info-circle"></i> Filas <b>TOTAL</b><%= t('admin.rep.sum_hint',' = penjumlahan tiap bulan; cocokkan dengan ') %><b>Estado de resultados</b><%= t('admin.rep.audit_hint',' (tahun) di atas untuk audit.') %></div>
      </div>
    </div>

    <!-- ═══ D. GRAFIK ═══ -->
    <div class="card mb16">
      <div class="card-hd"><h6><i class="bi bi-bar-chart"></i> <%= t('admin.reports.monthly_revenue', 'Pendapatan Bulanan') %> <%= filterYear %></h6></div>
      <div class="card-bd"><canvas id="revenueChart" height="200"></canvas></div>
    </div>

    <!-- ═══ E. DETAIL AUDIT ═══ -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px">
      <div class="card">
        <div class="card-hd"><h6><i class="bi bi-pie-chart"></i> Detalle de gastos (<%= filterYear %>)</h6></div>
        <div class="card-bd" style="padding:0">
          <% if (typeof expensesByCategory === 'undefined' || expensesByCategory.length===0) { %>
            <div class="text-center text-muted" style="padding:24px;font-size:13px">Todavía no hay gastos registrados</div>
          <% } %>
          <% if(typeof expensesByCategory !== 'undefined') expensesByCategory.forEach(c=>{ %>
          <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;gap:10px">
            <div style="font-size:13px;font-weight:600;min-width:0;overflow-wrap:anywhere"><i class="bi bi-tag" style="color:var(--muted);margin-right:6px"></i> <%= c.category %></div>
            <span class="badge" style="background:rgba(239,68,68,.1);color:#ef4444;white-space:nowrap"><%= APP_CUR %> <%= Number(c.total).toLocaleString(APP_LOCALE) %></span>
          </div>
          <% }) %>
        </div>
      </div>
      <div class="card">
        <div class="card-hd"><h6><i class="bi bi-exclamation-triangle"></i> <%= t('admin.reports.top_unpaid', 'Piutang Tertinggi') %></h6></div>
        <div class="card-bd" style="padding:0">
          <% if (topUnpaid.length===0) { %><div class="text-center text-muted" style="padding:24px;font-size:13px"><%= t('admin.reports.all_paid', 'Semua pelanggan sudah lunas') %></div><% } %>
          <% topUnpaid.slice(0,5).forEach(u=>{ %>
          <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;gap:10px">
            <div style="min-width:0"><div style="font-size:13px;font-weight:600;overflow-wrap:anywhere"><%= u.name %></div><div style="font-size:11px;color:var(--muted)"><%= u.phone %></div></div>
            <span class="badge bd" style="white-space:nowrap"><%= APP_CUR %> <%= Number(u.total_unpaid).toLocaleString(APP_LOCALE) %></span>
          </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- ═══ F. PEMBAYARAN TERAKHIR ═══ -->
    <div class="card mb16" style="margin-top:18px">
      <div class="card-hd"><h6><i class="bi bi-clock-history"></i> <%= t('admin.reports.recent_payments', 'Pembayaran Terakhir') %></h6></div>
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead><tr><th><%= t('admin.reports.table.customer','Pelanggan') %></th><th><%= t('admin.reports.table.period','Periode') %></th><th class="num"><%= t('admin.reports.table.amount','Jumlah') %></th><th><%= t('admin.reports.table.recorded_by','Dicatat Oleh') %></th><th><%= t('admin.reports.table.time','Waktu') %></th></tr></thead>
          <tbody>
          <% const mn2 = (lang === 'en') ? ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] : ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic']; %>
          <% if(recentPayments.length===0){%><tr><td colspan="5" class="text-center text-muted" style="padding:24px"><%= t('admin.reports.no_payments','Belum ada pembayaran') %></td></tr><%}%>
          <% recentPayments.forEach(p=>{ %>
            <tr>
              <td class="fw6"><%= p.customer_name %></td>
              <td><span class="badge bm"><%= mn2[p.period_month-1] %> <%= p.period_year %></span></td>
              <td class="num fw6" style="color:var(--success)"><%= APP_CUR %> <%= Number(p.amount).toLocaleString(APP_LOCALE) %></td>
              <td style="font-size:12px"><%= p.paid_by_name||'-' %></td>
              <td style="font-size:11px;color:var(--muted)"><%= p.paid_at ? new Date(p.paid_at).toLocaleString(APP_LOCALE,{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '-' %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ═══ G. PENGATURAN PAJAK & RETRIBUSI (collapsible) ═══ -->
    <details class="card">
      <summary class="card-hd"><h6 style="margin:0"><i class="bi bi-percent"></i> Configuración de impuestos <span class="text-muted" style="font-weight:400;font-size:11.5px"><%= t('admin.rep.calc_hint','— dihitung otomatis') %></span></h6></summary>
      <div class="card-bd">
        <form method="POST" action="/admin/reports/finance">
          <div class="form-row" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr))">
            <div class="fg"><label class="fl">PPN (%)</label><input class="fc" type="number" step="0.01" min="0" name="finance_ppn_pct" value="<%= finance.ppn %>"></div>
            <div class="fg"><label class="fl">Impuesto a la renta (%)</label><input class="fc" type="number" step="0.01" min="0" name="finance_pph_pct" value="<%= finance.pph %>"></div>
            <div class="fg"><label class="fl">USO (%)</label><input class="fc" type="number" step="0.01" min="0" name="finance_uso_pct" value="<%= finance.uso %>"></div>
            <div class="fg"><label class="fl">BHP (%)</label><input class="fc" type="number" step="0.01" min="0" name="finance_bhp_pct" value="<%= finance.bhp %>"></div>
            <div class="fg"><label class="fl">¿El IVA está incluido en el precio?</label>
              <select class="fs" name="finance_revenue_includes_ppn">
                <option value="0" <%= finance.inclPpn ? '' : 'selected' %>>No — se suma el IVA</option>
                <option value="1" <%= finance.inclPpn ? 'selected' : '' %>><%= t('admin.rep.ppn_incl','Ya — PPN sudah termasuk') %></option>
              </select>
            </div>
          </div>
          <button type="submit" class="btn btn-p btn-sm"><i class="bi bi-save"></i> Guardar configuración</button>
          <span class="hint" style="margin-left:10px"><%- t('admin.rep.tax_hint','PPh Badan, PPN, USO &amp; BHP dihitung otomatis dari nilai ini.') %></span>
        </form>
      </div>
    </details>

  </div>
</div>

<script>
const monthLabels = JSON.parse(`<%- JSON.stringify((lang === 'en') 
  ? ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] 
  : ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic']).split('<').join('\\u003c') %>`);
const revenueData = JSON.parse(`<%- JSON.stringify(chartData).split('<').join('\\u003c') %>`);
const labels = monthLabels;
const values = Array(12).fill(0);
revenueData.forEach(d=>{ values[d.month-1] = d.revenue; });

new Chart(document.getElementById('revenueChart'), {
  type: 'bar',
  data: {
    labels,
    datasets: [{
      label: "<%= t('admin.reports.chart.revenue_label', 'Pendapatan (Rp)') %>",
      data: values,
      backgroundColor: 'rgba(173,255,47,0.35)',
      borderColor: '#ADFF2F',
      borderWidth: 2,
      borderRadius: 6,
    }]
  },
  options: {
    responsive: true,
    plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => APP_CUR + ' ' + ctx.raw.toLocaleString(APP_LOCALE) } } },
    scales: {
      x: { ticks: { color: '#7d8590' }, grid: { color: 'rgba(240,246,252,0.05)' } },
      y: { ticks: { color: '#7d8590', callback: v => APP_CUR + ' ' + (v/1000).toFixed(0)+'k' }, grid: { color: 'rgba(240,246,252,0.05)' } }
    }
  }
});
</script>
</body>
</html>
