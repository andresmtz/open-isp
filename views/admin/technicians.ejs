<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.nav.technicians', 'Teknisi') %> | <%= company %></title>
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<%- include('partials/sidebar', { activePage: 'technicians', company }) %>

<div class="mw">
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-person-gear"></i>
      <span><%= t('admin.nav.technicians', 'Teknisi') %></span>
    </div>
    <div class="tb-right">
      <span class="adm-badge">
        <i class="bi bi-person-fill"></i> 
        <%= (typeof session !== 'undefined' && session && session.isCashier) ? ((session.cashierName ? session.cashierName + ' · ' : '') + t('admin.role.cashier', 'Oficina')) : t('admin.role.admin', 'Admin') %>
      </span>
      <button class="btn btn-p btn-sm" onclick="openModal('addTechModal')"><i class="bi bi-plus-lg"></i> <%= t('admin.technicians.add', 'Tambah Teknisi') %></button>
    </div>
  </div>

  <div class="page">
    <% if (msg) { %>
      <div class="alert alert-<%= msg.type==='error'?'d':'s' %>" data-flash="1"><%= msg.text %></div>
    <% } %>

    <div class="card">
      <div class="card-hd">
        <h6><i class="bi bi-list-ul"></i> <%= t('admin.technicians.list', 'Daftar Teknisi Lapangan') %></h6>
      </div>
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th><%= t('admin.technicians.table.name', 'Nama') %></th>
              <th><%= t('admin.technicians.table.username', 'Username') %></th>
              <th><%= t('admin.technicians.table.whatsapp', 'WhatsApp') %></th>
              <th><%= t('admin.technicians.table.area', 'Area Tugas') %></th>
              <th>Permisos</th>
              <th><%= t('admin.technicians.table.status', 'Status') %></th>
              <th><%= t('admin.technicians.table.actions', 'Aksi') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (technicians.length === 0) { %>
              <tr><td colspan="7" class="text-center text-muted" style="padding:20px"><%= t('admin.technicians.empty', 'Belum ada data teknisi.') %></td></tr>
            <% } else { %>
            <% technicians.forEach(tech => { %>
                <tr>
                  <td><strong><%= tech.name %></strong></td>
                  <td><code><%= tech.username %></code></td>
                  <td><%= tech.phone || '-' %></td>
                  <td><%= tech.area || '-' %></td>
                  <td style="max-width:380px;font-size:12px"><% if (tech.permSummary.length) { %><%= tech.permSummary.join(' · ') %><% } else { %><span class="text-muted">Solo sus reclamos asignados</span><% } %></td>
                  <td>
                    <span class="badge <%= tech.is_active ? 'bs' : 'bd' %>">
                      <%= tech.is_active ? t('common.active', 'Aktif') : t('common.inactive', 'Nonaktif') %>
                    </span>
                  </td>
                  <td style="white-space:nowrap">
                    <form id="tdel-<%= tech.id %>" action="/admin/technicians/<%= tech.id %>/delete" method="POST" style="display:none" onsubmit="return confirm(I18N.confirmDeleteTechnician)"></form>
                    <div class="act">
                      <button type="button" class="act-btn" title="Aksi" onclick="actToggle(event, this)"><i class="bi bi-three-dots-vertical"></i></button>
                      <div class="act-menu">
                        <button type="button" class="act-item primary" onclick='openPerms(<%- JSON.stringify({ id: tech.id, name: tech.name, perms: tech.perms }).split("<").join("\\u003c").split("'").join("\\u0027") %>)'><i class="bi bi-shield-check"></i> Permisos</button>
                        <button type="button" class="act-item" onclick='editTech(<%- JSON.stringify(tech).split('<').join('\\u003c') %>)'><i class="bi bi-pencil"></i> Editar técnico</button>
                        <div class="act-sep"></div>
                        <button type="submit" form="tdel-<%= tech.id %>" class="act-item danger"><i class="bi bi-trash"></i> Eliminar técnico</button>
                      </div>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal Tambah -->
<div class="mo" id="addTechModal">
  <div class="mb" style="max-width:820px">
    <form action="/admin/technicians" method="POST">
      <div class="mh"><span class="mt"><%= t('admin.technicians.modal.add_title', 'Tambah Teknisi Baru') %></span><button type="button" class="mc" onclick="closeModal('addTechModal')">&times;</button></div>
      <div class="mbody">
        <div class="fg"><label class="fl"><%= t('admin.technicians.form.full_name', 'Nama Lengkap') %></label><input type="text" name="name" class="fc" required></div>
        <div class="fg"><label class="fl"><%= t('admin.technicians.form.login_username', 'Username Login') %></label><input type="text" name="username" class="fc" required></div>
        <div class="fg"><label class="fl"><%= t('admin.technicians.form.password', 'Password') %></label><input type="password" name="password" class="fc" required minlength="8" autocomplete="new-password"><div style="font-size:11px;color:var(--muted);margin-top:3px">Mínimo 8 caracteres. Se guarda cifrada.</div></div>
        <div class="fg"><label class="fl"><%= t('admin.technicians.form.whatsapp', 'No. WhatsApp') %></label><input type="text" name="phone" class="fc" placeholder="<%= t('admin.technicians.form.whatsapp_placeholder', 'Contoh: 08123456789') %>"></div>
        <div class="fg"><label class="fl"><%= t('admin.technicians.form.area', 'Area Tugas') %></label><input type="text" name="area" class="fc" placeholder="<%= t('admin.technicians.form.area_placeholder', 'Contoh: Kelurahan A, Blok B') %>"></div>
        <div class="fg"><label class="fl">Permisos</label><div style="font-size:11.5px;color:var(--muted);margin-bottom:6px">Arranca solo con sus reclamos asignados: marcá lo demás que necesite.</div>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:8px">
            <% permCatalog.forEach(function (p) { %>
              <label style="display:flex;gap:9px;align-items:flex-start;border:1px solid var(--border);border-radius:10px;padding:8px 10px;cursor:pointer">
                <input type="checkbox" name="perm_<%= p.key %>" value="1" data-key="<%= p.key %>" class="perm-cb" style="margin-top:3px">
                <span><strong style="font-size:12.5px"><%= p.label %></strong><br><span style="font-size:11.5px;color:var(--muted)"><%= p.help %></span></span>
              </label>
            <% }) %>
          </div>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('addTechModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><%= t('common.save', 'Simpan') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit -->
<div class="mo" id="editTechModal">
  <div class="mb">
    <form id="editForm" method="POST">
      <div class="mh"><span class="mt"><%= t('admin.technicians.modal.edit_title', 'Edit Data Teknisi') %></span><button type="button" class="mc" onclick="closeModal('editTechModal')">&times;</button></div>
      <div class="mbody">
        <div class="fg"><label class="fl"><%= t('admin.technicians.form.full_name', 'Nama Lengkap') %></label><input type="text" name="name" id="e-name" class="fc" required></div>
        <div class="fg"><label class="fl"><%= t('admin.technicians.form.login_username', 'Username Login') %></label><input type="text" name="username" id="e-username" class="fc" required></div>
        <div class="fg"><label class="fl"><%= t('admin.technicians.form.password', 'Password') %></label><input type="password" name="password" id="e-password" class="fc" minlength="8" autocomplete="new-password" placeholder="Dejar vacío para no cambiarla"></div>
        <div class="fg"><label class="fl"><%= t('admin.technicians.form.whatsapp', 'No. WhatsApp') %></label><input type="text" name="phone" id="e-phone" class="fc"></div>
        <div class="fg"><label class="fl"><%= t('admin.technicians.form.area', 'Area Tugas') %></label><input type="text" name="area" id="e-area" class="fc"></div>
        <div class="fg">
          <label class="fl"><%= t('admin.technicians.form.account_status', 'Estado de la cuenta') %></label>
          <select name="is_active" id="e-status" class="fs">
            <option value="1"><%= t('common.active', 'Aktif') %></option>
            <option value="0"><%= t('common.inactive', 'Nonaktif') %></option>
          </select>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('editTechModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><%= t('admin.technicians.save_changes', 'Guardar cambios') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Permisos -->
<div class="mo" id="permsModal">
  <div class="mb" style="max-width:820px">
    <form id="permsForm" method="POST">
      <div class="mh"><span class="mt"><i class="bi bi-shield-check"></i> Permisos de <span id="p-name"></span></span><button type="button" class="mc" onclick="closeModal('permsModal')">&times;</button></div>
      <div class="mbody">
        <div style="font-size:12px;color:var(--muted);margin-bottom:10px">Siempre puede: ver y trabajar los reclamos que vos le asignás, su historial y marcar asistencia. Nunca ve montos (precios, deudas, pagos) ni contraseñas de clientes.</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:8px">
            <% permCatalog.forEach(function (p) { %>
              <label style="display:flex;gap:9px;align-items:flex-start;border:1px solid var(--border);border-radius:10px;padding:8px 10px;cursor:pointer">
                <input type="checkbox" name="perm_<%= p.key %>" value="1" data-key="<%= p.key %>" class="perm-cb" style="margin-top:3px">
                <span><strong style="font-size:12.5px"><%= p.label %></strong><br><span style="font-size:11.5px;color:var(--muted)"><%= p.help %></span></span>
              </label>
            <% }) %>
          </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('permsModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> Guardar permisos</button>
      </div>
    </form>
  </div>
</div>

<script>
function openPerms(c) {
  var f = document.getElementById('permsForm');
  f.action = '/admin/technicians/' + c.id + '/permissions';
  document.getElementById('p-name').textContent = c.name;
  f.querySelectorAll('.perm-cb').forEach(function (cb) { cb.checked = !!(c.perms && c.perms[cb.dataset.key]); });
  openModal('permsModal');
}
const I18N = {
  confirmDeleteTechnician: "<%= t('admin.technicians.confirm_delete', 'Hapus teknisi ini?') %>"
};

function openModal(id) { document.getElementById(id).classList.add('show'); }
function closeModal(id) { document.getElementById(id).classList.remove('show'); }
function editTech(t) {
  document.getElementById('editForm').action = '/admin/technicians/' + t.id + '/update';
  document.getElementById('e-name').value = t.name;
  document.getElementById('e-username').value = t.username;
  document.getElementById('e-password').value = '';
  document.getElementById('e-phone').value = t.phone || '';
  document.getElementById('e-area').value = t.area || '';
  document.getElementById('e-status').value = t.is_active;
  openModal('editTechModal');
}
</script>
</body>
</html>
