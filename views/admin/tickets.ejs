<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.nav.customer_tickets', 'Keluhan Pelanggan') %> | <%= company %></title>
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<%- include('partials/sidebar', { activePage: 'tickets', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-headset"></i> <%= t('admin.nav.customer_tickets', 'Keluhan Pelanggan') %></div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? ((session.cashierName ? session.cashierName + ' · ' : '') + t('admin.role.cashier', 'Oficina')) : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">

    <% if (msg) { %>
    <div class="alert alert-<%= msg.type==='success'?'s':'d' %>" data-flash="1">
      <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-circle' %>"></i> <%= msg.text %>
    </div>
    <% } %>

    <!-- Summary Cards -->
    <div class="stat-grid" style="grid-template-columns:repeat(4,1fr)">
      <div class="sc p"><i class="bi bi-ticket-detailed sc-icon"></i><div class="sc-label"><%= t('admin.tickets.stats.total', 'Total Tiket') %></div><div class="sc-val"><%= stats.total %></div></div>
      <div class="sc d"><i class="bi bi-exclamation-circle sc-icon"></i><div class="sc-label"><%= t('admin.tickets.status.open', 'Belum Ditangani') %></div><div class="sc-val"><%= stats.open %></div></div>
      <div class="sc w"><i class="bi bi-tools sc-icon"></i><div class="sc-label"><%= t('admin.tickets.status.in_progress', 'Sedang Dikerjakan') %></div><div class="sc-val"><%= stats.inProgress %></div></div>
      <div class="sc s"><i class="bi bi-check-circle sc-icon"></i><div class="sc-label"><%= t('admin.tickets.status.resolved', 'Selesai') %></div><div class="sc-val"><%= stats.resolved %></div></div>
    </div>

    <!-- Print Header (Only visible on paper print) -->
    <div class="print-only" style="margin-bottom:14px;border-bottom:2px solid #0f172a;padding-bottom:10px">
      <div style="display:flex;justify-content:space-between;align-items:flex-start">
        <div>
          <h2 style="font-size:16pt;font-weight:800;text-transform:uppercase;margin:0"><%= company %></h2>
          <div style="font-size:10pt;color:#334155"><%= t('admin.nav.customer_tickets', 'Daftar Tiket Gangguan & Tugas Teknisi') %> &bull; Estado: <%= filterStatus ? filterStatus.toUpperCase() : 'TODOS' %></div>
        </div>
        <div style="text-align:right;font-size:8.5pt;color:#475569">
          <div>Impreso: <%= typeof getNowLocal === 'function' ? getNowLocal() : (typeof formatDateLocal === 'function' ? formatDateLocal(new Date()) : new Date().toLocaleString(APP_LOCALE)) %></div>
          <div>Total de tickets: <strong><%= tickets.length %> Kasus</strong></div>
        </div>
      </div>
    </div>

    <!-- Filter -->
    <div class="card">
      <div class="card-hd" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
        <h6><i class="bi bi-list-ul"></i> <%= t('admin.tickets.list_title', 'Daftar Keluhan & Tugas') %> (<%= tickets.length %>)</h6>
        <div style="display:flex;gap:8px">
          <button type="button" class="btn btn-g btn-sm" onclick="window.print()" title="Imprimir resumen de tickets"><i class="bi bi-printer"></i> Imprimir</button>
          <button class="btn btn-p btn-sm" onclick="openModal('createTicketModal')">
            <i class="bi bi-plus-circle me-1"></i> + Crear ticket / tarea
          </button>
        </div>
      </div>
      <div class="card-bd" style="padding-bottom:0">
        <form method="GET" action="/admin/tickets" class="srow" style="margin-bottom:18px">
          <div class="sinput" style="max-width:340px">
            <i class="bi bi-search"></i>
            <input class="fc" name="search" placeholder="Buscar cliente / asunto / mensaje..." value="<%= (typeof filterSearch!=='undefined'?filterSearch:'') %>">
          </div>
          <select class="fs" name="tech_id" style="width:180px" onchange="this.form.submit()">
            <option value=""><%= t('admin.tk.all_techs','Semua Teknisi') %></option>
            <% (typeof technicians!=='undefined'?technicians:[]).forEach(t => { %><option value="<%= t.id %>" <%= (typeof filterTech!=='undefined' && String(filterTech)===String(t.id))?'selected':'' %>><%= t.name %></option><% }) %>
          </select>
          <select class="fs" name="status" style="width:160px" onchange="this.form.submit()">
            <option value="all" <%= filterStatus==='all'?'selected':'' %>><%= t('common.all_status', 'Semua Status') %></option>
            <option value="open" <%= filterStatus==='open'?'selected':'' %>><%= t('admin.tickets.status.open', 'Belum Ditangani') %></option>
            <option value="in_progress" <%= filterStatus==='in_progress'?'selected':'' %>><%= t('admin.tickets.status.in_progress', 'Sedang Dikerjakan') %></option>
            <option value="resolved" <%= filterStatus==='resolved'?'selected':'' %>><%= t('admin.tickets.status.resolved', 'Selesai') %></option>
          </select>
          <button class="btn btn-g btn-sm" type="submit"><i class="bi bi-search"></i> Buscar</button>
          <% if ((typeof filterSearch!=='undefined' && filterSearch) || (typeof filterTech!=='undefined' && filterTech) || (filterStatus && filterStatus!=='all')) { %><a href="/admin/tickets" class="btn btn-g btn-sm"><i class="bi bi-x"></i> Reset</a><% } %>
        </form>
      </div>
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th>#ID</th>
              <th><%= t('admin.tickets.table.time', 'Waktu') %></th>
              <th><%= t('admin.tickets.table.customer', 'Pelanggan') %></th>
              <th><%= t('admin.tickets.table.issue', 'Kendala') %></th>
              <th><%= t('admin.tickets.table.technician', 'Teknisi') %></th>
              <th><%= t('admin.tickets.table.status', 'Status') %></th>
              <th><%= t('common.actions', 'Aksi') %></th>
            </tr>
          </thead>
          <tbody>
          <% if (tickets.length===0) { %>
            <tr><td colspan="7" class="text-center text-muted" style="padding:32px"><%= t('admin.tickets.empty', 'Tidak ada tiket keluhan') %></td></tr>
          <% } %>
          <% tickets.forEach((ticket) => { %>
            <tr>
              <td class="text-muted">#<%= ticket.id %></td>
              <td style="font-size:12px;color:var(--muted)">
                <%= typeof formatDateLocal === 'function' ? formatDateLocal(ticket.created_at) : (ticket.created_at ? new Date(ticket.created_at).toLocaleString(APP_LOCALE, {dateStyle:'short', timeStyle:'short'}) : '-') %>
              </td>
              <td>
                <div class="fw6"><%= ticket.customer_name %></div>
                <div style="font-size:11px;color:var(--muted)"><%= ticket.customer_phone || '-' %></div>
              </td>
              <td><a href="javascript:void(0)" style="color:var(--primary);text-decoration:none" onclick="tkDetail(<%= ticket.id %>)" title="Ver detalle"><%= ticket.subject %></a></td>
              <td>
                <% if (ticket.technician_name) { %>
                  <div class="fw6" style="font-size:12px"><i class="bi bi-person-badge me-1"></i><%= ticket.technician_name %></div>
                <% } else { %>
                  <% if (['open','in_progress'].indexOf(ticket.status) !== -1) { %>
                    <button type="button" class="btn btn-sm btn-g" style="padding:3px 10px;font-size:12px" title="Elegir el técnico que atiende este reclamo" onclick="document.querySelector('.update-btn[data-id=&quot;<%= ticket.id %>&quot;]').click()"><i class="bi bi-person-plus"></i> Asignar técnico</button>
                  <% } else { %>
                  <span class="text-muted small"><%= t('admin.tickets.no_technician', 'No existe') %></span>
                  <% } %>
                <% } %>
              </td>
              <td>
                <% if(ticket.status==='open'){%><span class="badge bd"><%= t('admin.tickets.status.open', 'Belum Ditangani') %></span>
                <%}else if(ticket.status==='in_progress'){%><span class="badge bw"><%= t('admin.tickets.status.working_short', 'Dikerjakan') %></span>
                <%}else{%><span class="badge bs"><%= t('admin.tickets.status.resolved', 'Selesai') %></span><%}%>
              </td>
              <td style="white-space:nowrap">
                <form id="tdel-<%= ticket.id %>" method="POST" action="/admin/tickets/<%= ticket.id %>/delete" style="display:none" onsubmit="return confirm('<%= t('admin.tickets.confirm.delete', 'Hapus keluhan ini?') %>')"></form>
                <div class="act">
                  <button type="button" class="act-btn" title="Acciones" onclick="actToggle(event, this)"><i class="bi bi-three-dots-vertical"></i></button>
                  <div class="act-menu">
                    <button type="button" class="btn act-item primary" onclick="tkDetail(<%= ticket.id %>)"><i class="bi bi-card-text"></i> Ver detalle<%= ['open','in_progress'].indexOf(ticket.status) !== -1 ? ' / agregar información' : '' %></button>
                    <button class="btn act-item update-btn" title="<%= t('admin.tickets.actions.update_status', 'Actualizar estado') %>"
                      data-id="<%= ticket.id %>" data-status="<%= ticket.status %>" data-message="<%= ticket.message %>"
                      data-subject="<%= ticket.subject %>" data-customer="<%= ticket.customer_name %>"
                      data-notes="<%= ticket.technician_notes || '' %>" data-photos="<%= ticket.photos || '' %>"
                      data-customer-photos="<%= ticket.customer_photos || '' %>" data-tech-id="<%= ticket.technician_id || '' %>"
                      data-tech="<%= ticket.technician_name || t('admin.tickets.no_technician', 'No existe') %>"><i class="bi bi-person-gear"></i> Asignar técnico / cambiar estado</button>
                    <% if ((ticket.photos && ticket.photos !== '' && ticket.photos !== '[]') || (ticket.customer_photos && ticket.customer_photos !== '' && ticket.customer_photos !== '[]')) { %>
                    <button class="btn act-item primary view-photos-btn" title="Ver foto"
                      data-id="<%= ticket.id %>" data-photos="<%= ticket.photos || '' %>"
                      data-customer-photos="<%= ticket.customer_photos || '' %>"
                      data-customer="<%= ticket.customer_name %>" data-subject="<%= ticket.subject %>"><i class="bi bi-images"></i> <%= t('admin.common.view_photo','Ver foto') %></button>
                    <% } %>
                    <div class="act-sep"></div>
                    <button type="submit" form="tdel-<%= ticket.id %>" class="act-item danger"><i class="bi bi-trash"></i> Eliminar reclamo</button>
                  </div>
                </div>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal Buat Tiket / Tugas Baru -->
<div class="mo" id="createTicketModal">
  <div class="mb">
    <div class="mh">
      <span class="mt"><i class="bi bi-plus-circle me-1"></i> Crear ticket / tarea para técnicos</span>
      <button class="mc" onclick="closeModal('createTicketModal')">&times;</button>
    </div>
    <form method="POST" action="/admin/tickets/create">
      <div class="mbody">
        <div class="fg">
          <label class="fl">Elegir cliente (opcional)</label>
          <select class="fs" name="customer_id" id="createCustomerId">
            <option value="0"><%= t('admin.tk.general_task','-- Tugas Umum / Non-Pelanggan (Maintenance) --') %></option>
            <% if (typeof customers !== 'undefined' && customers) { %>
              <% customers.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.name %> (<%= c.phone || '-' %>) - <%= c.address || '' %></option>
              <% }) %>
            <% } %>
          </select>
        </div>
        <div class="fg">
          <label class="fl">Título / asunto del problema</label>
          <input class="fc" name="subject" placeholder="Ejemplo: reparación NAP 02, tendido de cable nuevo, señal muy baja" required>
        </div>
        <div class="fg">
          <label class="fl">Detalle / instrucciones de la tarea</label>
          <textarea class="fc" name="message" rows="3" placeholder="Escribí con claridad el detalle del trabajo o las instrucciones para el técnico..." required></textarea>
        </div>
        <div class="fg">
          <label class="fl">Asignar a un técnico (opcional)</label>
          <select class="fs" name="technician_id">
            <option value=""><%= t('admin.tk.unassigned','-- Belum Ditugaskan (Bebas) --') %></option>
            <% if (typeof technicians !== 'undefined' && technicians) { %>
              <% technicians.forEach(t => { %>
                <option value="<%= t.id %>"><%= t.name %> (<%= t.phone || '-' %>)</option>
              <% }) %>
            <% } %>
          </select>
        </div>
        <div class="fg">
          <label class="fl">Estado inicial</label>
          <select class="fs" name="status">
            <option value="open"><%= t('admin.tk.st_open','Belum Ditangani (Open)') %></option>
            <option value="in_progress"><%= t('admin.tk.st_progress','Sedang Dikerjakan (In Progress)') %></option>
          </select>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('createTicketModal')"><%= t('common.cancel','Batal') %></button>
        <button type="submit" class="btn btn-p"><i class="bi bi-send me-1"></i> Guardar y asignar</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Update -->
<div class="mo" id="updateModal">
  <div class="mb">
    <div class="mh"><span class="mt"><i class="bi bi-pencil"></i> <%= t('admin.tickets.modal.title', 'Update Status Keluhan') %></span><button class="mc" onclick="closeModal('updateModal')">&times;</button></div>
    <form method="POST" id="updateForm">
      <div class="mbody">
        <div class="fg"><label class="fl"><%= t('admin.tickets.table.customer', 'Pelanggan') %></label><input class="fc" id="upCustomer" readonly></div>
        <div class="fg"><label class="fl"><%= t('admin.tickets.table.issue', 'Kendala') %></label><input class="fc" id="upSubject" readonly></div>
        <div class="fg">
          <label class="fl"><i class="bi bi-person-badge me-1"></i><%= t('admin.tickets.table.technician', 'Tugaskan ke Teknisi') %></label>
          <select class="fs" name="technician_id" id="upTechnicianId">
            <option value=""><%= t('admin.tk.unassigned','-- Belum Ditugaskan (Bebas) --') %></option>
            <% if (typeof technicians !== 'undefined' && technicians) { %>
              <% technicians.forEach(t => { %>
                <option value="<%= t.id %>"><%= t.name %> (<%= t.phone || '-' %>)</option>
              <% }) %>
            <% } %>
          </select>
        </div>
        <div class="fg"><label class="fl"><%= t('admin.tickets.modal.message', 'Detail Pesan') %></label><textarea class="fc" id="upMessage" rows="3" readonly></textarea></div>
        <div class="fg" id="techNotesContainer" style="display:none;">
          <label class="fl"><i class="bi bi-pencil-square me-1"></i>Notas del técnico</label>
          <textarea class="fc" id="upNotes" rows="3" readonly style="background:#f8f9fa"></textarea>
        </div>
        <div class="fg">
          <label class="fl"><%= t('admin.tickets.actions.update_status', 'Actualizar estado') %></label>
          <select class="fs" name="status" id="upStatus">
            <option value="open"><%= t('admin.tickets.status.open', 'Belum Ditangani') %></option>
            <option value="in_progress"><%= t('admin.tickets.status.in_progress', 'Sedang Dikerjakan') %></option>
            <option value="resolved"><%= t('admin.tickets.status.resolved', 'Selesai') %></option>
          </select>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('updateModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> <%= t('admin.tickets.actions.save_changes', 'Guardar cambios') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Photo Gallery -->
<div class="mo" id="tkDetailModal">
  <div class="mb" style="max-width:640px">
    <div class="mh"><span class="mt" id="tkdTitle"><i class="bi bi-card-text"></i> Ticket</span><button type="button" class="mc" onclick="closeModal('tkDetailModal')">&times;</button></div>
    <div class="mbody" id="tkdBody" style="max-height:72vh;overflow-y:auto">Cargando…</div>
  </div>
</div>
<script>
(function(){
  var esc = function(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); };
  var mp = function(p){ return String(p || '').replace('/uploads/tickets/', '/admin/media/ticket/').replace('/uploads/payment_proofs/', '/admin/media/payment-proof/'); };
  var ST = { open: '<span class="badge bd">Abierto</span>', in_progress: '<span class="badge bw">En curso</span>', resolved: '<span class="badge bs">Resuelto</span>' };
  var fdt = function(v){ var d = new Date(String(v || '').replace(' ', 'T')); return isNaN(d) ? (v || '-') : d.toLocaleString(APP_LOCALE, { dateStyle: 'short', timeStyle: 'short' }); };
  var cur = 0;
  window.tkDetail = function(id){
    cur = id;
    document.getElementById('tkdTitle').innerHTML = '<i class="bi bi-card-text"></i> Ticket #' + id;
    document.getElementById('tkdBody').innerHTML = 'Cargando…';
    openModal('tkDetailModal');
    fetch('/admin/tickets/' + id + '/detail').then(function(r){ return r.json(); }).then(function(d){
      if (!d.ok) { document.getElementById('tkdBody').textContent = d.message || 'No disponible'; return; }
      var t = d.ticket, c = d.customer, h = '';
      h += '<div style="display:flex;justify-content:space-between;gap:8px;align-items:flex-start;margin-bottom:10px"><div style="font-size:15px;font-weight:800;color:var(--primary)">' + esc(t.subject) + '</div><div>' + (ST[t.status] || esc(t.status)) + '</div></div>';
      h += '<div style="display:grid;grid-template-columns:auto 1fr;gap:4px 12px;font-size:13px;margin-bottom:12px">' +
        '<span class="text-muted">Cliente</span><span>' + (c ? '<b>' + esc(c.name) + '</b> <span class="text-muted">' + esc(c.customer_code || '') + '</span>' : 'Tarea general') + '</span>' +
        (c ? '<span class="text-muted">Teléfono</span><span>' + esc(c.phone || '-') + (c.phone ? ' · <a target="_blank" href="https://wa.me/' + esc(String(c.phone).replace(/\D/g, '').replace(/^0/, '595')) + '">WhatsApp</a>' : '') + '</span>' : '') +
        (c ? '<span class="text-muted">Dirección</span><span>' + esc(c.address || '-') + (c.lat && c.lng ? ' · <a target="_blank" href="https://www.google.com/maps?q=' + esc(c.lat + ',' + c.lng) + '"><i class="bi bi-geo-alt-fill"></i> mapa</a>' : '') + '</span>' : '') +
        '<span class="text-muted">Técnico</span><span>' + (d.technician ? esc(d.technician.name) : '<span class="text-muted">Sin asignar</span>') + '</span>' +
        '<span class="text-muted">Creado</span><span>' + esc(fdt(t.created_at)) + '</span>' +
        '<span class="text-muted">Última actualización</span><span>' + esc(fdt(t.updated_at)) + '</span></div>';
      h += '<div class="vd-sec-title" style="font-size:12px;font-weight:700;color:var(--primary);text-transform:uppercase;margin:6px 0">Problema / tarea</div><div style="white-space:pre-wrap;font-size:13px;padding:10px;border:1px solid var(--border);border-radius:8px;background:var(--bg3)">' + esc(t.message) + '</div>';
      if (t.technician_notes) h += '<div style="font-size:12px;font-weight:700;color:var(--primary);text-transform:uppercase;margin:12px 0 6px">Notas del técnico</div><div style="white-space:pre-wrap;font-size:13px;padding:10px;border:1px solid var(--border);border-radius:8px">' + esc(t.technician_notes) + '</div>';
      var ph = (t.photos || []).map(mp), cph = (t.customer_photos || []).map(mp);
      if (ph.length || cph.length) h += '<div style="font-size:12px;font-weight:700;color:var(--primary);text-transform:uppercase;margin:12px 0 6px">Fotos</div><div style="display:flex;gap:6px;flex-wrap:wrap">' +
        ph.concat(cph).map(function(u){ return '<a href="' + esc(u) + '" target="_blank"><img src="' + esc(u) + '" style="width:110px;height:110px;object-fit:cover;border-radius:8px;border:1px solid var(--border)"></a>'; }).join('') + '</div>';
      h += '<div style="font-size:12px;font-weight:700;color:var(--primary);text-transform:uppercase;margin:14px 0 6px">Información agregada</div>';
      h += (d.notes || []).length ? d.notes.map(function(n){
        return '<div style="padding:8px 10px;border-left:3px solid var(--primary);background:rgba(173,255,47,.05);border-radius:6px;margin-bottom:6px;font-size:13px"><div style="white-space:pre-wrap">' + esc(n.text) + '</div>' +
          '<div class="text-muted" style="font-size:11px;margin-top:3px">' + esc(n.author || '') + ' · ' + esc(fdt(n.created_at)) + (n.notified ? ' · <i class="bi bi-whatsapp"></i> avisado al técnico' : '') + '</div></div>';
      }).join('') : '<div class="text-muted" style="font-size:12.5px">Todavía no se agregó información.</div>';
      if (t.status === 'open' || t.status === 'in_progress') {
        h += '<div style="margin-top:10px"><textarea class="fc" id="tkdNote" rows="3" maxlength="2000" placeholder="Ej.: el cliente pide que vayan después de las 14 h; llevar conector extra; la caja NAP está en el poste de la esquina…"></textarea>' +
          '<div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:6px;flex-wrap:wrap">' +
          (d.technician ? '<label style="font-size:12.5px;display:flex;gap:6px;align-items:center"><input type="checkbox" id="tkdNotify" checked> Avisar a ' + esc(d.technician.name) + ' por WhatsApp</label>' : '<span class="text-muted" style="font-size:12px">Sin técnico asignado: queda solo en el ticket.</span>') +
          '<button type="button" class="btn btn-p btn-sm" id="tkdSave" onclick="tkAddNote()"><i class="bi bi-plus-lg"></i> Agregar información</button></div></div>';
      }
      document.getElementById('tkdBody').innerHTML = h;
    }).catch(function(){ document.getElementById('tkdBody').textContent = 'No se pudo cargar el ticket.'; });
  };
  window.tkAddNote = function(){
    var ta = document.getElementById('tkdNote'), b = document.getElementById('tkdSave'), n = document.getElementById('tkdNotify');
    if (!ta.value.trim()) return;
    b.disabled = true;
    fetch('/admin/tickets/' + cur + '/note', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text: ta.value, notify: !!(n && n.checked) }) })
      .then(function(r){ return r.json(); }).then(function(d){
        b.disabled = false;
        if (window.notify) window.notify(d.ok ? 'success' : 'error', d.ok ? 'Listo' : 'Error', d.message); else alert(d.message);
        if (d.ok) tkDetail(cur);
      }).catch(function(){ b.disabled = false; });
  };
})();
</script>
<div class="mo" id="photoModal">
  <div class="mb" style="max-width:900px">
    <div class="mh">
      <span class="mt"><i class="bi bi-images"></i> Fotos del trabajo</span>
      <button class="mc" onclick="closeModal('photoModal')">&times;</button>
    </div>
    <div class="mbody">
      <div class="mb-3">
        <div class="fw-bold" id="photoCustomer"></div>
        <div class="text-muted small" id="photoSubject"></div>
      </div>
      <div id="photoGallery" class="row g-2"></div>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g" onclick="closeModal('photoModal')"><%= t('common.close','Tutup') %></button>
    </div>
  </div>
</div>

<script>
function openModal(id){document.getElementById(id).classList.add('show')}
function closeModal(id){document.getElementById(id).classList.remove('show')}
document.querySelectorAll('.mo').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('show')}));

document.addEventListener('click', function(e) {
  const btn = e.target.closest('.update-btn');
  if (!btn) return;
  
  document.getElementById('updateForm').action = '/admin/tickets/' + btn.dataset.id + '/update';
  document.getElementById('upStatus').value = btn.dataset.status;
  document.getElementById('upMessage').value = btn.dataset.message;
  document.getElementById('upSubject').value = btn.dataset.subject;
  document.getElementById('upCustomer').value = btn.dataset.customer;
  const upTechSelect = document.getElementById('upTechnicianId');
  if (upTechSelect) upTechSelect.value = btn.dataset.techId || '';
  
  // Show technician notes if available
  const notes = btn.dataset.notes || '';
  const notesContainer = document.getElementById('techNotesContainer');
  if (notes && notes.trim() !== '') {
    document.getElementById('upNotes').value = notes;
    notesContainer.style.display = 'block';
  } else {
    notesContainer.style.display = 'none';
  }
  
  openModal('updateModal');
});

// View photos
document.addEventListener('click', function(e) {
  const btn = e.target.closest('.view-photos-btn');
  if (!btn) return;
  
  const _mp = (p) => String(p || '').replace('/uploads/tickets/', '/admin/media/ticket/').replace('/uploads/payment_proofs/', '/admin/media/payment-proof/');
  const techPhotos = JSON.parse(btn.dataset.photos || '[]').map(_mp);
  const customerPhotos = JSON.parse(btn.dataset.customerPhotos || '[]').map(_mp);
  const customer = btn.dataset.customer;
  const subject = btn.dataset.subject;
  
  document.getElementById('photoCustomer').textContent = customer;
  document.getElementById('photoSubject').textContent = subject;
  
  const gallery = document.getElementById('photoGallery');
  gallery.innerHTML = '';
  
  const allPhotos = [...customerPhotos, ...techPhotos];
  
  if (allPhotos.length === 0) {
    gallery.innerHTML = '<div class="col-12 text-center text-muted"><%= t('admin.tk.no_photo','Tidak ada foto') %></div>';
  } else {
    // Customer photos first
    if (customerPhotos.length > 0) {
      const customerSection = document.createElement('div');
      customerSection.className = 'col-12 mb-3';
      customerSection.innerHTML = '<h6 class="text-primary mb-2"><i class="bi bi-person-circle me-1"></i>Fotos del cliente</h6>';
      gallery.appendChild(customerSection);
      
      customerPhotos.forEach((photo, index) => {
        const col = document.createElement('div');
        col.className = 'col-md-4 col-6';
        col.innerHTML = `
          <div class="position-relative">
            <a href="${photo}" target="_blank">
              <img src="${photo}" class="img-fluid rounded" style="width:100%; height:200px; object-fit:cover; border:2px solid #3b82f6; cursor:pointer;">
            </a>
            <span class="position-absolute top-0 start-0 badge bg-primary m-2">P${index + 1}</span>
          </div>
        `;
        gallery.appendChild(col);
      });
    }
    
    // Technician photos
    if (techPhotos.length > 0) {
      const techSection = document.createElement('div');
      techSection.className = 'col-12 mb-3 mt-3';
      techSection.innerHTML = '<h6 class="text-success mb-2"><i class="bi bi-tools me-1"></i>Fotos del técnico</h6>';
      gallery.appendChild(techSection);
      
      techPhotos.forEach((photo, index) => {
        const col = document.createElement('div');
        col.className = 'col-md-4 col-6';
        col.innerHTML = `
          <div class="position-relative">
            <a href="${photo}" target="_blank">
              <img src="${photo}" class="img-fluid rounded" style="width:100%; height:200px; object-fit:cover; border:2px solid #10b981; cursor:pointer;">
            </a>
            <span class="position-absolute top-0 start-0 badge bg-success m-2">T${index + 1}</span>
          </div>
        `;
        gallery.appendChild(col);
      });
    }
  }
  
  openModal('photoModal');
});

setTimeout(()=>document.querySelectorAll('.alert').forEach(a=>a.style.display='none'),5000);
</script>
</body>
</html>
