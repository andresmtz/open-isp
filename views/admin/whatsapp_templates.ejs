<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> | <%= company %></title>
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .wa-tabs { display: flex; gap: 8px; margin-bottom: 14px; border-bottom: 1px solid var(--border); padding-bottom: 10px; overflow-x: auto; -webkit-overflow-scrolling: touch; white-space: nowrap; }
    .wa-tab { padding: 8px 14px; border-radius: 8px; cursor: pointer; color: var(--muted); transition: all 0.2s; font-weight: 700; text-decoration: none; flex-shrink: 0; }
    .wa-tab:hover { background: rgba(255,255,255,0.06); color: var(--text); }
    .wa-tab.active { background: var(--primary); color: white; }
    .template-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    @media (max-width: 768px) {
      .template-grid { grid-template-columns: 1fr; }
      .wa-tab { padding: 6px 10px; font-size: 12px; }
    }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'whatsapp', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-whatsapp"></i> <%= title %></div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? ((session.cashierName ? session.cashierName + ' · ' : '') + t('admin.role.cashier', 'Oficina')) : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">
    <% const waTab = 'templates'; %>
    <% if (msg) { %>
    <div class="alert alert-<%= msg.type==='success'?'s':'d' %>" data-flash="1">
      <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-circle' %>"></i> <%= msg.text %>
    </div>
    <% } %>

        <div class="wa-tabs">
      <a href="/admin/whatsapp" class="wa-tab <%= waTab==='status' ? 'active' : '' %>"><i class="bi bi-phone"></i> <%= t('admin.wa.tab_status','Status WhatsApp') %></a>
      <a href="/admin/whatsapp/broadcast" class="wa-tab <%= waTab==='broadcast' ? 'active' : '' %>"><i class="bi bi-megaphone"></i> <%= t('admin.wa.tab_broadcast','Broadcast & Pengingat') %></a>
      <a href="/admin/whatsapp/templates" class="wa-tab <%= waTab==='templates' ? 'active' : '' %>"><i class="bi bi-chat-left-quote"></i> <%= t('admin.wa.tab_templates','Template Pesan') %></a>
      <a href="/admin/whatsapp/preview" class="wa-tab <%= waTab==='preview' ? 'active' : '' %>"><i class="bi bi-eye"></i> <%= t('admin.wa.tab_preview','Preview Pesan') %></a>
      <a href="/admin/whatsapp/live-chat" class="wa-tab <%= waTab==='livechat' ? 'active' : '' %>"><i class="bi bi-chat-dots-fill"></i> <%= t('admin.wa.tab_livechat','Live Chat') %></a>
    </div>

    <form method="POST" action="/admin/whatsapp/templates">
      <div class="card mb16">
        <div class="card-hd">
          <h6><i class="bi bi-chat-left-quote-fill"></i> <%= t('admin.wt.title','Pengaturan Template Notifikasi WhatsApp') %></h6>
        </div>
        <div class="card-bd template-grid">
          <div>
            <div class="fg">
              <label class="fl"><%= t('admin.wt.lbl_reminder','Template Pengingat Tagihan (Bulanan / Manual)') %></label>
              <textarea class="fc" id="tmpl_auto_billing" name="whatsapp_auto_billing_message" rows="8" required style="width: 100%;"><%= templates.whatsapp_auto_billing_message %></textarea>
              <div style="font-size: 11px; color: var(--muted); margin-top: 6px; display:flex; justify-between; align-items:center;">
                <span><i class="bi bi-info-circle"></i> Variabel: <b style="color:var(--primary)">{{id_pelanggan}}</b> <span style="color:var(--primary)"><%= t('common.required','(wajib)') %></span>, <b style="color:var(--primary)">{{pppoe}}</b> <span style="color:var(--muted)"><%= t('admin.wt.ph_user','(Username PPPoE, opsional)') %></span>, <b>{{nama}}</b>, <b>{{tagihan}}</b>, <b>{{rincian}}</b>, <b>{{paket}}</b>, <b>{{link}}</b>.</span>
              </div>
            </div>
            
            <div class="fg" style="margin-top: 20px;">
              <label class="fl"><%= t('admin.wt.lbl_qris','Template Tagihan QRIS (Manual)') %></label>
              <textarea class="fc" id="tmpl_billing_qris" name="whatsapp_billing_qris_message" rows="8" required style="width: 100%;"><%= templates.whatsapp_billing_qris_message %></textarea>
              <div style="font-size: 11px; color: var(--muted); margin-top: 6px;">
                <i class="bi bi-info-circle"></i> Variabel: <b style="color:var(--primary)">{{id_pelanggan}}</b> <span style="color:var(--primary)"><%= t('common.required','(wajib)') %></span>, <b style="color:var(--primary)">{{pppoe}}</b> <span style="color:var(--muted)"><%= t('admin.wt.ph_user','(Username PPPoE, opsional)') %></span>, <b>{{nama}}</b>, <b>{{periode}}</b>, <b>{{paket}}</b>, <b>{{qris_nominal}}</b>, <b>{{qris_kode}}</b>, <b>{{qris_qr}}</b>.
              </div>
            </div>
          </div>

          <div>
            <div class="fg">
              <label class="fl"><%= t('admin.wt.lbl_success','Template Pembayaran Sukses (Lunas)') %></label>
              <textarea class="fc" id="tmpl_payment_success" name="whatsapp_payment_success_message" rows="8" required style="width: 100%;"><%= templates.whatsapp_payment_success_message %></textarea>
              <div style="font-size: 11.5px; color: var(--muted); margin-top: 6px; line-height:1.6">
                <i class="bi bi-info-circle"></i> Podés escribir el texto como quieras y usar estos datos (se reemplazan solos):
                <b>{{nama}}</b> nombre · <b>{{id_pelanggan}}</b> ID de cliente · <b>{{no_invoice}}</b> N.º de factura · <b>{{paket}}</b> plan ·
                <b>{{periode}}</b> período · <b>{{waktu}}</b> fecha y hora · <b>{{metode}}</b> forma de pago · <b>{{penerima}}</b> quién cobró ·
                <b>{{moneda}}</b> <b>{{total}}</b> monto · <b>{{tunggakan_info}}</b> deuda que queda (si hay) · <b>{{company}}</b> empresa ·
                <b>{{cs_phone}}</b> teléfono de atención · <b>{{link_pdf}}</b> factura en PDF · <b>{{link_portal}}</b> portal del cliente.
              </div>
            </div>

            <div class="fg" style="margin-top: 20px;">
              <label class="fl"><%= t('admin.wt.lbl_isolir','Template Pemberitahuan Isolir (Otomatis / Manual)') %></label>
              <textarea class="fc" id="tmpl_isolir" name="whatsapp_isolir_message" rows="8" required style="width: 100%;"><%= templates.whatsapp_isolir_message %></textarea>
              <div style="font-size: 11px; color: var(--muted); margin-top: 6px;">
                <i class="bi bi-info-circle"></i> Variabel: <b style="color:var(--primary)">{{id_pelanggan}}</b> <span style="color:var(--primary)"><%= t('common.required','(wajib)') %></span>, <b style="color:var(--primary)">{{pppoe}}</b> <span style="color:var(--muted)"><%= t('admin.wt.ph_user','(Username PPPoE, opsional)') %></span>, <b>{{nama}}</b>, <b>{{paket}}</b>, <b>{{tagihan}}</b>, <b>{{link}}</b>.
              </div>
            </div>

            <div class="fg" style="margin-top: 20px;">
              <label class="fl"><%= t('admin.wt.lbl_arrears','Template Peringatan Tunggakan (menuju nonaktif)') %></label>
            <div class="fg" style="margin-top: 20px;">
              <label class="fl"><%= t('admin.wt.lbl_autopaid','Template Auto-Lunas (Rp 0 / auto_isolate=0)') %></label>
              <textarea class="fc" id="tmpl_autolunas" name="whatsapp_autolunas_message" rows="7" required style="width: 100%;"><%= templates.whatsapp_autolunas_message %></textarea>
              <div style="font-size: 11px; color: var(--muted); margin-top: 6px;"><i class="bi bi-info-circle"></i> Variabel: <b style="color:var(--primary)">{{id_pelanggan}}</b>, <b>{{nama}}</b>, <b>{{tagihan}}</b>, <b>{{rincian}}</b>, <b>{{company}}</b>.</div>
            </div>
            <div class="fg" style="margin-top: 20px;">
              <label class="fl"><%= t('admin.wt.lbl_autoinactive','Template Auto-Nonaktif (menunggak)') %></label>
              <textarea class="fc" id="tmpl_deactivated" name="whatsapp_deactivated_message" rows="7" required style="width: 100%;"><%= templates.whatsapp_deactivated_message %></textarea>
              <div style="font-size: 11px; color: var(--muted); margin-top: 6px;"><i class="bi bi-info-circle"></i> Variabel: <b style="color:var(--primary)">{{id_pelanggan}}</b>, <b>{{nama}}</b>, <b>{{bulan_nunggak}}</b>, <b>{{batas}}</b>, <b>{{link}}</b>, <b>{{company}}</b>.</div>
            </div>
            <div class="fg" style="margin-top: 20px;">
              <label class="fl"><%= t('admin.wt.lbl_autodelete','Template Auto-Hapus (bulan ke-4)') %></label>
              <textarea class="fc" id="tmpl_deleted" name="whatsapp_deleted_message" rows="7" required style="width: 100%;"><%= templates.whatsapp_deleted_message %></textarea>
              <div style="font-size: 11px; color: var(--muted); margin-top: 6px;"><i class="bi bi-info-circle"></i> Variabel: <b style="color:var(--primary)">{{id_pelanggan}}</b>, <b>{{nama}}</b>, <b>{{bulan_nunggak}}</b>, <b>{{company}}</b>.</div>
            </div>
            <div class="fg" style="margin-top: 20px;">
              <label class="fl">Bienvenida (al cerrar la orden de instalación)</label>
              <textarea class="fc" id="tmpl_welcome" name="whatsapp_welcome_message" rows="12" style="width: 100%;"><%= templates.whatsapp_welcome_message %></textarea>
              <div style="font-size: 11px; color: var(--muted); margin-top: 6px;"><i class="bi bi-info-circle"></i> Variables: <b>{{nama}}</b> nombre, <b>{{id_pelanggan}}</b> ID de cliente, <b>{{paket}}</b> plan, <b>{{vencimiento}}</b> primer vencimiento, <b>{{link}}</b> portal de clientes, <b>{{pago}}</b> formas de pago (Configuración → Pantalla de corte), <b>{{company}}</b> empresa, <b>{{company_phone}}</b> teléfono.</div>
            </div>
              <textarea class="fc" id="tmpl_arrears" name="whatsapp_arrears_warning_message" rows="8" required style="width: 100%;"><%= templates.whatsapp_arrears_warning_message %></textarea>
              <div style="font-size: 11px; color: var(--muted); margin-top: 6px;">
                <i class="bi bi-info-circle"></i> Variabel: <b style="color:var(--primary)">{{id_pelanggan}}</b> <span style="color:var(--primary)"><%= t('common.required','(wajib)') %></span>, <b>{{nama}}</b>, <b>{{paket}}</b>, <b>{{tagihan}}</b>, <b>{{rincian}}</b>, <b>{{bulan_nunggak}}</b>, <b>{{batas}}</b>, <b>{{link}}</b>, <b>{{company}}</b>.
              </div>
            </div>
          </div>
        </div>
        <div class="card-bd" style="border-top: 1px solid var(--border); background: var(--bg2); display: flex; flex-wrap:wrap; gap:10px; justify-content: space-between; align-items: center;">
          <div style="display:flex; gap:8px; flex-wrap:wrap;">
            <button type="button" class="btn btn-primary btn-sm" onclick="fillOfficialReceiptPreset()"><i class="bi bi-receipt-cutoff"></i> Cargar plantilla completa de comprobante</button>
            <button type="button" class="btn btn-g btn-sm" onclick="fillSpintaxPreset()"><i class="bi bi-magic"></i> Cargar plantilla breve (spintax anti-bloqueo)</button>
            <button type="button" class="btn btn-w btn-sm" onclick="showMetaConverter()"><i class="bi bi-meta"></i> <i class="bi bi-magic"></i> <%= t('admin.wt.convert','Konversi Format Meta Cloud API') %></button>
            <div style="flex-basis:100%; font-size:11.5px; color:var(--muted); margin-top:4px"><i class="bi bi-exclamation-circle" style="color:var(--primary)"></i> Cada plantilla <b><%= t('admin.wt.warn_custid','wajib menyertakan variabel ID Pelanggan') %></b> <b style="color:var(--primary)">{{id_pelanggan}}</b>.</div>
            <div id="presetStatus" style="flex-basis:100%; font-size:12px; display:none"></div>
          </div>
          <button type="submit" class="btn btn-p"><i class="bi bi-save"></i> <%= t('admin.wt.save','Simpan Template') %></button>
        </div>
      </div>
    </form>

    <!-- MODAL META CONVERTER -->
    <div class="mo" id="metaConverterModal">
      <div class="mb" style="max-width: 680px;">
        <div class="mh">
          <span class="mt"><i class="bi bi-meta"></i> <%= t('admin.wt.tool_title','Tool Konversi Template Meta WhatsApp Cloud API') %></span>
          <button type="button" class="mc" onclick="closeModal('metaConverterModal')">&times;</button>
        </div>
        <div class="mbody" style="max-height:70vh; overflow-y:auto;">
          <div class="fg mb12">
            <label class="fl"><%= t('admin.wt.pick_tmpl','Pilih Template yang Akan Dikonversi ke Format Meta:') %></label>
            <select class="fs" id="metaSourceSelect" onchange="convertCurrentTemplate()">
              <option value="tmpl_auto_billing"><%= t('admin.wt.opt_reminder','Template Pengingat Tagihan') %></option>
              <option value="tmpl_billing_qris"><%= t('admin.wt.opt_qris','Template Tagihan QRIS') %></option>
              <option value="tmpl_payment_success"><%= t('admin.wt.opt_success','Template Pembayaran Sukses') %></option>
              <option value="tmpl_isolir"><%= t('admin.wt.opt_isolir','Template Pemberitahuan Isolir') %></option>
            </select>
          </div>

          <div class="fg mb12">
            <label class="fl">Texto de la plantilla para Meta Business Manager (marcadores {{1}}, {{2}}...):</label>
            <textarea class="fc" id="metaFormattedResult" rows="6" readonly style="background:var(--bg3); font-family:monospace;"></textarea>
          </div>

          <div class="fg mb12">
            <label class="fl"><%= t('admin.wt.vars','Daftar Variabel Urutan Parameter (Components Payload):') %></label>
            <div id="metaParamMapping" style="background:var(--bg3); padding:10px 14px; border-radius:8px; font-size:12px; font-family:monospace;"></div>
          </div>
        </div>
        <div class="mf">
          <button type="button" class="btn btn-g" onclick="closeModal('metaConverterModal')"><%= t('common.close','Tutup') %></button>
          <button type="button" class="btn btn-p" onclick="copyMetaTemplateResult()"><i class="bi bi-clipboard-check"></i> Copiar texto para Meta</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function setPresetStatus(msg, ok) {
  var el = document.getElementById('presetStatus');
  if (!el) return;
  el.style.display = 'block';
  el.style.color = ok === false ? 'var(--danger)' : 'var(--success, #10b981)';
  el.innerHTML = (ok === false ? '<i class="bi bi-x-circle-fill"></i> ' : '<i class="bi bi-check-circle-fill"></i> ') + msg;
}
function highlightField(el) {
  if (!el) return;
  try {
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    el.style.transition = 'box-shadow .2s ease';
    el.style.boxShadow = '0 0 0 3px var(--primary-glow)';
    setTimeout(function () { el.style.boxShadow = ''; }, 1600);
  } catch (e) {}
}
function openModal(id){ var el = document.getElementById(id); if (el) el.classList.add('show'); }
function closeModal(id){ var el = document.getElementById(id); if (el) el.classList.remove('show'); }

/* ===== VERSI LENGKAP (Profesional) ===== */
var TMPL_AB_LENGKAP = '👋 Estimado/a *{{nama}}*,\n\n📢 Le enviamos el detalle de su factura de internet.\n\n📋 *DETALLE DE LA FACTURA*\n• 🆔 ID de cliente : *{{id_pelanggan}}*\n• 📦 Plan          : {{paket}}\n• 💰 Monto         : *{{moneda}} {{tagihan}}*\n• 🗓️ Período       : {{rincian}}\n\n💳 Por favor, realice el pago antes de la fecha de vencimiento. Detalle:\n🔗 {{link}}\n\n🙏 Gracias por su confianza.\n🏢 {{company}}';
var TMPL_QR_LENGKAP = '👋 Estimado/a *{{nama}}*,\n\n📢 Le enviamos su factura de internet con el código de pago QR.\n\n📋 *DETALLE DE LA FACTURA*\n• 🆔 ID de cliente : *{{id_pelanggan}}*\n• 📦 Plan          : {{paket}}\n• 💰 Monto         : *{{moneda}} {{tagihan}}*\n• 🗓️ Período       : {{rincian}}\n\n📱 Escanee el QR adjunto para pagar:\n🔗 {{link}}\n\n🙏 Gracias.\n🏢 {{company}}';
var TMPL_PS_LENGKAP = '🧾 *COMPROBANTE DE PAGO — PAGADO* ✅\n🏢 *{{company}}*\n────────────────────────────\n👋 Estimado/a *{{nama}}*,\n\n✅ Recibimos y verificamos el pago de su factura de internet.\n\n📋 *DETALLE DEL PAGO*\n• 🆔 ID de cliente  : *{{id_pelanggan}}*\n• 🧾 Factura N.º    : {{no_invoice}}\n• 📦 Plan           : {{paket}}\n• 🗓️ Período        : {{periode}}\n• 🕒 Fecha de pago  : {{waktu}}\n• 💳 Forma de pago  : {{metode}}\n• 💰 Total pagado   : *{{moneda}} {{total}}*\n• 📌 Estado         : *PAGADO* ✅\n\n🌐 Estado del servicio: *ACTIVO*.\n\n────────────────────────────\n📄 Factura (PDF): {{link_pdf}}\n\n────────────────────────────\n🔗 Consultar facturas:\n{{link_portal}}\n\n📞 Ayuda: WhatsApp {{company_phone}}\n_Conserve este mensaje como comprobante de pago de {{company}}._';
var TMPL_IS_LENGKAP = '⚠️ Estimado/a *{{nama}}*,\n\n🚫 Su servicio de internet (📦 plan {{paket}}) está *SUSPENDIDO* por falta de pago.\n\n📋 *DETALLE DE LA DEUDA*\n• 🆔 ID de cliente : *{{id_pelanggan}}*\n• 💰 Monto         : *{{moneda}} {{tagihan}}*\n\n💳 Por favor, regularice su pago. Detalle:\n🔗 {{link}}\n\n✅ Al registrarse el pago, el servicio se rehabilita automáticamente.\n\n🙏 Gracias.\n🏢 {{company}}';
/* ===== VERSI SPINTAX ANTI-BAN ===== */
var TMPL_AB_SPINTAX = '{Hola|Buenas|Saludos} *{{nama}}*,\n\n{Le recordamos|Le enviamos el recordatorio de} su factura de internet.\n\n📋 *RESUMEN DE LA FACTURA*\n• ID de cliente : *{{id_pelanggan}}*\n• Plan          : {{paket}}\n• Monto         : *{{moneda}} {{tagihan}}*\n• Período       : {{rincian}}\n\n{Por favor|Le pedimos} {regularice|realice} su pago. Detalle:\n{{link}}\n\n{Gracias por su atención.|Gracias.}\n— {{company}}';
var TMPL_QR_SPINTAX = '{Hola|Buenas|Saludos} *{{nama}}*,\n\n{Le enviamos|Este es el detalle de} su factura de internet:\n\n📋 *RESUMEN DE LA FACTURA*\n• ID de cliente : *{{id_pelanggan}}*\n• Plan          : {{paket}}\n• Monto         : *{{moneda}} {{tagihan}}*\n• Período       : {{rincian}}\n\n{Escanee|Por favor escanee} el QR adjunto (o abra el enlace): {{link}}\n\nGracias.\n— {{company}}';
var TMPL_PS_SPINTAX = '{Hola|Buenas|Saludos} *{{nama}}*,\n\n{Gracias|Muchas gracias}, recibimos el pago de su factura de internet.\n\n📋 *DETALLE DEL PAGO*\n• ID de cliente  : *{{id_pelanggan}}*\n• Factura N.º    : {{no_invoice}}\n• Plan           : {{paket}}\n• Período        : {{periode}}\n• Fecha de pago  : {{waktu}}\n• Forma de pago  : {{metode}}\n• Total pagado   : *{{moneda}} {{total}}*\n• Estado         : *PAGADO* ✅\n\n📄 Factura (PDF): {{link_pdf}}\n🔗 Consultar facturas: {{link_portal}}\n— {{company}}';
var TMPL_IS_SPINTAX = '{Hola|Buenas|Saludos} *{{nama}}*,\n\nSu servicio de internet (plan {{paket}}) {fue suspendido|está suspendido temporalmente} por falta de pago.\n\n📋 *RESUMEN DE LA DEUDA*\n• ID de cliente : *{{id_pelanggan}}*\n• Monto         : *{{moneda}} {{tagihan}}*\n\n{Por favor|Le pedimos que} regularice su pago. Detalle:\n{{link}}\n\nGracias.\n— {{company}}';
var TMPL_AL_LENGKAP = '✅ *Factura saldada*\n\nEstimado/a *{{nama}}* (ID: {{id_pelanggan}}),\n\nSu factura del período {{rincian}} quedó registrada como *PAGADA*.\n\n💵 Monto: *{{moneda}} {{tagihan}}*\n\n¡Gracias! 🙏\n— {{company}}';
var TMPL_DE_LENGKAP = '⚠️ *Servicio dado de baja*\n\nEstimado/a *{{nama}}* (ID: {{id_pelanggan}}),\n\nSu servicio de internet fue *dado de baja* por registrar *{{bulan_nunggak}} meses* sin pagar.\n\nSi el mes próximo la deuda sigue pendiente, su cuenta será *ELIMINADA* y para volver a contratar deberá solicitar una nueva instalación.\n\nDetalle de su deuda: {{link}}\n— {{company}}';
var TMPL_DL_LENGKAP = 'Estimado/a *{{nama}}*,\n\nSu cuenta de internet fue *eliminada* por registrar *{{bulan_nunggak}} meses* sin pagar.\n\nSi desea volver a contratar el servicio, deberá solicitar una nueva instalación.\n— {{company}}';
var TMPL_AL_SPINTAX = '{Hola|Saludos} *{{nama}}*,\n\n{Gracias|Muchas gracias}, su factura de internet quedó *PAGADA*.\n\n💰 Monto: *{{moneda}} {{tagihan}}*\n📅 Período: {{rincian}}\n\n{Gracias por su confianza.|Gracias.}\n— {{company}}';
var TMPL_DE_SPINTAX = '{Hola|Saludos} *{{nama}}*,\n\nSu servicio de internet {fue dado de baja|está dado de baja temporalmente} por registrar *{{bulan_nunggak}} meses* de deuda.\n\n{Por favor|Le pedimos que} regularice su situación; de lo contrario la cuenta será *ELIMINADA* y deberá solicitar una nueva instalación:\n{{link}}\n— {{company}}';
var TMPL_DL_SPINTAX = '{Hola|Saludos} *{{nama}}*,\n\nSu cuenta fue *ELIMINADA* por registrar *{{bulan_nunggak}} meses* de deuda. {Si desea|Para} volver a contratar el servicio, solicite una nueva instalación.\n— {{company}}';


function applyPreset(set, msg) {
  var ok = 0;
  set.forEach(function (pair) {
    var el = document.querySelector('[name="' + pair[0] + '"]');
    if (el) { el.value = pair[1]; ok++; }
  });
  highlightField(document.querySelector('[name="whatsapp_auto_billing_message"]'));
  var names = set.map(function (p) { return p[2]; }).join(' / ');
  setPresetStatus('Dimuat ' + ok + ' plantilla (' + names + '). Klik "<%= t('admin.wt.save','Simpan Template') %>" untuk menyimpan.\n' + (msg || ''));
}
function fillOfficialReceiptPreset() {
  applyPreset([
    ['whatsapp_auto_billing_message', TMPL_AB_LENGKAP, 'Pengingat'],
    ['whatsapp_billing_qris_message', TMPL_QR_LENGKAP, 'QRIS'],
    ['whatsapp_payment_success_message', TMPL_PS_LENGKAP, 'Comprobante de pago'],
    ['whatsapp_isolir_message', TMPL_IS_LENGKAP, 'Isolir'],
    ['whatsapp_autolunas_message', TMPL_AL_LENGKAP, 'Auto-Lunas'],
    ['whatsapp_deactivated_message', TMPL_DE_LENGKAP, 'Auto-Nonaktif'],
    ['whatsapp_deleted_message', TMPL_DL_LENGKAP, 'Auto-Hapus']
  ], 'Versión: COMPLETA (profesional).');
}
function fillSpintaxPreset() {
  applyPreset([
    ['whatsapp_auto_billing_message', TMPL_AB_SPINTAX, 'Pengingat'],
    ['whatsapp_billing_qris_message', TMPL_QR_SPINTAX, 'QRIS'],
    ['whatsapp_payment_success_message', TMPL_PS_SPINTAX, 'Comprobante de pago'],
    ['whatsapp_isolir_message', TMPL_IS_SPINTAX, 'Isolir'],
    ['whatsapp_autolunas_message', TMPL_AL_SPINTAX, 'Auto-Lunas'],
    ['whatsapp_deactivated_message', TMPL_DE_SPINTAX, 'Auto-Nonaktif'],
    ['whatsapp_deleted_message', TMPL_DL_SPINTAX, 'Auto-Hapus']
  ], 'Versión: SPINTAX ANTI-BLOQUEO.');
}
function showMetaConverter() { openModal('metaConverterModal'); convertCurrentTemplate(); }
document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal('metaConverterModal'); });
(function () { var m = document.getElementById('metaConverterModal'); if (m) m.addEventListener('click', function (e) { if (e.target === m) closeModal('metaConverterModal'); }); })();

function convertCurrentTemplate() {
  var selEl = document.getElementById('metaSourceSelect');
  var selectId = selEl ? selEl.value : 'tmpl_auto_billing';
  var srcEl = document.getElementById(selectId);
  var sourceText = srcEl ? (srcEl.value || '') : '';

  // Strip spintax hanya grup ber-pipe {A|B} (aman, tidak menyentuh {{variabel}})
  var convertedText = sourceText.replace(/\{[^{}]*\|[^{}]*\}/g, function (full) {
    return full.slice(1, -1).split('|')[0];
  });
  var varMatches = [];
  var mapping = {};
  var regex = /\{\{([^}]+)\}\}/g;
  var match, counter = 1;
  while ((match = regex.exec(sourceText)) !== null) {
    var varName = match[1].trim();
    if (!mapping[varName]) { mapping[varName] = '{{' + counter + '}}'; varMatches.push({ index: counter, name: varName }); counter++; }
  }
  var keys = Object.keys(mapping);
  for (var k = 0; k < keys.length; k++) {
    convertedText = convertedText.split('{{' + keys[k] + '}}').join(mapping[keys[k]]);
  }
  var res = document.getElementById('metaFormattedResult');
  if (res) res.value = convertedText;
  var map2 = document.getElementById('metaParamMapping');
  if (map2) {
    if (!varMatches.length) {
      map2.innerHTML = '<span class="text-muted">Esta plantilla no tiene variables {{variabel}}.</span>';
    } else {
      map2.innerHTML = varMatches.map(function (v) {
        return '<b>{{' + v.index + '}}</b> <i class="bi bi-arrow-right"></i> ' + v.name + (v.name === 'id_pelanggan' ? ' <span style="color:var(--primary)">(ID de cliente)</span>' : '');
      }).join('<br>');
    }
  }
}
function copyMetaTemplateResult() {
  var resultEl = document.getElementById('metaFormattedResult');
  if (!resultEl) return;
  resultEl.select();
  navigator.clipboard.writeText(resultEl.value).then(function () {
    alert('¡Texto en formato Meta API copiado! Pegalo en Meta Business Manager para enviar la plantilla a aprobación.');
  }).catch(function () { try { document.execCommand('copy'); } catch (e) {} });
}
</script>
