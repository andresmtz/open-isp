<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Cómo pagar | <%= company %></title>
  <style>
    :root{--bg:#f4f6fa;--card:#fff;--text:#111827;--muted:#6b7280;--border:#e5e7eb;--accent:#1d4ed8}
    @media (prefers-color-scheme: dark){:root{--bg:#0b1020;--card:#141a2e;--text:#e5e7eb;--muted:#9ca3af;--border:#26304a;--accent:#60a5fa}}
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--text);font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;padding:24px 16px}
    .wrap{max-width:560px;margin:0 auto}
    .card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:20px;margin-bottom:14px}
    .brand{font-weight:800;font-size:18px;text-align:center;margin-bottom:14px}
    .row{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border)}
    .total{display:flex;justify-content:space-between;font-weight:800;font-size:18px;margin-top:10px}
    .pay{white-space:pre-line}
    .btn{display:block;text-align:center;background:#16a34a;color:#fff;text-decoration:none;font-weight:700;padding:12px;border-radius:10px;margin-top:12px}
    .back{display:block;text-align:center;color:var(--accent);margin-top:6px;text-decoration:none}
    .muted{color:var(--muted);font-size:13px}
  </style>
</head>
<body>
<div class="wrap">
  <div class="brand"><%= company %></div>
  <div class="card">
    <b>Factura <%= period %></b>
    <div class="row"><span class="muted">Cliente</span><span><%= customerName %></span></div>
    <div class="row"><span class="muted">Monto</span><span><%= fmtMoney(amount) %></span></div>
    <% if (paid > 0) { %><div class="row"><span class="muted">Ya pagado</span><span><%= fmtMoney(paid) %></span></div><% } %>
    <div class="total"><span>A pagar</span><span><%= fmtMoney(balance) %></span></div>
  </div>
  <div class="card">
    <% if (paymentInfo) { %><div class="pay"><%= paymentInfo %></div><% } else { %><div>Comunicate con nosotros para coordinar el pago.</div><% } %>
    <% if (waDigits) { %>
      <a class="btn" href="https://wa.me/<%= waDigits %>?text=<%= encodeURIComponent('Hola ' + company + ', envío el comprobante de pago de ' + customerName + ' (factura ' + period + ', ' + fmtMoney(balance) + ').') %>">Enviar comprobante por WhatsApp</a>
    <% } %>
  </div>
  <a class="back" href="<%= backUrl %>">← Volver</a>
</div>
</body>
</html>
