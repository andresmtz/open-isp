<%- include('partials/header') %>

<div style="margin-bottom:18px">
  <div class="muted" style="font-size:12.5px"><%= t('tech.dashboard.greeting', 'Halo, Selamat Bekerja!') %></div>
  <div style="font-size:17px;font-weight:700;display:flex;align-items:center;gap:8px"><i class="bi bi-person-badge" style="color:var(--primary)"></i><%= techName %></div>
</div>

<% var _done = (typeof recentDone !== 'undefined') ? recentDone : []; %>
<div class="p-stat-grid">
  <button type="button" class="p-stat tech-tab" data-tab="active" onclick="techTab('active')" style="border-left:3px solid var(--warning);cursor:pointer;font:inherit;color:inherit;width:100%">
    <div class="lbl"><%= t('tech.dashboard.in_progress', 'Sedang Dikerjakan') %></div>
    <div class="val" style="color:var(--warning)"><%= tickets.length %></div>
  </button>
  <button type="button" class="p-stat tech-tab" data-tab="done" onclick="techTab('done')" style="border-left:3px solid var(--success);cursor:pointer;font:inherit;color:inherit;width:100%">
    <div class="lbl"><%= t('tech.dashboard.resolved_today', 'Selesai Hari Ini') %></div>
    <div class="val" style="color:var(--success)"><%= _done.length %></div>
  </button>
</div>
<style>.tech-tab.on{outline:2px solid var(--primary);outline-offset:-2px}</style>

<div id="tab-active">
<div class="p-sec"><i class="bi bi-list-task"></i> <%= t('tech.dashboard.active_tasks', 'Tugas Aktif Anda') %> (<%= tickets.length %>)</div>

<% if (tickets.length === 0) { %>
  <div class="p-empty">
    <i class="bi bi-check2-circle" style="color:var(--success);opacity:1"></i>
    <p style="font-size:13px"><%= t('tech.dashboard.empty_active', 'Bagus! Tidak ada tugas aktif saat ini.') %><% if (typeof can !== 'function' || can('reclamos_libres')) { %><br><%= t('tech.dashboard.empty_active_hint', 'Silakan cek tab "Tiket Baru" untuk mengambil tugas.') %><% } %></p>
  </div>
<% } else { %>
  <% tickets.forEach(function(ticket){ %>
    <div class="p-card">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:8px">
        <span class="badge-status badge-<%= ticket.status %>">
          <% var statusLabel = ticket.status; if (ticket.status === 'open') statusLabel = t('tech.ticket.open', 'Belum Ditangani'); if (ticket.status === 'in_progress') statusLabel = t('tech.ticket.in_progress', 'Sedang Dikerjakan'); if (ticket.status === 'resolved') statusLabel = t('tech.ticket.resolved', 'Selesai'); %>
          <% if (ticket.status === 'in_progress') { %><i class="bi bi-tools"></i><% } %> <%= statusLabel %>
        </span>
        <span class="muted" style="font-size:11px"><%= typeof formatTimeLocal === 'function' ? formatTimeLocal(ticket.created_at) : (ticket.created_at ? new Date(ticket.created_at).toLocaleTimeString(APP_LOCALE, {hour:'2-digit', minute:'2-digit'}) : '-') %></span>
      </div>

      <div style="font-weight:700;font-size:15px"><%= ticket.customer_name %></div>
      <div class="muted" style="font-size:12px;margin:6px 0 0">
        <i class="bi bi-geo-alt-fill"></i> <%= ticket.customer_address || t('tech.ticket.no_address', 'Tidak ada alamat') %><br>
        <i class="bi bi-telephone-fill"></i> <a href="https://wa.me/<%= ticket.customer_phone %>" style="color:var(--info)"><%= ticket.customer_phone || '-' %></a>
      </div>

      <div class="ticket-msg">
        <div class="subj"><%= ticket.subject %></div>
        <% var _msg = String(ticket.message || ''); var _rm = /^⚠️ REGLA OBLIGATORIA: ([\s\S]*?)\n\n/.exec(_msg); %>
        <% if (_rm) { %>
          <div style="border:2px solid #ef4444;background:rgba(239,68,68,.12);border-radius:12px;padding:10px 12px;margin:8px 0;font-weight:800;font-size:14px;line-height:1.4">
            <div style="color:#ef4444;font-size:12px;letter-spacing:.06em;margin-bottom:4px"><i class="bi bi-exclamation-octagon-fill"></i> REGLA OBLIGATORIA</div>
            <%= _rm[1] %>
          </div>
          <% _msg = _msg.slice(_rm[0].length); %>
        <% } %>
        <div style="white-space:pre-wrap"><%= _msg %></div>
        <% if (ticket.customer_id && ['open','in_progress'].indexOf(ticket.status) !== -1) { %>
          <div style="margin-top:10px">
            <div style="display:flex;justify-content:space-between;align-items:center;font-weight:700;font-size:13px"><span><i class="bi bi-reception-4"></i> Potencia de la ONU</span><button type="button" class="btn btn-sm" style="border:1px solid var(--border)" onclick="measurePower(<%= ticket.id %>, this)"><i class="bi bi-arrow-clockwise"></i> Actualizar</button></div>
            <div id="pw-<%= ticket.id %>" class="pw-auto" data-id="<%= ticket.id %>" style="font-size:13px;margin-top:6px"></div>
          </div>
        <% } %>
        <% if (ticket.support) { var sp = ticket.support; %>
          <div class="muted" style="font-size:12px;margin-top:8px"><i class="bi bi-box-seam"></i> Plan: <%= sp.plan || '-' %><% if (sp.onu) { %> · <i class="bi bi-router"></i> Equipo actual: <%= sp.onu %><% } %></div>
          <% if (sp.active) { %>
          <details style="margin-top:10px;padding:10px;border:1px solid var(--border);border-radius:12px">
            <summary style="font-weight:700;font-size:13px;cursor:pointer"><i class="bi bi-arrow-repeat"></i> Cambiar equipo (ONU)</summary>
            <form method="POST" action="/tech/orders/<%= ticket.id %>/replace" enctype="multipart/form-data" style="margin-top:8px" onsubmit="return confirm('¿Cambiar la ONU del cliente? Conectá la ONU nueva a la fibra antes de enviar.')">
              <label style="font-size:12px;display:block;margin:4px 0 2px">Motivo</label>
              <select name="reason" class="p-input" style="width:100%"><option value="falla">La ONU no enciende o falla</option><option value="electrico">Daño eléctrico</option><option value="cambio_modelo">Cambio de modelo / mejora</option><option value="otro">Otro motivo</option></select>
              <input name="detail" class="p-input" placeholder="Detalle (opcional)" maxlength="150" style="width:100%;margin-top:6px">
              <label style="font-size:12px;display:block;margin:8px 0 2px">Foto de la etiqueta de la ONU NUEVA</label>
              <input type="file" name="label" accept="image/*" multiple required class="p-input" style="width:100%">
              <label style="font-size:12px;display:block;margin:8px 0 2px">WiFi: se mantiene <b><%= sp.wifi || 'el guardado' %></b>. Si el cliente quiere otro:</label>
              <input name="ssid" class="p-input" maxlength="28" pattern="[A-Za-z0-9_.\-]{1,28}" placeholder="Nombre nuevo (opcional)" style="width:100%">
              <input name="key" class="p-input" minlength="8" maxlength="63" placeholder="Clave nueva (opcional)" style="width:100%;margin-top:6px" autocomplete="off">
              <div class="muted" style="font-size:11px;margin-top:6px">La ONU vieja se da de baja recién cuando la nueva funcione.</div>
              <button class="btn btn-primary btn-sm" style="margin-top:8px;width:100%"><i class="bi bi-upload"></i> Cambiar equipo</button>
            </form>
          </details>
          <% } %>
        <% } %>
        <% if (ticket.withdraw) { var wd = ticket.withdraw; %>
          <div style="margin-top:10px;padding:10px;border:2px solid #f59e0b;border-radius:12px">
            <div style="font-weight:800;font-size:13px;margin-bottom:6px"><i class="bi bi-box-arrow-in-down"></i> Equipo a retirar</div>
            <div style="font-size:13px;line-height:1.6"><b><%= wd.type %></b><% if (wd.mac) { %><br>MAC: <span style="font-family:monospace;font-weight:700"><%= wd.mac %></span><% } %></div>
            <div class="muted" style="font-size:11px;margin-top:2px">Revisá que la MAC de la etiqueta coincida antes de llevártelo.</div>
            <% if (wd.label) { %><a href="<%= wd.label %>" target="_blank" rel="noopener"><img src="<%= wd.label %>" class="p-img" alt="Etiqueta del equipo" style="margin-top:8px;max-width:220px"></a><% } %>
            <form method="POST" action="/tech/orders/<%= ticket.id %>/retiro" enctype="multipart/form-data" style="margin-top:10px" onsubmit="return confirm('¿Confirmás que ya tenés el equipo en tu poder?')">
              <label style="font-size:12px;display:block;margin:4px 0 2px">Foto de la etiqueta del equipo retirado *</label>
              <input type="file" name="label" accept="image/*" multiple required class="p-input" style="width:100%">
              <input name="notes" class="p-input" maxlength="300" placeholder="Notas (opcional): ej. también retiré el router" style="width:100%;margin-top:6px">
              <button class="p-btn success" style="margin-top:8px"><i class="bi bi-check-circle-fill"></i> Equipo retirado</button>
            </form>
            <details style="margin-top:8px">
              <summary style="font-size:13px;font-weight:700;cursor:pointer;color:#ef4444"><i class="bi bi-x-circle"></i> No se pudo retirar</summary>
              <form method="POST" action="/tech/orders/<%= ticket.id %>/retiro-fallido" style="margin-top:8px">
                <select name="motive" class="p-input" style="width:100%"><% Object.keys(wd.fails).forEach(function(k){ %><option value="<%= k %>"><%= wd.fails[k] %></option><% }); %></select>
                <input name="detail" class="p-input" maxlength="200" placeholder="Detalle (opcional)" style="width:100%;margin-top:6px">
                <button class="btn btn-sm" style="margin-top:8px;width:100%;border:1px solid #ef4444;color:#ef4444"><i class="bi bi-send"></i> Avisar a la oficina</button>
              </form>
            </details>
          </div>
        <% } %>
        <% if (ticket.equipment) { var eq = ticket.equipment; %>
          <form method="POST" action="/tech/orders/<%= ticket.id %>/equipment" enctype="multipart/form-data" style="margin-top:10px;padding:10px;border:1px solid var(--border);border-radius:12px">
            <div style="font-weight:700;font-size:13px;margin-bottom:6px"><i class="bi bi-router"></i> Datos del equipo del cliente</div>
            <label style="font-size:12px;display:block;margin:6px 0 2px">Foto de la etiqueta de la ONU <%= eq.labels ? '(' + eq.labels + ' cargada' + (eq.labels > 1 ? 's' : '') + ')' : '' %></label>
            <input type="file" name="label" accept="image/*" multiple class="p-input" style="width:100%">
            <label style="font-size:12px;display:block;margin:8px 0 2px">MAC de la etiqueta (opcional)</label>
            <input name="mac" class="p-input" value="<%= eq.mac %>" placeholder="80:07:1B:F4:EE:68" style="width:100%;text-transform:uppercase">
            <label style="font-size:12px;display:block;margin:8px 0 2px">Nombre del WiFi que eligió el cliente</label>
            <input name="ssid" class="p-input" value="<%= eq.ssid %>" maxlength="28" pattern="[A-Za-z0-9_.\-]{1,28}" placeholder="Sin espacios ni acentos" style="width:100%">
            <div class="muted" style="font-size:11px;margin-top:2px">La red 5G se llama igual con "-5G" al final.</div>
            <label style="font-size:12px;display:block;margin:8px 0 2px">Clave del WiFi (mínimo 8)</label>
            <input name="key" class="p-input" minlength="8" maxlength="63" placeholder="<%= eq.ssid ? 'Dejar vacío para no cambiarla' : '' %>" style="width:100%" autocomplete="off">
            <% if (eq.status) { %><div style="font-size:12px;margin-top:6px;color:<%= eq.status === 'aplicado' ? 'var(--success,#10b981)' : (eq.status.indexOf('error') === 0 ? '#ef4444' : 'var(--muted)') %>">WiFi: <%= eq.status === 'aplicado' ? 'configurado en la ONU' : (eq.status === 'pendiente' ? 'pendiente: la oficina vincula la ONU y se aplica solo' : eq.status) %></div><% } %>
            <button class="btn btn-primary btn-sm" style="margin-top:8px;width:100%"><i class="bi bi-upload"></i> Guardar datos del equipo</button>
          </form>
          <details style="margin-top:10px;padding:10px;border:1px solid rgba(239,68,68,.4);border-radius:12px">
            <summary style="font-weight:700;font-size:13px;cursor:pointer;color:#ef4444"><i class="bi bi-x-circle"></i> No se pudo instalar</summary>
            <form method="POST" action="/tech/orders/<%= ticket.id %>/no-install" style="margin-top:8px" onsubmit="return confirm('¿Confirmás que NO se pudo hacer la instalación? La oficina recibe el aviso.')">
              <label style="font-size:12px;display:block;margin:4px 0 2px">Motivo</label>
              <select name="motive" class="p-input" style="width:100%"><% Object.keys(ticket.installCancel || {}).forEach(function(k){ %><option value="<%= k %>"><%= ticket.installCancel[k] %></option><% }); %></select>
              <input name="detail" class="p-input" maxlength="200" placeholder="Detalle (ej.: la caja más cercana no tiene puertos libres)" style="width:100%;margin-top:6px">
              <button class="btn btn-sm" style="margin-top:8px;width:100%;border:1px solid #ef4444;color:#ef4444"><i class="bi bi-send"></i> Avisar a la oficina</button>
            </form>
          </details>
          <% if (eq.labels) { %>
            <div id="prov-<%= ticket.id %>" class="prov-watch" data-id="<%= ticket.id %>" style="margin-top:8px;padding:10px;border-radius:12px;border:1px solid var(--border);font-size:13px"><i class="bi bi-hourglass-split"></i> Configurando la ONU automáticamente… (1 a 3 minutos). Esta pantalla se actualiza sola.</div>
          <% } %>
        <% } %>
        <% if (ticket.housePhotos && ticket.housePhotos.length) { %>
          <div style="margin-top:10px;padding-top:10px;border-top:1px solid var(--border)">
            <div style="color:var(--info);font-size:12px;margin-bottom:8px"><i class="bi bi-house-door"></i> Foto de la casa</div>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px">
              <% ticket.housePhotos.forEach(function(u){ %><a href="<%= u %>" target="_blank" rel="noopener"><img src="<%= u %>" class="p-img" alt="Casa del cliente" loading="lazy"></a><% }); %>
            </div>
          </div>
        <% } %>
        <% if (ticket.customer_photos && ticket.customer_photos !== '' && ticket.customer_photos !== '[]') { %>
          <% var customerPhotos = JSON.parse(ticket.customer_photos || '[]'); %>
          <% if (customerPhotos.length > 0) { %>
            <div style="margin-top:10px;padding-top:10px;border-top:1px solid var(--border)">
              <div style="color:var(--info);font-size:12px;margin-bottom:8px"><i class="bi bi-images"></i> <%= t('tech.cust_photos','Foto dari pelanggan') %><%= customerPhotos.length %>)</div>
              <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px">
                <% customerPhotos.slice(0,3).forEach(function(photo){ %>
                  <a href="<%= photo %>" target="_blank" rel="noopener"><img src="<%= photo %>" class="p-img" alt="Foto"></a>
                <% }); %>
              </div>
              <% if (customerPhotos.length > 3) { %><div class="muted" style="font-size:11px;margin-top:6px">+<%= customerPhotos.length - 3 %> <%= t('tech.more_photos_suffix','foto lainnya') %></div><% } %>
            </div>
          <% } %>
        <% } %>
      </div>

      <% if (ticket.kind !== 'retiro' && ticket.kind !== 'install') { %>
      <button type="button" class="p-btn success" onclick="openResolve(<%= ticket.id %>)"><i class="bi bi-check-circle-fill"></i> <%= t('tech.ticket.mark_resolved', 'Tandai Selesai') %></button>
      <% } %>
    </div>

    <!-- Modal Selesai -->
    <div class="mo" id="resolveModal<%= ticket.id %>" onclick="if(event.target===this)hideModal('resolveModal<%= ticket.id %>')">
      <div class="mb">
        <div class="mh"><h3><i class="bi bi-check-circle" style="color:var(--success)"></i> <%= t('tech.ticket.resolve_title', 'Selesaikan Tugas') %></h3>
          <button class="mc" onclick="hideModal('resolveModal<%= ticket.id %>')"><i class="bi bi-x-lg"></i></button></div>
        <form method="POST" action="/tech/tickets/<%= ticket.id %>/update" enctype="multipart/form-data" id="resolveForm<%= ticket.id %>">
          <div class="mbody">
            <div class="auth-alert info"><i class="bi bi-info-circle"></i> <%= t('tech.task_for','Tugas untuk') %> <b><%= ticket.customer_name %></b> — <b><%= ticket.subject %></b></div>
            <input type="hidden" name="status" value="resolved">

            <div class="p-field">
              <label><%= t('tech.job_note','Catatan Pekerjaan *') %></label>
              <textarea name="notes" class="p-input" rows="3" placeholder="<%= t('tech.note_ph','Jelaskan pekerjaan, kendala, material yang digunakan…') %>" required></textarea>
              <div class="muted" style="font-size:11.5px;margin-top:5px"><%= t('tech.job_note_hint','Catatan ini akan dilihat admin dan pelanggan.') %></div>
            </div>

            <div class="p-field">
              <label><%= t('tech.job_photos','Foto Pekerjaan (Opsional, max 10)') %></label>
              <input type="file" name="photos" class="p-input" accept="image/*" multiple capture="environment" onchange="previewPhotos(this, <%= ticket.id %>)" style="padding:10px">
              <div class="muted" style="font-size:11.5px;margin-top:5px"><%= t('tech.job_photos_hint','Foto sebelum/sesudah, perangkat, atau signal level. Max 5MB/foto.') %></div>
            </div>

            <div id="photoPreview<%= ticket.id %>" style="display:none;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px"></div>

            <input type="hidden" id="gpsLat<%= ticket.id %>" name="gps_lat" value="">
            <input type="hidden" id="gpsLng<%= ticket.id %>" name="gps_lng" value="">
            <div class="auth-alert warn"><i class="bi bi-geo-alt-fill"></i> <%= t('tech.gps_note','Lokasi GPS otomatis tersimpan saat menyelesaikan tugas.') %></div>
          </div>
          <div class="mf">
            <button type="button" class="lbtn lbtn-ghost" onclick="hideModal('resolveModal<%= ticket.id %>')"><i class="bi bi-x-circle"></i> <%= t('common.cancel','Batal') %></button>
            <button type="submit" class="lbtn lbtn-primary"><i class="bi bi-check-circle-fill"></i> <%= t('tech.done_save','Selesai & Simpan') %></button>
          </div>
        </form>
      </div>
    </div>
  <% }); %>
<% } %>
</div>

<script>
  function showModal(id){ var el=document.getElementById(id); if(el) el.classList.add('show'); }
  function hideModal(id){ var el=document.getElementById(id); if(el) el.classList.remove('show'); }
  function getGps(id){
    if(!navigator.geolocation) return;
    navigator.geolocation.getCurrentPosition(function(p){
      var la=document.getElementById('gpsLat'+id), ln=document.getElementById('gpsLng'+id);
      if(la) la.value=p.coords.latitude; if(ln) ln.value=p.coords.longitude;
    }, function(){}, {enableHighAccuracy:true, timeout:8000});
  }
  function openResolve(id){ showModal('resolveModal'+id); getGps(id); }
  function previewPhotos(input, ticketId) {
    var previewContainer = document.getElementById('photoPreview' + ticketId);
    previewContainer.innerHTML = '';
    if (input.files && input.files.length > 0) {
      previewContainer.style.display = 'grid';
      var files = Array.prototype.slice.call(input.files, 0, 10);
      files.forEach(function(file, index){
        var reader = new FileReader();
        reader.onload = function(e){
          var col = document.createElement('div');
          col.style.position = 'relative';
          col.innerHTML = '<img src="'+e.target.result+'" style="width:100%;height:78px;object-fit:cover;border:2px solid var(--border);border-radius:8px"><span style="position:absolute;top:4px;left:4px;background:var(--primary);color:var(--on-primary);border-radius:6px;font-size:10px;font-weight:800;padding:1px 6px">'+(index+1)+'</span>';
          previewContainer.appendChild(col);
        };
        reader.readAsDataURL(file);
      });
      if (input.files.length > 10) alert('Máximo 10 fotos. El resto se ignora.');
    } else { previewContainer.style.display = 'none'; }
  }
</script>

<div id="tab-done" style="display:none">
  <div class="p-sec"><i class="bi bi-check2-all"></i> Resueltos hoy (<%= _done.length %>)</div>
  <% if (!_done.length) { %><div class="p-empty"><p style="font-size:13px">Todavía no terminaste órdenes hoy.</p></div><% } %>
  <% _done.forEach(function(d){ var _inst = String(d.kind || '').indexOf('install') === 0; %>
    <div class="p-card" style="border-left:3px solid var(--success)">
      <div style="display:flex;justify-content:space-between;gap:8px"><b><%= d.customer_name %></b><span class="muted" style="font-size:11px"><%= String(d.updated_at || '').slice(11,16) %></span></div>
      <div class="muted" style="font-size:12px"><%= d.subject %></div>
      <% if (_inst && d.kind === 'install') { %><div style="font-size:13px;margin-top:6px;color:var(--success);font-weight:700"><i class="bi bi-check-circle-fill"></i> <%= d.reg_provision_status === 'ok' ? 'Instalación completa: ONU configurada y cliente activo.' : 'Instalación cerrada.' %> No tenés que hacer nada más.</div><% } %>
      <% if (d.technician_notes) { %><div class="muted" style="font-size:12px;margin-top:4px;white-space:pre-wrap"><%= d.technician_notes %></div><% } %>
      <% if (d.customer_status !== 'cancelled' && d.kind !== 'install_cancelled') { %>
      <div style="margin-top:10px">
        <div style="display:flex;justify-content:space-between;align-items:center;font-weight:700;font-size:13px"><span><i class="bi bi-reception-4"></i> Potencia con que quedó</span><button type="button" class="btn btn-sm" style="border:1px solid var(--border)" onclick="measurePower(<%= d.id %>, this)"><i class="bi bi-arrow-clockwise"></i> Actualizar</button></div>
        <div id="pw-<%= d.id %>" class="pw-auto" data-id="<%= d.id %>" style="font-size:13px;margin-top:6px"></div>
      </div>
      <% } %>
    </div>
  <% }); %>
</div>

<%- include('partials/bottom_nav') %><script>
async function measurePower(id, btn){
  var box = document.getElementById('pw-' + id);
  if (btn) btn.disabled = true; box.innerHTML = '<span class="muted">Midiendo en la OLT…</span>';
  try {
    var j = await (await fetch('/tech/orders/' + id + '/power', { headers: { Accept: 'application/json' } })).json();
    if (!j.ok) { box.innerHTML = /no tiene una ONU vinculada/i.test(j.message || '') ? '<span class="muted">Se mide cuando la ONU esté conectada y configurada.</span>' : '<span style="color:#ef4444">' + (j.message || 'Error') + '</span>'; }
    else {
      var col = { green: '#10b981', orange: '#f59e0b', red: '#ef4444', gray: '#94a3b8' }[j.color] || '#94a3b8';
      box.innerHTML = '<div style="border:2px solid ' + col + ';border-radius:12px;padding:10px">'
        + '<div style="font-size:22px;font-weight:800;color:' + col + '">' + (j.rx || '—') + ' dBm <span style="font-size:13px">(' + j.level + ')</span></div>'
        + '<div class="muted" style="font-size:12px">ONU ' + j.onu + ' · ' + (j.status || '') + (j.distance && j.distance !== '-' ? ' · fibra ' + j.distance + ' m' : '') + (j.temp ? ' · ' + j.temp + ' °C' : '') + '</div>'
        + '<div style="font-size:12px;margin-top:4px">' + j.advice + '</div>'
        + '<div class="muted" style="font-size:11px;margin-top:2px">Medido ' + new Date(j.at).toLocaleTimeString() + ' · Actualizar para volver a medir</div></div>';
    }
  } catch (e) { box.textContent = 'Error: ' + e.message; }
  if (btn) btn.disabled = false;
}
// Orden de instalación con la etiqueta cargada: se consulta el avance cada 8 s; al completarse se recarga el panel
(function(){
  var boxes = document.querySelectorAll('.prov-watch'); if (!boxes.length) return;
  function tick(){
    boxes.forEach(function(b){
      fetch('/tech/orders/' + b.getAttribute('data-id') + '/status', { headers: { Accept: 'application/json' } }).then(function(r){ return r.json(); }).then(function(j){
        if (!j.ok) return;
        if (j.resolved) { b.innerHTML = '<b style="color:#10b981"><i class="bi bi-check-circle-fill"></i> ¡Instalación completa!</b> Actualizando…'; setTimeout(function(){ location.hash = 'resueltos'; location.reload(); }, 1500); return; }
        if (j.provision === 'ok') b.innerHTML = '<b style="color:#10b981"><i class="bi bi-check-circle-fill"></i> ONU configurada.</b>';
        else if (j.provision.indexOf('error') === 0) b.innerHTML = '<b style="color:#ef4444"><i class="bi bi-exclamation-triangle-fill"></i> La configuración automática falló (' + j.provision.slice(7) + ').</b> La oficina ya fue avisada; esperá su indicación.';
        else if (j.label && j.label !== 'sin lectura') b.innerHTML = '<i class="bi bi-hourglass-split"></i> Etiqueta leída: ' + j.label + '. Configurando la ONU… Esta pantalla se actualiza sola.';
        else if (j.label === 'sin lectura') b.innerHTML = '<b style="color:#f59e0b"><i class="bi bi-camera"></i> No se pudo leer la etiqueta.</b> Sacá otra foto más de cerca, con buena luz, y volvé a guardar.';
      }).catch(function(){});
    });
  }
  tick(); setInterval(tick, 8000);
})();
// Al abrir el panel se mide sola la potencia de cada orden abierta (de a una, para no saturar la OLT)
function techTab(tab){
  document.getElementById('tab-active').style.display = tab === 'active' ? '' : 'none';
  document.getElementById('tab-done').style.display = tab === 'done' ? '' : 'none';
  document.querySelectorAll('.tech-tab').forEach(function(b){ b.classList.toggle('on', b.getAttribute('data-tab') === tab); });
  try { history.replaceState(null, '', tab === 'done' ? '#resueltos' : location.pathname); } catch (_) {}
  measureVisible();
}
var _measured = {};
async function measureVisible(){
  var boxes = document.querySelectorAll('.pw-auto');
  for (var i = 0; i < boxes.length; i++) {
    var b = boxes[i], id = b.getAttribute('data-id');
    if (_measured[id] || !b.offsetParent) continue;
    _measured[id] = 1; await measurePower(id);
  }
}
techTab(location.hash === '#resueltos' ? 'done' : 'active');
</script>

